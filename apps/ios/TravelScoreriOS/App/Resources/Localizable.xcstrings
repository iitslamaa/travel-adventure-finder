    "trip_planner.availability.shared_dates_hint" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيتم تمييز التواريخ المشتركة باللون الذهبي بمجرد تداخل التوفر."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les dates compartides es destacaran en or un cop les disponibilitats coincideixin."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sdílená data budou zvýrazněna zlatě, jakmile se dostupnost překryje."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Delte datoer vil fremhæves i guld, når tilgængeligheden overlapper."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geteilte Termine werden goldfarben hervorgehoben, sobald die Verfügbarkeit überschneidet."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι κοινοποιημένες ημερομηνίες θα επισημανθούν με χρυσό όταν οι διαθεσιμότητες επικαλύπτονται."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shared dates will highlight in gold once availability overlaps."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las fechas compartidas se resaltarán en dorado una vez que la disponibilidad coincida."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jaetut päivämäärät korostuvat kultaisina, kun saatavuus päällekkäin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les dates partagées seront mises en évidence en or une fois que les disponibilités se chevaucheront."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "תאריכים משותפים יוחלפו בזהב ברגע שהזמינות תתאים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "साझा की गई तारीखें सोने रंग में हाइलाइट होंगी जब उपलब्धता मेल खाएगी।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zajednički datumi bit će označeni zlatnom bojom kada se dostupnost poklopi."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A megosztott dátumok aranyszínnel lesznek kiemelve, ha az elérhetőség átfed."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tanggal yang dibagikan akan disorot dengan warna emas begitu ketersediaan tumpang tindih."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le date condivise saranno evidenziate in oro una volta che la disponibilità si sovrappone."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "利用可能日が重なると、共有された日付は金色でハイライトされます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "공유된 날짜는 가능 기간이 겹치면 금색으로 강조 표시됩니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tarikh yang dikongsi akan diserlahkan dengan warna emas apabila ketersediaan bertindih."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Delte datoer vil bli uthevet i gull når tilgjengeligheten overlapper."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gedeelde datums worden goudkleurig gemarkeerd zodra de beschikbaarheid overlapt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Udostępnione daty zostaną wyróżnione na złoto, gdy dostępność się pokryje."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Datas compartilhadas serão destacadas em dourado assim que a disponibilidade coincidir."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Datele partajate se vor evidenția în auriu odată ce disponibilitatea se suprapune."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Общие даты будут выделены золотым, как только совпадет доступность."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zdieľané dátumy sa zvýraznia zlatou farbou, keď sa dostupnosť prekrýva."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Delade datum kommer att markeras i guld när tillgängligheten överlappar."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "วันที่ที่แชร์จะส่องแสงเป็นสีทองเมื่อมีความพร้อมตรงกัน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ortak tarihler, uygunluk kesiştiğinde altın rengiyle vurgulanacaktır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Спільні дати будуть виділені золотим кольором, коли наявність збігається."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các ngày được chia sẻ sẽ được tô vàng khi sự trùng khớp về khả dụng xảy ra."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一旦可用日期重叠，共享日期将以金色高亮显示。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一旦可用日期重疊，共享的日期將以金色標示。"
          }
        }
      }
