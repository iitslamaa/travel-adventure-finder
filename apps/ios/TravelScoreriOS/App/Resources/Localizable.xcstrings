    "trip_planner.expenses.add_people_first" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أضف أشخاصًا إلى الرحلة لبدء تتبع من يدين بماذا."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afegeix persones al viatge per començar a fer un seguiment de qui deu què."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přidejte lidi na výlet, abyste mohli začít sledovat, kdo kolik dluží."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tilføj folk til turen for at begynde at holde styr på, hvem der skylder hvad."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fuge zuerst Personen zur Reise hinzu, um zu verfolgen, wer wem etwas schuldet."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Προσθέστε άτομα στο ταξίδι για να ξεκινήσετε την παρακολούθηση του ποιος οφείλει τι."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add people to the trip to start tracking who owes what."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agrega personas al viaje para empezar a seguir quien debe que."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lisää ihmisiä matkalle aloittaaksesi seurannan siitä, kuka on velkaa mitäkin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez d'abord des personnes au voyage pour commencer a suivre qui doit quoi."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הוסף אנשים לטיול כדי להתחיל לעקוב מי חייב מה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "किसने कितना देना है, यह ट्रैक करना शुरू करने के लिए यात्रा में लोग जोड़ें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodajte ljude na putovanje kako biste počeli pratiti tko što duguje."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adj hozzá embereket az utazáshoz, hogy elkezdhess nyomon követni, ki mennyivel tartozik."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tambahkan orang ke perjalanan untuk mulai melacak siapa yang berhutang apa."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiungi prima persone al viaggio per iniziare a tenere traccia di chi deve cosa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "旅行に人を追加して、誰が何を借りているかの追跡を始めましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "여행에 사람들을 추가하여 누가 무엇을 빚고 있는지 추적하기 시작하세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tambah orang ke perjalanan untuk mula menjejak siapa berhutang apa."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legg til folk på turen for å begynne å spore hvem som skylder hva."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voeg mensen toe aan de reis om bij te houden wie wat verschuldigd is."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodaj osoby do wycieczki, aby rozpocząć śledzenie, kto ile jest winien."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
