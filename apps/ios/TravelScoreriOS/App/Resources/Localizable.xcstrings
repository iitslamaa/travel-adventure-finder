    "discovery.weights.month_helper" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستخدم شهر السفر الذي اخترته. تغيير هذا هنا يقوم أيضًا بتحديث متى تذهب."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilitza el mes de viatge seleccionat. Canviar-lo aquí també actualitza Quan Anar."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Používá vámi vybraný měsíc cestování. Změna zde také aktualizuje Kdy jet."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bruger din valgte rejsemåned. Ændring her opdaterer også 'Hvornår skal man rejse'."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwendet deinen ausgewahlten Reisemonat. Eine Anderung hier aktualisiert auch Wann reisen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Χρησιμοποιεί τον επιλεγμένο μήνα ταξιδιού σας. Η αλλαγή του εδώ ενημερώνει επίσης το Πότε να πάτε."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uses your selected travel month. Changing it here also updates When To Go."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa tu mes de viaje seleccionado. Cambiarlo aqui tambien actualiza Cuando ir."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Käyttää valitsemaasi matkakuukautta. Sen muuttaminen täällä päivittää myös Milloin Mennä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilise votre mois de voyage selectionne. Le changer ici met aussi a jour Quand partir."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "משתמש בחודש הנסיעה שבחרת. שינויו כאן גם מעדכן את 'מתי ללכת'."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपके चयनित यात्रा माह का उपयोग करता है। इसे यहां बदलने से व्हेन टू गो भी अपडेट हो जाता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koristi odabrani mjesec putovanja. Promjena ovdje također ažurira Od kada ići."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A kiválasztott utazási hónapját használja. Ha itt módosítja, az a 'Mikor érdemes utazni' szakaszt is frissíti."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menggunakan bulan perjalanan yang Anda pilih. Mengubahnya di sini juga akan memperbarui Kapan Harus Pergi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa il mese di viaggio selezionato. Modificandolo qui si aggiorna anche Quando andare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選択した旅行月を使用します。ここで変更すると「いつ行く」も更新されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "선택한 여행 월을 사용합니다. 여기에서 변경하면 '언제 가야 하나'도 업데이트됩니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menggunakan bulan perjalanan yang anda pilih. Menukarnya di sini juga akan mengemas kini Bila Perlu Pergi."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bruker den valgte reisemåneden din. Å endre den her oppdaterer også Når du bør reise."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gebruikt je geselecteerde reismaand. Het hier wijzigen werkt ook bij Wanneer te gaan."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Używa wybranego miesiąca podróży. Zmiana go tutaj również aktualizuje sekcję Kiedy jechać."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa o mes de viagem selecionado. Alterar aqui tambem atualiza Quando ir."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Folosește luna de călătorie selectată. Modificarea acesteia aici actualizează și Când să mergi."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выберите месяц для сезонной оценки"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Používa váš vybraný mesiac cestovania. Zmena tu tiež aktualizuje čas, kedy ísť."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Använder din valda resmånad. Att ändra den här uppdaterar också När man ska åka."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ใช้เดือนท่องเที่ยวที่คุณเลือก การเปลี่ยนที่นี่จะอัปเดต 'เวลาที่ควรไป' ด้วย"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seçtiğiniz seyahat ayını kullanır. Bunu burada değiştirmek, 'Ne Zaman Gitmeli' bilgisini de günceller."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Використовує обраний вами місяць подорожі. Зміна його тут також оновлює розділ «Коли їхати»."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sử dụng tháng du lịch bạn đã chọn. Thay đổi nó ở đây cũng sẽ cập nhật mục Khi Nào Đi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用您选择的旅行月份。在此更改它也会更新“何时出行”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用您選擇的旅行月份。在此更改它也會更新「何時出行」的內容。"
          }
        }
      }
