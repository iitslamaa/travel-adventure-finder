        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arvioidut päivittäiset matkakulut elinkustannusindeksien ja hotellihintojen mallinnuksen perusteella."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Couts quotidiens de voyage estimes a partir d'indices du cout de la vie et d'une modelisation des prix hoteliers."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הערכת עלויות נסיעה יומיות בהתבסס על מדדי יוקר מחיה ודגמי מחירי מלונות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "रहने की लागत सूचकांक और होटल मूल्य मॉडलिंग के आधार पर अनुमानित दैनिक यात्रा लागत।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Procijenjeni dnevni troškovi putovanja temelje se na indeksima troškova života i modeliranju cijena hotela."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Becsült napi utazási költségek a megélhetési költségindexek és a szállodai ármodellezés alapján."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perkiraan biaya perjalanan harian berdasarkan indeks biaya hidup dan pemodelan harga hotel."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Costi di viaggio giornalieri stimati basati su indici del costo della vita e modelli dei prezzi alberghieri."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "生活費指数とホテル価格のモデリングに基づく推定日次旅行費用。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "생활비 지수와 호텔 가격 모델링을 기반으로 한 예상 일일 여행 비용."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anggaran kos perjalanan harian berdasarkan indeks kos sara hidup dan pemodelan harga hotel."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anslåtte daglige reiseutgifter basert på levekostnadsindekser og hotellprismodellering."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geschatte dagelijkse reiskosten op basis van kosten van levensonderhoudindices en hotelaanprijzingsmodellering."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Szacowane dzienne koszty podróży oparte na wskaźnikach kosztów utrzymania i modelowaniu cen hoteli."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Custos diarios estimados de viagem com base em indices de custo de vida e modelos de precos de hotel."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Costuri zilnice de călătorie estimate pe baza indicilor costului vieții și a modelării prețurilor la hotel."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Оценка ежедневных расходов на поездку основана на индексах стоимости жизни и модели цен на отели."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odhadované denné cestovné náklady založené na indexoch životných nákladov a modelovaní cien hotelov."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beräknade dagliga resekostnader baserat på levnadskostnadsindex och hotellprismodellering."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ประมาณค่าใช้จ่ายในการเดินทางรายวันโดยอิงจากดัชนีค่าครองชีพและการจำลองราคาของโรงแรม"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yaşam maliyeti endeksleri ve otel fiyatı modellemesine dayalı tahmini günlük seyahat maliyetleri."
          }
        },
        "uk" : {
          "stringUnit" : {
