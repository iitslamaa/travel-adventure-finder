    "trip_planner.availability.how_it_works_subtitle" : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أضف إما نوافذ محددة أو أشهر مرنة لكل مسافر، ثم دع المخطط يظهر أقوى تداخل."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afegeix finestres exactes o mesos flexibles per a cada viatger, i després deixa que el planificador mostri la superposició més forta."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přidejte buď přesná období, nebo flexibilní měsíce pro každého cestovatele, a potom nechte plánovač zobrazit nejsilnější překrytí."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tilføj enten præcise vinduer eller fleksible måneder for hver rejsende, og lad derefter planlæggeren fremhæve den stærkeste overlapning."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fuge fur jeden Reisenden entweder genaue Zeitfenster oder flexible Monate hinzu und lass den Planer die starkste Uberschneidung finden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Προσθέστε είτε ακριβή παράθυρα είτε ευέλικτους μήνες για κάθε ταξιδιώτη και αφήστε τον προγραμματιστή να αναδείξει την ισχυρότερη επικαλύψη."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add either exact windows or flexible months for each traveler, then let the planner surface the strongest overlap."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agrega ventanas exactas o meses flexibles para cada viajero y deja que el planificador encuentre la mejor coincidencia."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lisää jokaiselle matkustajalle joko tarkat aikavälit tai joustavat kuukaudet, ja anna sitten suunnittelijan näyttää vahvin päällekkäisyys."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez des dates exactes ou des mois flexibles pour chaque voyageur, puis laissez le planificateur afficher le meilleur chevauchement."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הוסף או חלונות מדויקים או חודשים גמישים לכל נוסע, ואז תן למתכנן להציג את החפיפה החזקה ביותר."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "प्रत्येक यात्री के लिए या तो सटीक विंडो या लचीले महीने जोड़ें, फिर योजना बनाने वाले को सबसे मज़बूत ओवरलैप दिखाने दें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodajte točne prozore ili fleksibilne mjesece za svakog putnika, a zatim neka planer prikaže najsnažnije preklapanje."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adjon meg pontos időablakokat vagy rugalmas hónapokat minden utazónak, majd hagyja, hogy a tervező felmutassa a legerősebb átfedést."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tambahkan jendela waktu yang tepat atau bulan fleksibel untuk setiap pelancong, lalu biarkan perencana menampilkan tumpang tindih yang paling kuat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiungi finestre precise o mesi flessibili per ogni viaggiatore e lascia che il planner trovi la sovrapposizione migliore."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "各旅行者に対して正確な期間か柔軟な月を追加し、その後プランナーに最も強い重なりを表示させます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "각 여행자마다 정확한 일정 또는 유연한 월을 추가한 다음, 플래너가 가장 강력한 겹침을 보여주도록 하세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tambah sama ada tetingkap tepat atau bulan fleksibel untuk setiap pengembara, kemudian biarkan perancang menunjukkan pertindihan yang paling kukuh."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legg til enten eksakte vinduer eller fleksible måneder for hver reisende, og la deretter planleggeren finne den sterkeste overlappen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voeg voor elke reiziger ofwel exacte vensters of flexibele maanden toe, en laat de planner vervolgens de sterkste overlap naar voren brengen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodaj dokładne okna czasowe lub elastyczne miesiące dla każdego podróżnego, a następnie pozwól planerowi znaleźć najsilniejsze pokrycie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adicione janelas exatas ou meses flexiveis para cada viajante e deixe o planejador mostrar a melhor sobreposicao."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adaugă fie ferestre exacte sau luni flexibile pentru fiecare călător, apoi lasă planificatorul să evidențieze cea mai puternică suprapunere."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добавьте либо точные окна, либо гибкие месяцы для каждого путешественника, а планировщик покажет наилучшее пересечение."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pridajte buď presné okná alebo flexibilné mesiace pre každého cestujúceho, potom nechajte plánovač zobraziť najsilnejšie prekrývanie."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lägg till antingen exakta fönster eller flexibla månader för varje resenär, och låt sedan planeringsverktyget visa den starkaste överlappningen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เพิ่มช่วงเวลาที่แน่นอนหรือตามเดือนที่ยืดหยุ่นสำหรับแต่ละผู้เดินทาง จากนั้นให้ผู้วางแผนแสดงการทับซ้อนที่เข้มแข็งที่สุด"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her yolcu için ya tam tarih aralıklarını ya da esnek ayları ekleyin, sonra planlayıcının en güçlü örtüşmeyi ortaya çıkarmasını sağlayın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Додайте або точні вікна, або гнучкі місяці для кожного мандрівника, а потім дайте планувальнику визначити найсильніше перекриття."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thêm cửa sổ thời gian chính xác hoặc linh hoạt cho từng du khách, sau đó để công cụ lập kế hoạch hiển thị sự trùng lặp mạnh nhất."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "为每位旅行者添加精确时间窗口或灵活月份，然后让规划器显示最强的重叠时间。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "為每位旅客添加精確的時間範圍或靈活的月份，然後讓規劃工具顯示最強的重疊部分。"
          }
        }
      }
    },
