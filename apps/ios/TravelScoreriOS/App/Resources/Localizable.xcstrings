    "country_detail.friends.see_who" : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اعرف من زار المكان، ومن يريد الذهاب، أو من هنا."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mira qui ha visitat, vol anar o és d'aquí."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podívejte se, kdo navštívil, chce jít, nebo je odsud."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se hvem der har besøgt, vil tage hen, eller er herfra."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sieh, wer hier war, hinmochte oder von hier ist."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δες ποιος έχει επισκεφθεί, θέλει να πάει ή είναι από εδώ."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "See who has visited, wants to go, or is from here."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mira quien ha visitado, quiere ir o es de aqui."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Katso, kuka on vieraillut, haluaa mennä tai on täältä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voyez qui y est alle, veut y aller, ou en est originaire."
