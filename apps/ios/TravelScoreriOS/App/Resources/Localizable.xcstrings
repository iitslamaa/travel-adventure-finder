    "trip_planner.availability.no_shared_window" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يوجد نافذة مشتركة بعد. أضف بعض الأفكار الأخرى عبر المجموعة وسيقترح المخطط تطابقات أقوى هنا."
