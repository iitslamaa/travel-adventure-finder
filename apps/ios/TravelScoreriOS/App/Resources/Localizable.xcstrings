    "trip_planner.expenses.subtitle" : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تتبع من دفع، ومن يدين، ومازال مستحقاً."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Segueix qui ha pagat, qui deu i què encara està pendent."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sledujte, kdo zaplatil, kdo dluží a co je stále nezaplaceno."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hold styr på, hvem der har betalt, hvem der skylder, og hvad der stadig mangler."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verfolge, wer bezahlt hat, wer schuldet und was noch offen ist."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Παρακολουθήστε ποιος πλήρωσε, ποιος οφείλει και τι εξακολουθεί να εκκρεμεί."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Track who paid, who owes, and what’s still outstanding."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lleva el control de quien pago, quien debe y que sigue pendiente."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seuraa, kuka on maksanut, kuka on velkaa ja mikä on vielä maksamatta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suivez qui a paye, qui doit et ce qui reste en attente."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "עקוב מי שילם, מי חייב ומה עדיין נותר לתשלום."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ट्रैक करें कि किसने भुगतान किया, किस पर बकाया है, और क्या अभी भी बाकी है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pratite tko je platio, tko duguje i što je još nepodmireno."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kövesse nyomon, ki fizetett, ki tartozik, és mi van még fennálló."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lacak siapa yang sudah membayar, siapa yang berhutang, dan apa yang masih tertunggak."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tieni traccia di chi ha pagato, chi deve e cosa e ancora in sospeso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "誰が支払ったか、誰が借りているか、まだ未払いのものは何かを追跡します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "누가 지불했는지, 누가 빚이 있는지, 아직 남아 있는 금액이 무엇인지 추적하세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jejaki siapa yang membayar, siapa yang berhutang, dan apa yang masih tertunggak."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Følg hvem som har betalt, hvem som skylder, og hva som fortsatt står utestående."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Houd bij wie betaald heeft, wie nog moet betalen en wat nog openstaat."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Śledź, kto zapłacił, kto jest winien i co jest nadal nieuregulowane."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acompanhe quem pagou, quem deve e o que ainda esta pendente."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Urmărește cine a plătit, cine datorează și ce este încă restant."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отслеживайте, кто заплатил, кто должен и что еще осталось закрыть."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sledujte, kto zaplatil, kto dlhuje a čo je stále nezaplatené."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spåra vem som har betalat, vem som är skyldig och vad som fortfarande är utestående."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ติดตามว่าใครจ่าย ใครติดหนี้ และสิ่งที่ยังค้างอยู่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kimin ödediğini, kimin borcu olduğunu ve neyin hala ödenmemiş olduğunu takip edin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Відстежуйте, хто заплатив, хто заборгував і що ще залишилося невиплаченим."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Theo dõi ai đã trả tiền, ai còn nợ và những gì vẫn chưa thanh toán."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "追踪谁已经付款、谁还欠款以及还有哪些未结清的款项。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "追蹤誰已付款、誰欠款，以及仍未結清的金額。"
          }
        }
      }
    },
