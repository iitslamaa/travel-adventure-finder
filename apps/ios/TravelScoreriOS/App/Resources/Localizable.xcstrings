    "seasonality.view.peak_season_note" : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أفضل الطقس والظروف بشكل عام — عادةً يكون الأكثر ازدحامًا والأغلى."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Millor temps i condicions generals: normalment els més concorreguts i cars."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nejlepší počasí a celkové podmínky — obvykle nejvytíženější a nejdražší."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bedste vejr og samlede forhold — som regel den travleste og dyreste."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bestes Wetter und beste Gesamtbedingungen - meist auch am vollsten und teuersten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Καλύτερος καιρός και γενικές συνθήκες — συνήθως η πιο πολυσύχναστη και ακριβή περίοδος."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Best weather and overall conditions — usually the busiest and priciest."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mejor clima y condiciones generales; normalmente la epoca mas concurrida y mas cara."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paras sää ja yleiset olosuhteet — yleensä vilkkaimmat ja kalleimmat."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Best weather and overall conditions — usually the busiest and priciest."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "המזג אוויר והתנאים הכלליים הטובים ביותר — בדרך כלל העמוסים והיקרים ביותר."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सबसे अच्छा मौसम और कुल मिलाकर स्थिति — आमतौर पर सबसे अधिक व्यस्त और महँगी।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Najbolje vrijeme i opći uvjeti — obično najprometnije i najskuplje."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legjobb időjárás és általános feltételek — általában a legforgalmasabb és legdrágább."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuaca dan kondisi secara keseluruhan terbaik — biasanya paling ramai dan paling mahal."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meteo e condizioni migliori in assoluto, di solito anche il periodo piu affollato e costoso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最高の天気と全体的なコンディション — 通常、最も混雑していて価格も高いです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "최고의 날씨와 전반적인 조건 — 보통 가장 붐비고 가격이 비쌉니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuaca dan keadaan keseluruhan terbaik — biasanya paling sibuk dan paling mahal."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beste vær og generelle forhold — vanligvis de travleste og dyreste."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beste weer en algehele omstandigheden — meestal het drukst en duurst."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Najlepsza pogoda i ogólne warunki — zazwyczaj najbardziej zatłoczone i najdroższe."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Melhor clima e melhores condicoes gerais — normalmente o periodo mais cheio e caro."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cea mai bună vreme și condiții generale — de obicei cele mai aglomerate și scumpe."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Лучшая погода и общие условия, но обычно самый загруженный и дорогой период."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Najlepšie počasie a celkové podmienky — zvyčajne najrušnejšie a najdrahšie."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bäst väder och övergripande förhållanden — vanligtvis det mest hektiska och dyraste."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "สภาพอากาศและสภาพโดยรวมดีที่สุด — มักจะเป็นช่วงที่คึกคักที่สุดและมีราคาแพงที่สุด"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En iyi hava ve genel koşullar — genellikle en yoğun ve en pahalı olan zaman."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Найкраща погода та загальні умови — зазвичай найжвавіший та найдорожчий час."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thời tiết và điều kiện tổng thể tốt nhất — thường là thời điểm đông đúc nhất và đắt đỏ nhất."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最佳的天气和整体条件——通常最繁忙且最昂贵。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最佳天氣和整體條件 — 通常是最繁忙且最昂貴的時期。"
          }
        }
      }
    },
