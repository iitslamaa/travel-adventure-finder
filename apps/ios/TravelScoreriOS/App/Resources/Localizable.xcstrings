    "trip_planner.no_friends_yet" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ليس لديك أي أصدقاء مضافين بعد، لذا ستبقى هذه الرحلة فردية في الوقت الحالي."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Encara no has afegit cap amic, així que aquest viatge serà en solitari de moment."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ještě nemáte žádné přátele přidané, takže tento výlet zatím zůstane sólo."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du har endnu ikke tilføjet nogen venner, så denne tur vil forblive solo indtil videre."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du hast noch keine Freunde hinzugefugt, daher bleibt diese Reise vorerst solo."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν έχετε προσθέσει ακόμα φίλους, οπότε αυτό το ταξίδι θα παραμείνει μόνο του προς το παρόν."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You do not have any friends added yet, so this trip will stay solo for now."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todavia no tienes amigos agregados, asi que este viaje seguira siendo en solitario por ahora."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sinulla ei ole vielä lisättyjä ystäviä, joten tämä matka pysyy toistaiseksi yksin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous n'avez pas encore d'amis ajoutes, donc ce voyage restera solo pour le moment."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "עדיין אין לך חברים toegevoegd, כך שהטיול הזה יישאר לבד לעת עתה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपने अभी तक कोई दोस्त नहीं जोड़ा है, इसलिए यह यात्रा अभी के लिए अकेले ही रहेगी।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Još niste dodali nijednog prijatelja, pa će ovo putovanje zasad biti solo."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Még nem adtál hozzá barátokat, így ez az utazás egyelőre egyedül marad."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anda belum menambahkan teman, jadi perjalanan ini akan tetap solo untuk saat ini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non hai ancora aggiunto amici, quindi questo viaggio restera per ora in solitaria."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "まだ友達を追加していないので、この旅行は今のところ一人でのものになります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아직 추가된 친구가 없으므로, 이번 여행은 당분간 혼자일 것입니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anda belum menambah sebarang rakan lagi, jadi perjalanan ini akan kekal bersendirian buat masa ini."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du har ikke lagt til noen venner ennå, så denne turen blir alene foreløpig."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je hebt nog geen vrienden toegevoegd, dus deze reis blijft voorlopig solo."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie masz jeszcze dodanych żadnych znajomych, więc ta wycieczka na razie pozostanie samotna."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voce ainda nao adicionou nenhum amigo, entao esta viagem vai continuar solo por enquanto."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nu ai adăugat încă niciun prieten, așa că această călătorie va rămâne solo pentru moment."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У вас пока нет добавленных друзей, поэтому эта поездка пока останется сольной."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ešte ste nepridali žiadnych priateľov, takže tento výlet zatiaľ zostane sólo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du har inte lagt till några vänner än, så denna resa blir ensam för tillfället."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คุณยังไม่มีเพื่อนเพิ่ม ดังนั้นทริปนี้จะยังคงเป็นส่วนตัวก่อนตอนนี้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Henüz eklenmiş arkadaşın yok, bu yüzden bu gezi şimdilik tek başına kalacak."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У вас ще немає доданих друзів, тож ця подорож поки що залишиться соло."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn chưa thêm bạn bè nào, vì vậy chuyến đi này sẽ vẫn là một mình trước mắt."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你还没有添加任何朋友，所以这次旅行暂时将是独自进行的。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你尚未添加任何朋友，所以這次旅行暫時將會是獨自進行。"
          }
        }
      }
