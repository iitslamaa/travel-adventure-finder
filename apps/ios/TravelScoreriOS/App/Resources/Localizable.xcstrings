    "legal.no_professional_advice.body" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مكتشف مغامرات السفر لا يقدم نصائح قانونية أو طبية أو حكومية. يجب على المستخدمين التحقق من المعلومات من المصادر الرسمية قبل اتخاذ قرارات السفر."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Travel Adventure Finder no proporciona assessorament legal, mèdic ni governamental. Els usuaris haurien de verificar la informació amb fonts oficials abans de prendre decisions de viatge."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Travel Adventure Finder neposkytuje právní, lékařské ani vládní poradenství. Uživatelé by měli ověřit informace z oficiálních zdrojů před rozhodováním o cestování."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Travel Adventure Finder giver ikke juridisk, medicinsk eller offentlig rådgivning. Brugere bør verificere information hos officielle kilder, før de træffer rejsebeslutninger."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Travel Adventure Finder bietet keine rechtliche, medizinische oder behordliche Beratung. Nutzer sollten Informationen vor Reiseentscheidungen bei offiziellen Quellen prufen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Travel Adventure Finder δεν παρέχει νομικές, ιατρικές ή κυβερνητικές συμβουλές. Οι χρήστες θα πρέπει να επαληθεύουν τις πληροφορίες με επίσημες πηγές πριν πάρουν αποφάσεις σχετικά με τα ταξίδια."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Travel Adventure Finder does not provide legal, medical, or governmental advice. Users should verify information with official sources before making travel decisions."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Travel Adventure Finder no ofrece asesoramiento legal, medico ni gubernamental. Los usuarios deben verificar la informacion con fuentes oficiales antes de tomar decisiones de viaje."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Travel Adventure Finder ei tarjoa oikeudellista, lääketieteellistä tai hallinnollista neuvontaa. Käyttäjien tulisi varmistaa tiedot virallisista lähteistä ennen matkapäätösten tekemistä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Travel Adventure Finder ne fournit pas de conseils juridiques, medicaux ou gouvernementaux. Les utilisateurs doivent verifier les informations aupres de sources officielles avant de prendre des decisions de voyage."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מְצִיאַת רְפוּת נְסִיעוֹת אינה מספקת ייעוץ משפטי, רפואי או ממשלתי. משתמשים צריכים לאמת מידע מול מקורות רשמיים לפני קבלת החלטות נסיעה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ट्रैवल एडवेंचर फ़ाइंडर कानूनी, चिकित्सा या सरकारी सलाह प्रदान नहीं करता है। उपयोगकर्ताओं को यात्रा संबंधी निर्णय लेने से पहले आधिकारिक स्रोतों से जानकारी सत्यापित करनी चाहिए।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Travel Adventure Finder ne pruža pravne, medicinske ili vladine savjete. Korisnici bi trebali provjeriti informacije iz službenih izvora prije donošenja odluka o putovanju."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Travel Adventure Finder nem nyújt jogi, orvosi vagy kormányzati tanácsot. A felhasználóknak hivatalos forrásokból kell ellenőrizniük az információkat, mielőtt utazási döntéseket hoznának."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Travel Adventure Finder tidak memberikan saran hukum, medis, atau pemerintah. Pengguna harus memverifikasi informasi dengan sumber resmi sebelum membuat keputusan perjalanan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Travel Adventure Finder non fornisce consulenza legale, medica o governativa. Gli utenti dovrebbero verificare le informazioni presso fonti ufficiali prima di prendere decisioni di viaggio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "トラベルアドベンチャーファインダーは、法律、医療、または政府の助言を提供するものではありません。ユーザーは旅行の決定を行う前に、公式な情報源で情報を確認するべきです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "트래블 어드벤처 파인더는 법률, 의료 또는 정부 조언을 제공하지 않습니다. 사용자는 여행 결정을 내리기 전에 공식 소스를 통해 정보를 확인해야 합니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Travel Adventure Finder tidak menyediakan nasihat undang-undang, perubatan, atau kerajaan. Pengguna harus mengesahkan maklumat dengan sumber rasmi sebelum membuat keputusan perjalanan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Travel Adventure Finder gir ikke juridisk, medisinsk eller offentlig rådgivning. Brukere bør verifisere informasjon med offisielle kilder før de tar reisebeslutninger."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Travel Adventure Finder geeft geen juridisch, medisch of overheidsadvies. Gebruikers moeten informatie verifiëren bij officiële bronnen voordat ze reisbesluiten nemen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Travel Adventure Finder nie udziela porad prawnych, medycznych ani rządowych. Użytkownicy powinni weryfikować informacje w oficjalnych źródłach przed podejmowaniem decyzji dotyczących podróży."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Travel Adventure Finder nao fornece aconselhamento juridico, medico ou governamental. Os usuarios devem verificar as informacoes em fontes oficiais antes de tomar decisoes de viagem."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Travel Adventure Finder nu oferă sfaturi juridice, medicale sau guvernamentale. Utilizatorii ar trebui să verifice informațiile cu surse oficiale înainte de a lua decizii de călătorie."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Travel Adventure Finder не предоставляет юридических, медицинских или государственных консультаций. Перед принятием решений о поездке пользователям следует проверять информацию в официальных источниках."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Travel Adventure Finder neposkytuje právne, lekárske ani vládne poradenstvo. Používatelia by mali overiť informácie u oficiálnych zdrojov pred prijatím cestovných rozhodnutí."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Travel Adventure Finder ger inte juridisk, medicinsk eller statlig rådgivning. Användare bör verifiera information med officiella källor innan de fattar resebeslut."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Travel Adventure Finder ไม่ให้คำแนะนำทางกฎหมาย การแพทย์ หรือรัฐบาล ผู้ใช้ควรตรวจสอบข้อมูลกับแหล่งทางการก่อนตัดสินใจในการเดินทาง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Travel Adventure Finder yasal, tıbbi veya resmi tavsiyeler vermez. Kullanıcılar, seyahat kararları vermeden önce bilgileri resmi kaynaklarla doğrulamalıdır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Travel Adventure Finder не надає юридичних, медичних або урядових порад. Користувачам слід перевіряти інформацію через офіційні джерела перед ухваленням рішень щодо подорожей."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Travel Adventure Finder không cung cấp lời khuyên pháp lý, y tế hoặc chính phủ. Người dùng nên xác minh thông tin với các nguồn chính thức trước khi đưa ra quyết định du lịch."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "旅行冒险发现者不提供法律、医疗或政府方面的建议。用户在做出旅行决策之前应通过官方渠道核实信息。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "旅行冒險搜尋器不提供法律、醫療或政府相關建議。使用者應在做出旅行決策前，先向官方來源核實資訊。"
          }
        }
      }
    },
