    "trip_planner.availability.info_exact_vs_flexible" : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استخدم التواريخ الدقيقة عندما يعرف الشخص بالفعل الأسبوع الذي يكون فيه متاحًا. استخدم الشهور المرنة عندما يعرف الشخص التوقيت العام فقط."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilitzeu dates exactes quan algú ja sàpiga la setmana que està lliure. Utilitzeu mesos flexibles quan només coneguin el moment general."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Používejte přesná data, když někdo už ví, který týden má volno. Používejte pružné měsíce, když zná jen obecné časové období."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brug præcise datoer, når nogen allerede kender ugen, de er ledige. Brug fleksible måneder, når de kun kender det generelle tidspunkt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwende genaue Daten, wenn jemand bereits weiss, in welcher Woche er frei hat. Nutze flexible Monate, wenn nur der grobe Zeitraum bekannt ist."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Χρησιμοποιήστε ακριβείς ημερομηνίες όταν κάποιος ήδη ξέρει την εβδομάδα που είναι ελεύθερος. Χρησιμοποιήστε ευέλικτους μήνες όταν ξέρουν μόνο τη γενική χρονική περίοδο."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use exact dates when someone already knows the week they’re free. Use flexible months when they only know the general timing."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa fechas exactas cuando alguien ya sabe la semana en que estara libre. Usa meses flexibles cuando solo conoce el periodo general."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Käytä tarkkoja päivämääriä, kun joku jo tietää, minä viikolla he ovat vapaita. Käytä joustavia kuukausia, kun he tietävät vain yleisen ajankohdan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisez des dates exactes quand quelqu'un connait deja la semaine ou il est libre. Utilisez des mois flexibles quand il ne connait que la periode generale."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "השתמש בתאריכים מדויקים כאשר מישהו כבר יודע את השבוע שבו הוא פנוי. השתמש בחודשים גמישים כאשר הם יודעים רק את פרק הזמן הכללי."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सटीक तिथियों का उपयोग तब करें जब किसी को पहले से पता हो कि वे किस सप्ताह में फ्री हैं। लचीले महीनों का उपयोग तब करें जब उन्हें केवल सामान्य समय का पता हो।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koristite točne datume kada netko već zna tjedan u kojem je slobodan. Koristite fleksibilne mjesece kada znaju samo opće vrijeme."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Használjon pontos dátumokat, ha valaki már tudja, melyik héten szabad. Használjon rugalmas hónapokat, ha csak az általános időpontot ismeri."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gunakan tanggal pasti ketika seseorang sudah mengetahui minggu mereka bebas. Gunakan bulan yang fleksibel ketika mereka hanya mengetahui perkiraan waktu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa date precise quando qualcuno sa gia in quale settimana e libero. Usa mesi flessibili quando conosce solo il periodo generale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "誰かがすでに空いている週を知っている場合は、正確な日付を使ってください。大まかな時期しかわからない場合は、柔軟な月を使ってください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "누군가가 자신이 자유로운 주를 이미 알고 있다면 정확한 날짜를 사용하세요. 일반적인 시기만 알고 있다면 유연한 월을 사용하세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gunakan tarikh yang tepat apabila seseorang sudah mengetahui minggu mereka bebas. Gunakan bulan yang fleksibel apabila mereka hanya mengetahui jangka masa umum."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bruk eksakte datoer når noen allerede vet hvilken uke de er ledige. Bruk fleksible måneder når de bare kjenner til det generelle tidspunktet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gebruik exacte datums wanneer iemand al weet welke week ze vrij zijn. Gebruik flexibele maanden wanneer ze alleen het algemene tijdstip weten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Używaj dokładnych dat, gdy ktoś już zna tydzień, w którym jest wolny. Używaj elastycznych miesięcy, gdy zna tylko ogólny termin."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use datas exatas quando alguem ja souber em que semana estara livre. Use meses flexiveis quando a pessoa so souber o periodo geral."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Folosește date exacte când cineva știe deja săptămâna în care este liber. Folosește luni flexibile când aceștia cunosc doar perioada generală."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Используйте точные даты, когда человек уже знает неделю, в которую он свободен. Используйте гибкие месяцы, когда известен только общий период."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Použite presné dátumy, keď niekto už vie, ktorý týždeň má voľno. Použite flexibilné mesiace, keď poznajú len všeobecný čas."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Använd exakta datum när någon redan vet vilken vecka de är lediga. Använd flexibla månader när de bara vet den ungefärliga tiden."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ใช้วันที่ที่แน่นอนเมื่อมีคนทราบสัปดาห์ที่พวกเขาว่าง ใช้เดือนที่ยืดหยุ่นเมื่อพวกเขาทราบเพียงช่วงเวลาทั่วไป"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Birinin hangi hafta boş olduğunu zaten bildiği durumlarda kesin tarihleri kullanın. Sadece genel zamanı bildiklerinde ise esnek aylar kullanın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Використовуйте точні дати, коли хтось вже знає тиждень, коли він вільний. Використовуйте гнучкі місяці, коли вони знають лише загальні терміни."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sử dụng ngày chính xác khi ai đó đã biết tuần họ rảnh. Sử dụng các tháng linh hoạt khi họ chỉ biết thời gian chung."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当某人已经知道他们有空的周时，使用确切日期。当他们只知道大致时间时，使用灵活的月份。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "當某人已經知道自己哪一週有空時，請使用確切日期。當他們只知道大致的時間時，請使用靈活的月份。"
          }
        }
      }
    },
