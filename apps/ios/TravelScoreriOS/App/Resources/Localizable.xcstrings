    "profile.settings.passports.subtitle" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "خاص بك. يُستخدم لتخصيص قواعد التأشيرة وتوصيات جواز السفر باستخدام أقوى جواز محفوظ لديك لكل وجهة."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Privat per a tu. S'utilitza per personalitzar les normes de visat i les recomanacions de passaports amb el teu passaport més fort guardat per a cada destinació."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soukromé pro vás. Používá se k personalizaci pravidel víz a doporučení pro pas s vaším nejsilnějším uloženým pasem pro každou destinaci."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Privat for dig. Bruges til at tilpasse visumregler og pasanbefalinger med dit stærkeste gemte pas til hver destination."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur fur dich sichtbar. Wird verwendet, um Visaregeln und Passempfehlungen mit deinem starksten gespeicherten Pass fur jedes Ziel zu personalisieren."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ιδιωτικό για εσάς. Χρησιμοποιείται για να προσωποποιεί τους κανόνες βίζας και τις συστάσεις διαβατηρίων με το ισχυρότερο αποθηκευμένο διαβατήριό σας για κάθε προορισμό."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Private to you. Used to personalize visa rules and passport recommendations with your strongest saved passport for each destination."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Privado para ti. Se usa para personalizar reglas de visa y recomendaciones de pasaporte con tu pasaporte guardado mas fuerte para cada destino."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yksityinen sinulle. Käytetään visa-sääntöjen ja passisuositusten personointiin käyttämällä vahvinta tallennettua passiäsi jokaista kohdetta varten."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prive pour vous. Utilise pour personnaliser les regles de visa et les recommandations de passeport avec votre meilleur passeport enregistre pour chaque destination."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "פרטי עבורך. משמש להתאמת כללי ויזה והמלצות דרכון עם הדרכון השמור החזק ביותר שלך עבור כל יעד."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपके लिए निजी. प्रत्येक गंतव्य के लिए आपके सबसे मजबूत सहेजे गए पासपोर्ट के साथ वीज़ा नियमों और पासपोर्ट अनुशंसाओं को वैयक्तिकृत करने के लिए उपयोग किया जाता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Privatno za vas. Koristi se za personalizaciju viznih pravila i preporuka za putovnice s vašom najjačom spremljenom putovnicom za svaku destinaciju."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Személyes számodra. Arra használják, hogy személyre szabja a vízum szabályokat és az útlevél javaslatokat a legjobb mentett útleveled alapján minden célállomásra."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pribadi untuk Anda. Digunakan untuk mempersonalisasi aturan visa dan rekomendasi paspor dengan paspor tersimpan terkuat Anda untuk setiap tujuan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Privato per te. Serve a personalizzare regole sui visti e consigli sui passaporti con il tuo passaporto salvato migliore per ogni destinazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あなただけの情報です。各目的地に対して最も強力な保存済みパスポートを使い、ビザ規則やパスポートの推奨事項を個別化するために使用されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "개인용. 각 목적지에 대해 가장 강력하게 저장된 여권으로 비자 규칙과 여권 권장 사항을 개인화하는 데 사용됩니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peribadi untuk anda. Digunakan untuk memperibadikan peraturan visa dan cadangan pasport dengan pasport tersimpan terkuat anda untuk setiap destinasi."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Privat for deg. Brukes til å tilpasse visumregler og passanbefalinger med ditt sterkeste lagrede pass for hver destinasjon."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Privé voor jou. Wordt gebruikt om visumregels en paspoortaanbevelingen te personaliseren met je sterkste opgeslagen paspoort voor elke bestemming."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prywatne dla ciebie. Służy do personalizacji zasad wizowych i zaleceń dotyczących paszportu z użyciem twojego najsilniejszego zapisanego paszportu dla każdego celu podróży."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Privado para voce. Usado para personalizar regras de visto e recomendacoes de passaporte com seu melhor passaporte salvo para cada destino."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Privat pentru tine. Folosit pentru a personaliza regulile vizelor și recomandările pentru pașaport cu cel mai puternic pașaport salvat pentru fiecare destinație."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Только для вас. Используются для персонализации визовых правил и рекомендаций по паспортам на основе вашего самого сильного сохраненного паспорта для каждого направления."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Súkromné pre vás. Používa sa na prispôsobenie vízových pravidiel a odporúčaní ohľadom pasu s vaším najsilnejším uloženým pasom pre každú destináciu."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Privat för dig. Används för att anpassa visumregler och rekommendationer för pass med ditt starkaste sparade pass för varje destination."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ส่วนตัวสำหรับคุณ ใช้ปรับแต่งกฎวีซ่าและคำแนะนำเกี่ยวกับหนังสือเดินทางโดยใช้หนังสือเดินทางที่บันทึกไว้และแข็งแกร่งที่สุดของคุณสำหรับแต่ละปลายทาง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sadece size özeldir. Her destinasyon için en güçlü kaydedilmiş pasaportunuzla vize kurallarını ve pasaport tavsiyelerini kişiselleştirmek için kullanılır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Приватно для вас. Використовується для персоналізації правил отримання візи та рекомендацій щодо паспорта з вашим найсильнішим збереженим паспортом для кожного напрямку."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riêng tư với bạn. Được sử dụng để cá nhân hóa quy định visa và khuyến nghị hộ chiếu với hộ chiếu mạnh nhất bạn đã lưu cho từng điểm đến."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅限您个人使用。用于根据每个目的地您保存的最强护照个性化签证规则和护照建议。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "僅供您使用。用於根據每個目的地您最強的已保存護照，個性化簽證規則和護照建議。"
          }
        }
      }
    },
