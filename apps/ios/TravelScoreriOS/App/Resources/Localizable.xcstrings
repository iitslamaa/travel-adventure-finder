          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chi phí đi lại hàng ngày ước tính dựa trên chỉ số chi phí sinh hoạt và mô hình giá khách sạn."
          }
        },
        "zh-Hans" : {
