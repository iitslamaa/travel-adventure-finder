    "social.activity.empty.description" : {
      "comment" : "Description shown when the social activity feed is empty.",
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عندما يقوم الأصدقاء بتحديث قوائم السفر أو البلدان أو الوجهات المفضلة أو تفاصيل الملف الشخصي، ستظهر هذه التحديثات هنا."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quan els amics actualitzen llistes de viatges, països preferits, destinacions o detalls del perfil, aquestes actualitzacions apareixeran aquí."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Když přátelé aktualizují seznamy cestování, oblíbené země, destinace nebo údaje o profilu, tyto aktualizace se zde zobrazí."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når venner opdaterer rejselister, yndlingslande, destinationer eller profildetaljer, vil disse opdateringer dukke op her."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn Freunde Reiselisten, Lieblingsländer, Reiseziele oder Profildetails aktualisieren, werden diese Aktualisierungen hier angezeigt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Όταν οι φίλοι ενημερώνουν λίστες ταξιδιών, αγαπημένες χώρες, προορισμούς ή λεπτομέρειες προφίλ, αυτές οι ενημερώσεις θα εμφανίζονται εδώ."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When friends update travel lists, favorite countries, destinations, or profile details, those updates will appear here."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando los amigos actualicen las listas de viajes, los países favoritos, los destinos o los detalles del perfil, esas actualizaciones aparecerán aquí."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun ystävät päivittävät matkailulistojaan, suosikkimaitaan, kohteitaan tai profiilitietojaan, nämä päivitykset näkyvät täällä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lorsque des amis mettent à jour des listes de voyage, des pays préférés, des destinations ou des détails de profil, ces mises à jour apparaîtront ici."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כאשר חברים מעדכנים רשימות טיולים, מדינות אהובות, יעדים או פרטי פרופיל, העדכונים האלה יופיעו כאן."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जब दोस्त यात्रा सूचियाँ, पसंदीदा देश, गंतव्य या प्रोफ़ाइल विवरण अपडेट करते हैं, तो ये अपडेट्स यहाँ दिखाई देंगे।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kada prijatelji ažuriraju popise putovanja, omiljene zemlje, destinacije ili podatke profila, ta će ažuriranja biti prikazana ovdje."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Amikor a barátok frissítik az utazási listáikat, kedvenc országaikat, úti céljaikat vagy profiladataikat, ezek a frissítések itt fognak megjelenni."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ketika teman memperbarui daftar perjalanan, negara favorit, destinasi, atau detail profil, pembaruan tersebut akan muncul di sini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando gli amici aggiornano le liste di viaggio, i paesi preferiti, le destinazioni o i dettagli del profilo, tali aggiornamenti appariranno qui."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "友達が旅行リスト、お気に入りの国、目的地、またはプロフィールの詳細を更新すると、その更新内容がここに表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "친구들이 여행 목록, 좋아하는 나라, 여행지 또는 프로필 정보를 업데이트하면, 그 업데이트가 여기 표시됩니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apabila rakan mengemas kini senarai perjalanan, negara kegemaran, destinasi, atau butiran profil, kemas kini tersebut akan muncul di sini."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når venner oppdaterer reiselister, favorittland, destinasjoner eller profildetaljer, vil disse oppdateringene vises her."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wanneer vrienden reislijsten, favoriete landen, bestemmingen of profielgegevens bijwerken, verschijnen deze updates hier."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kiedy znajomi aktualizują listy podróży, ulubione kraje, destynacje lub szczegóły profilu, te aktualizacje pojawią się tutaj."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando amigos atualizam listas de viagens, países favoritos, destinos ou detalhes do perfil, essas atualizações aparecerão aqui."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Când prietenii își actualizează listele de călătorii, țările preferate, destinațiile sau detaliile profilului, acele actualizări vor apărea aici."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Когда друзья обновляют списки путешествий, любимые страны, направления или данные профиля, эти обновления будут отображаться здесь."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keď si priatelia aktualizujú cestovateľské zoznamy, obľúbené krajiny, destinácie alebo údaje v profile, tieto aktualizácie sa zobrazia tu."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "När vänner uppdaterar reselistor, favoritländer, destinationer eller profilsida, kommer de uppdateringarna att visas här."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เมื่อเพื่อนอัปเดตรายการท่องเที่ยว ประเทศที่ชื่นชอบ จุดหมายปลายทาง หรือรายละเอียดโปรไฟล์ การอัปเดตเหล่านั้นจะแสดงที่นี่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arkadaşlar seyahat listelerini, favori ülkelerini, destinasyonlarını veya profil bilgilerini güncellediğinde, bu güncellemeler burada görünecektir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Коли друзі оновлюють списки подорожей, улюблені країни, напрямки або деталі профілю, ці оновлення з’являться тут."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khi bạn bè cập nhật danh sách du lịch, các quốc gia yêu thích, điểm đến hoặc chi tiết hồ sơ, những cập nhật đó sẽ xuất hiện ở đây."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当朋友更新旅行清单、喜爱国家、目的地或个人资料信息时，这些更新将显示在此处。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "當朋友更新旅行清單、最喜愛的國家、目的地或個人資料資訊時，這些更新將會顯示在這裡。"
          }
        }
      }
    },
