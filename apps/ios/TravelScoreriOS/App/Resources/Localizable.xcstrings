    "trip_planner.apps_to_download.app_store" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store"
          }
        }
      }
    },
    "trip_planner.apps_to_download.empty" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add countries to the trip first, then taxi apps will show up here."
          }
        }
      }
    },
    "trip_planner.apps_to_download.intro" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Country-by-country taxi and rideshare apps, with the practical quirks that are worth knowing before you land."
          }
        }
      }
    },
    "trip_planner.apps_to_download.no_confident_match" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No confident app match yet"
          }
        }
      }
    },
    "trip_planner.apps_to_download.no_starter_app_format" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No reliable starter taxi app is in this database for %@ yet."
          }
        }
      }
    },
    "trip_planner.apps_to_download.note.blacklane" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prebooked professional transfers rather than cheap taxis; useful for airport arrivals in countries where ride-app coverage is thin."
          }
        }
      }
    },
    "trip_planner.apps_to_download.note.bolt_africa" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Strong African-city option; compare comfort tiers at night or for airport rides."
          }
        }
      }
    },
    "trip_planner.apps_to_download.note.bolt_core" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Often the cheapest or fastest mainstream option; still compare at airports where pickup zones can favor taxis."
          }
        }
      }
    },
    "trip_planner.apps_to_download.note.bolt_default" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Often cheaper than Uber in markets where both operate; check driver wait time before picking purely by price."
          }
        }
      }
    },
    "trip_planner.apps_to_download.note.bolt_thailand" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Useful backup to Grab, especially when Grab pricing is high."
          }
        }
      }
    },
    "trip_planner.apps_to_download.note.cabify" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Often feels more regulated than open-market rideshare; good when you want upfront pricing and fewer surprises."
          }
        }
      }
    },
    "trip_planner.apps_to_download.note.careem_default" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Regional staple in the Middle East and North Africa; compare with Uber where both exist."
          }
        }
      }
    },
    "trip_planner.apps_to_download.note.careem_gulf" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usually more locally tuned than Uber; check cash/card options and car categories by city."
          }
        }
      }
    },
    "trip_planner.apps_to_download.note.careem_uae" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Often the best local complement to Uber; useful for taxis, airport rides, and larger car categories."
          }
        }
      }
    },
    "trip_planner.apps_to_download.note.didi_china" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mainland China default; set up payment and saved destinations before arrival if possible."
          }
        }
      }
    },
    "trip_planner.apps_to_download.note.didi_default" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Useful second app where available; compare price and wait time before confirming."
          }
        }
      }
    },
    "trip_planner.apps_to_download.note.didi_latin_america" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Useful Latin America price check against Uber/Cabify; can be cheaper in major cities."
          }
        }
      }
    },
    "trip_planner.apps_to_download.note.didi_oceania" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Good price backup to Uber; not always the deepest driver supply outside major cities."
          }
        }
      }
    },
    "trip_planner.apps_to_download.note.free_now" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Taxi-first app in many European cities; useful where Uber is limited or local taxis get priority pickup zones."
          }
        }
      }
    },
    "trip_planner.apps_to_download.note.gett" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Useful licensed-taxi option in London and Israel; better for black cabs/taxis than bargain rides."
          }
        }
      }
    },
    "trip_planner.apps_to_download.note.go_japan" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Major Japan taxi app; useful because street hailing can be harder outside taxi stands and hotels."
          }
        }
      }
    },
    "trip_planner.apps_to_download.note.gojek" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Good backup in dense city traffic; motorbike options can beat cars on time but are not ideal with luggage."
          }
        }
      }
    },
    "trip_planner.apps_to_download.note.grab_default" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Primary Southeast Asia ride app; compare taxi, car, and bike tiers when available."
          }
        }
      }
    },
    "trip_planner.apps_to_download.note.grab_singapore" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Default Singapore app; TADA can be cheaper when Grab is surging."
          }
        }
      }
    },
    "trip_planner.apps_to_download.note.grab_southeast_asia" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usually the default first download; bike tiers can be fastest, while car/taxi tiers are better with luggage."
          }
        }
      }
    },
    "trip_planner.apps_to_download.note.indrive" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lets riders and drivers negotiate the fare; best as a price-pressure backup, not the first choice when you want frictionless pickup."
          }
        }
      }
    },
    "trip_planner.apps_to_download.note.kakao_t" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Default Korea taxi app; foreign cards/accounts can be fiddly, so set it up before you need a ride."
          }
        }
      }
    },
    "trip_planner.apps_to_download.note.lyft" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usually worth comparing against Uber in North America; it can be meaningfully cheaper during Uber surge."
          }
        }
      }
    },
    "trip_planner.apps_to_download.note.maxim" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Budget taxi app in parts of Central Asia and the Caucasus; check the fare against Yandex Go before accepting."
          }
        }
      }
    },
    "trip_planner.apps_to_download.note.mytaxi" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Local Uzbekistan backup to Yandex Go with competitive rates; especially useful around Tashkent."
          }
        }
      }
    },
    "trip_planner.apps_to_download.note.ola" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Useful India backup to Uber; check auto-rickshaw and mini tiers for cheaper short hops."
          }
        }
      }
    },
    "trip_planner.apps_to_download.note.tada" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
