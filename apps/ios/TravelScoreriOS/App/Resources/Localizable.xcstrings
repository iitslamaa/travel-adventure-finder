    "legal.general_information.body" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يقدم 'مستكشف مغامرات السفر' معلومات عن السفر فقط. جميع الدرجات والتوصيات والإرشادات مخصصة لأغراض التوجيه العام والتعليم فقط. تعتمد أفكار الموسمية على متوسطات المناخ التاريخية وأنماط السفر النموذجية."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Travel Adventure Finder proporciona només informació sobre viatges. Tots els punts, avisos i recomanacions tenen la finalitat de servir com a guia general i amb finalitats educatives. Les dades sobre la estacionalitat es basen en mitjanes climàtiques històriques i patrons de viatge típics."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Travel Adventure Finder poskytuje pouze informační cestovní poznatky. Všechny hodnocení, doporučení a rady jsou určeny pouze pro obecné směřování a vzdělávací účely. Informace o sezónnosti jsou založeny na historických průměrech klimatu a typických cestovních vzorcích."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Travel Adventure Finder giver kun informationsmæssige rejseindsigter. Alle vurderinger, råd og anbefalinger er ment som generel vejledning og til uddannelsesmæssige formål. Sæsonbestemte indsigter er baseret på historiske klima gennemsnit og typiske rejsemønstre."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Travel Adventure Finder bietet nur informative Reiseeinblicke. Alle Punktzahlen, Hinweise und Empfehlungen dienen der allgemeinen Orientierung und Bildungszwecken. Einblicke zur Saisonalitat basieren auf historischen Klimadurchschnitten und typischen Reisemustern."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Travel Adventure Finder παρέχει μόνο πληροφορίες σχετικά με τα ταξίδια. Όλες οι βαθμολογίες, οι συμβουλές και οι προτάσεις προορίζονται για γενική καθοδήγηση και εκπαιδευτικούς σκοπούς. Οι πληροφορίες για τις εποχές βασίζονται σε ιστορικούς μέσους όρους κλίματος και τυπικά μοτίβα ταξιδιών."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Travel Adventure Finder provides informational travel insights only. All scores, advisories, and recommendations are intended for general guidance and educational purposes. Seasonality insights are based on historical climate averages and typical travel patterns."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Travel Adventure Finder ofrece informacion de viaje solo con fines informativos. Todos los puntajes, avisos y recomendaciones son para orientacion general y fines educativos. La informacion de estacionalidad se basa en promedios climaticos historicos y patrones tipicos de viaje."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Travel Adventure Finder tarjoaa vain tiedollista matkailutietoa. Kaikki arvosanat, suositukset ja neuvot on tarkoitettu yleisohjeiksi ja opetustarkoituksiin. Sesonkikohtaiset tiedot perustuvat historiallisiin ilmastoihin ja tyypillisiin matkailumalleihin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Travel Adventure Finder fournit uniquement des informations et apercus de voyage. Tous les scores, alertes et recommandations sont proposes a titre indicatif et educatif. Les apercus de saisonnalite reposent sur des moyennes climatiques historiques et des habitudes de voyage typiques."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Travel Adventure Finder מספק מידע על נסיעות בלבד. כל הציונים, ההנחיות וההמלצות מיועדים להכוונה כללית ולמטרות חינוכיות. תובנות על עונתיות מבוססות על ממוצעי אקלים היסטוריים ודפוסי נסיעות טיפוסיים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ट्रैवल एडवेंचर फ़ाइंडर केवल सूचनात्मक यात्रा अंतर्दृष्टि प्रदान करता है। सभी स्कोर, सलाह और सिफारिशें सामान्य मार्गदर्शन और शैक्षिक उद्देश्यों के लिए हैं। मौसमी अंतर्दृष्टि ऐतिहासिक जलवायु औसत और विशिष्ट यात्रा पैटर्न पर आधारित हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Travel Adventure Finder pruža isključivo informativne putničke uvide. Sve ocjene, preporuke i savjeti namijenjeni su za opće smjernice i edukativne svrhe. Uvidi o sezonalnosti temelje se na povijesnim prosjecima klime i uobičajenim obrascima putovanja."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Travel Adventure Finder csak információs jellegű utazási betekintést nyújt. Minden pontszám, tanács és ajánlás általános útmutatás és oktatási célokra szolgál. Az évszakossággal kapcsolatos betekintések a történelmi éghajlati átlagokon és a tipikus utazási mintákon alapulnak."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Travel Adventure Finder hanya menyediakan informasi wawasan perjalanan. Semua skor, saran, dan rekomendasi dimaksudkan untuk panduan umum dan tujuan edukatif. Wawasan musiman didasarkan pada rata-rata iklim historis dan pola perjalanan yang umum."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Travel Adventure Finder fornisce solo informazioni e indicazioni di viaggio. Tutti i punteggi, gli avvisi e le raccomandazioni sono destinati a orientamento generale e scopi educativi. Le indicazioni sulla stagionalita si basano su medie climatiche storiche e modelli di viaggio tipici."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "トラベルアドベンチャーファインダーは情報提供のための旅行インサイトのみを提供します。すべてのスコア、アドバイス、および推奨事項は、一般的なガイダンスおよび教育目的を意図したものです。季節性のインサイトは、過去の気候平均および典型的な旅行パターンに基づいています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "트래블 어드벤처 파인더는 정보 제공 목적으로만 여행 인사이트를 제공합니다. 모든 점수, 권고 사항 및 추천은 일반적인 안내 및 교육 목적으로만 제공됩니다. 계절성 인사이트는 과거 기후 평균과 일반적인 여행 패턴을 기반으로 합니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Travel Adventure Finder hanya menyediakan maklumat pandangan perjalanan. Semua skor, nasihat, dan cadangan adalah untuk panduan umum dan tujuan pendidikan sahaja. Pandangan musim berdasarkan purata iklim sejarah dan corak perjalanan biasa."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Travel Adventure Finder gir kun informasjonsbasert reiseinnsikt. Alle vurderinger, råd og anbefalinger er ment som generell veiledning og for utdanningsformål. Sesongmessige innsikter er basert på historiske klimagjennomsnitt og typiske reisevaner."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Travel Adventure Finder biedt uitsluitend informatieve reisinzichten. Alle beoordelingen, adviezen en aanbevelingen zijn bedoeld voor algemene richtlijnen en educatieve doeleinden. Inzichten over seizoensgebondenheid zijn gebaseerd op historische klimaatsgemiddelden en typische reispatronen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Travel Adventure Finder dostarcza wyłącznie informacji podróżniczych. Wszystkie oceny, zalecenia i rekomendacje mają charakter ogólnych wskazówek i celów edukacyjnych. Informacje o sezonowości oparte są na historycznych średnich klimatycznych i typowych wzorcach podróży."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Travel Adventure Finder fornece apenas informacoes e insights de viagem. Todas as pontuacoes, avisos e recomendacoes destinam-se a orientacao geral e fins educacionais. Os insights de sazonalidade se baseiam em medias climaticas historicas e padroes tipicos de viagem."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Travel Adventure Finder oferă doar informații despre călătorii. Toate scorurile, avertismentele și recomandările sunt destinate doar pentru ghidare generală și scopuri educaționale. Informațiile despre sezonalitate se bazează pe medii climatice istorice și tipare de călătorie tipice."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Travel Adventure Finder предоставляет только информационные сведения о путешествиях. Все оценки, рекомендации и советы предназначены для общего ориентирования и образовательных целей. Сведения о сезонности основаны на исторических климатических средних и типичных туристических паттернах."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Travel Adventure Finder poskytuje iba informačné cestovateľské informácie. Všetky skóre, odporúčania a rady sú určené len na všeobecné usmernenie a vzdelávacie účely. Informácie o sezónnosti sú založené na historických priemeroch počasia a typických cestovných vzorcoch."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Travel Adventure Finder tillhandahåller endast informativa reseinsikter. Alla poäng, råd och rekommendationer är avsedda för allmän vägledning och utbildningsändamål. Säsongsbaserade insikter baseras på historiska klimatgenomsnitt och typiska resevanor."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Travel Adventure Finder ให้ข้อมูลเชิงข้อมูลเกี่ยวกับการเดินทางเท่านั้น คะแนน คำแนะนำ และคำแนะนำทั้งหมดมีไว้เพื่อเป็นแนวทางทั่วไปและเพื่อวัตถุประสงค์ทางการศึกษา ข้อมูลเชิงฤดูกาลอิงตามค่าเฉลี่ยสภาพอากาศในอดีตและรูปแบบการเดินทางทั่วไป"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Travel Adventure Finder sadece bilgilendirici seyahat içgörüleri sağlar. Tüm puanlar, tavsiyeler ve öneriler genel rehberlik ve eğitim amaçlıdır. Mevsimsellik içgörüleri tarihsel iklim ortalamalarına ve tipik seyahat kalıplarına dayanmaktadır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сервіс Travel Adventure Finder надає лише інформаційні відомості про подорожі. Всі оцінки, рекомендації та поради призначені виключно для загального ознайомлення та освітніх цілей. Інформація про сезонність базується на середніх історичних кліматичних даних та типових туристичних схемах."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Travel Adventure Finder chỉ cung cấp thông tin về du lịch. Tất cả các điểm số, khuyến cáo và đề xuất chỉ nhằm mục đích hướng dẫn chung và giáo dục. Thông tin về tính theo mùa được dựa trên mức trung bình khí hậu lịch sử và các mô hình du lịch điển hình."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "旅行探险发现者仅提供信息性的旅行见解。所有评分、建议和推荐仅用于一般指导和教育目的。季节性见解基于历史气候平均值和典型的旅行模式。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "旅行探險搜尋器僅提供旅遊資訊。所有評分、建議和推薦僅用於一般指引和教育用途。季節性洞察基於歷史氣候平均值和典型旅遊模式。"
          }
        }
      }
    },
