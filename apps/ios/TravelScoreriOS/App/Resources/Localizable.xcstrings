    "country_detail.visa.body.voa" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُصدر التأشيرة عند الوصول؛ توقع التعامل مع الأوراق ورسوم محتملة على الحدود."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El visat s'emet a l'arribada; espereu-vos a tramitar la documentació i possibles taxes a la frontera."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vízum je vydáváno při příjezdu; očekávejte vyřizování papírů a možné poplatky na hranici."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visum udstedes ved ankomst; forvent at håndtere papirarbejde og mulige gebyrer ved grænsen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
