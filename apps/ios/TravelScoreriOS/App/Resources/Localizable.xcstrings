    "friend_requests.empty.subtitle" : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عندما يرسل لك شخص طلب صداقة، سيظهر هنا."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quan algú t'envia una sol·licitud d'amistat, apareixerà aquí."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Když vám někdo pošle žádost o přátelství, zobrazí se zde."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når nogen sender dig en venneanmodning, vil den blive vist her."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn dir jemand eine Freundschaftsanfrage sendet, erscheint sie hier."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Όταν κάποιος σας στείλει αίτημα φιλίας, θα εμφανιστεί εδώ."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When someone sends you a friend request, it will show up here."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando alguien te envie una solicitud de amistad, aparecera aqui."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun joku lähettää sinulle kaveripyyntöä, se näkyy täällä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When someone sends you a friend request, it will show up here."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כאשר מישהו שולח לך בקשת חברות, זה יופיע כאן."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जब कोई आपको मित्र अनुरोध भेजेगा, तो वह यहां दिखाई देगा।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kada ti netko pošalje zahtjev za prijateljstvo, pojavit će se ovdje."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Amikor valaki baráti kérést küld neked, az itt fog megjelenni."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ketika seseorang mengirimkan permintaan pertemanan kepada Anda, itu akan muncul di sini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando qualcuno ti invia una richiesta di amicizia, comparira qui."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "誰かがあなたに友達リクエストを送ると、ここに表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "누군가가 친구 요청을 보내면 여기에 표시됩니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apabila seseorang menghantar permintaan kawan kepada anda, ia akan dipaparkan di sini."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når noen sender deg en venneforespørsel, vil den vises her."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wanneer iemand je een vriendverzoek stuurt, wordt dit hier weergegeven."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kiedy ktoś wyśle Ci prośbę o dodanie do znajomych, pojawi się ona tutaj."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando alguem enviar um pedido de amizade, ele aparecera aqui."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Când cineva îți trimite o cerere de prietenie, va apărea aici."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Когда кто-то отправит вам запрос в друзья, он появится здесь."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keď vám niekto pošle žiadosť o priateľstvo, zobrazí sa to tu."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "När någon skickar en vänförfrågan till dig kommer den att visas här."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เมื่อมีใครสักคนส่งคำขอเป็นเพื่อนให้คุณ มันจะแสดงที่นี่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Birisi size arkadaşlık isteği gönderdiğinde, burada görünecektir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Коли хтось надішле вам запит на дружбу, він з’явиться тут."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khi ai đó gửi cho bạn một lời mời kết bạn, nó sẽ hiển thị ở đây."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当有人向你发送好友请求时，它会显示在这里。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "當有人向你發送好友請求時，它將顯示在這裡。"
          }
        }
      }
    },
