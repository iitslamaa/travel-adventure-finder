          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การเข้าถึงปฏิทินถูกปฏิเสธ คุณสามารถเปิดใช้งานได้ภายหลังในการตั้งค่า"
