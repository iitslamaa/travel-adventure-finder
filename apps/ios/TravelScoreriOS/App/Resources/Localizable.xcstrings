    "seasonality.section.peak.note" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أفضل طقس وظروف بشكل عام. توقع أكثر فترة ازدحامًا، وأسعار أعلى، وأقوى تقييمات للسفر بشكل عام."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Millor clima i condicions generals. Espereu el tram més concorregut, preus més alts i les puntuacions de viatge més fortes en general."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nejlepší počasí a celkové podmínky. Očekávejte nejrušnější úsek, vyšší ceny a nejsilnější celkové hodnocení cestování."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bedste vejr og samlede forhold. Forvent den travleste periode, højere priser og de stærkeste samlede rejsevurderinger."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bestes Wetter und insgesamt beste Bedingungen. Erwarten Sie den verkehrsreichsten Abschnitt, höhere Preise und die stärksten allgemeinen Reisebewertungen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Καλύτερος καιρός και συνολικές συνθήκες. Αναμένετε την πιο πολυσύχναστη περίοδο, υψηλότερες τιμές και τους πιο δυνατούς συνολικά ταξιδιωτικούς βαθμούς."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Best weather and overall conditions. Expect the busiest stretch, higher prices, and the strongest all-around travel scores."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mejor clima y condiciones generales. Espere el tramo más concurrido, precios más altos y las mejores puntuaciones generales de viaje."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paras sää ja kokonaisolosuhteet. Odota vilkkainta jaksoa, korkeampia hintoja ja vahvimpia kokonaismatkustusarvosanoja."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meilleur temps et conditions générales. Attendez-vous à la période la plus fréquentée, à des prix plus élevés et aux meilleurs scores globaux en matière de voyage."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "המזג אוויר והתנאים הכוללים הטובים ביותר. צפו לחלק הכי עמוס, מחירים גבוהים יותר, וציון הנסיעה הכולל החזק ביותר."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सबसे अच्छा मौसम और सामान्य परिस्थितियाँ। सबसे व्यस्त समय का अनुमान लगाएँ, उच्च कीमतों की उम्मीद करें, और सबसे मजबूत आम यात्रा रेटिंग्स।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Najbolje vrijeme i opći uvjeti. Očekujte najprometniji period, više cijene i najbolje ukupne ocjene putovanja."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A legjobb időjárás és általános körülmények. Számíts a legforgalmasabb időszakra, magasabb árakra és a legerősebb átfogó utazási értékelésekre."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuaca dan kondisi secara keseluruhan terbaik. Harapkan jalur terpadat, harga lebih tinggi, dan skor perjalanan paling kuat secara keseluruhan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Migliore tempo e condizioni generali. Aspettati il periodo più affollato, prezzi più alti e i punteggi di viaggio complessivi più elevati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最高の天気と全体的な条件。最も混雑する区間、高い料金、そして全体的に最も高い旅行評価が予想されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "최고의 날씨와 전반적인 조건. 가장 붐비는 구간, 더 높은 가격, 그리고 전반적으로 가장 높은 여행 점수를 예상하세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuaca dan keadaan keseluruhan terbaik. Jangkakan bahagian paling sibuk, harga yang lebih tinggi, dan skor perjalanan menyeluruh yang paling kuat."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beste vær og generelle forhold. Forvent den mest travle perioden, høyere priser og de sterkeste samlede vurderingene for reiser."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beste weer en algehele omstandigheden. Verwacht het drukste gedeelte, hogere prijzen en de sterkste algemene reiscijfers."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Najlepsza pogoda i ogólne warunki. Spodziewaj się najbardziej ruchliwego odcinka, wyższych cen i najsilniejszych wyników podróży we wszystkich aspektach."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Melhor clima e condições gerais. Espere o trecho mais movimentado, preços mais altos e as melhores pontuações gerais de viagem."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cea mai bună vreme și cele mai bune condiții generale. Așteptați-vă la cea mai aglomerată perioadă, prețuri mai mari și cele mai bune scoruri de călătorie în general."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Лучшая погода и общие условия. Ожидайте самый оживленный участок, более высокие цены и наивысшие общие оценки путешествий."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Najlepšie počasie a celkové podmienky. Očakávajte najrušnejší úsek, vyššie ceny a najsilnejšie celkové hodnotenia cestovania."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bäst väder och övergripande förhållanden. Förvänta dig den mest trafikerade perioden, högre priser och de starkaste totala resebetygen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "สภาพอากาศและสภาวะโดยรวมที่ดีที่สุด คาดว่าจะมีช่วงที่คึกคักที่สุด ราคาที่สูงขึ้น และคะแนนการเดินทางรอบด้านที่แข็งแกร่งที่สุด"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En iyi hava ve genel koşullar. En yoğun dönemi, daha yüksek fiyatları ve her açıdan en güçlü seyahat puanlarını bekleyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Найкраща погода та загальні умови. Очікуйте найбільш завантажений період, вищі ціни та найсильніші показники подорожей загалом."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thời tiết và điều kiện tổng thể tốt nhất. Mong đợi đoạn đường đông đúc nhất, giá cao hơn và điểm du lịch tổng thể mạnh nhất."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最佳的天气和整体条件。预计最繁忙的时段、更高的价格，以及最强的综合旅行评分。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最佳的天氣和整體條件。預期最繁忙的時段、較高的價格，以及最強的綜合旅行評分。"
          }
        }
      }
    },
