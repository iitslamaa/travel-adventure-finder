    "trip_planner.expenses.overlay_subtitle" : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تتبع ما تم دفعه، ومن استفاد، ومن لا يزال مدينًا."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Feu un seguiment del que s'ha pagat, qui n'ha beneficiat i qui encara deu."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sledujte, co bylo zaplaceno, kdo z toho měl prospěch a kdo ještě dluží."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hold styr på, hvad der blev betalt, hvem der havde fordel af det, og hvem der stadig skylder."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verfolge, was bezahlt wurde, wer profitiert hat und wer noch schuldet."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Καταγράψτε τι πληρώθηκε, ποιος ωφελήθηκε και ποιος εξακολουθεί να οφείλει."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Track what was paid, who benefited, and who still owes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lleva el control de lo pagado, quien se beneficio y quien todavia debe."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seuraa, mitä maksettiin, kuka hyötyi ja kuka on vielä velkaa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suivez ce qui a ete paye, qui en a profite et qui doit encore."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "עקוב מה שולם, מי נהנה, ומי עוד חייב."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जो भुगतान किया गया, किसे लाभ हुआ, और किस पर अभी बकाया है, उसका ट्रैक रखें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pratite što je plaćeno, tko je imao koristi i tko još duguje."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kövesse nyomon, mi lett kifizetve, ki részesült előnyben, és ki tartozik még."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lacak apa yang telah dibayar, siapa yang mendapat manfaat, dan siapa yang masih berutang."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tieni traccia di cosa e stato pagato, chi ne ha beneficiato e chi deve ancora pagare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "支払われたもの、誰が利益を得たか、誰がまだ借りているかを追跡する。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지불된 내역, 혜택을 받은 사람, 그리고 아직 빚을 진 사람을 추적하세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jejaki apa yang telah dibayar, siapa yang mendapat faedah, dan siapa yang masih berhutang."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Følg med på hva som ble betalt, hvem som hadde nytte av det, og hvem som fortsatt skylder."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Houd bij wat is betaald, wie ervan heeft geprofiteerd en wie nog moet betalen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Śledź, co zostało zapłacone, kto skorzystał i kto jeszcze jest winien."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acompanhe o que foi pago, quem se beneficiou e quem ainda deve."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Urmărește ce s-a plătit, cine a beneficiat și cine încă datorează."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отслеживайте, что было оплачено, кто получил выгоду и кто все еще должен."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sledujte, čo bolo zaplatené, kto využil a kto ešte dlží."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spåra vad som betalades, vem som gynnades och vem som fortfarande är skyldig."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ติดตามสิ่งที่จ่ายไป ใครได้รับประโยชน์ และใครยังคงค้างชำระ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ne ödendiğini, kimin faydalandığını ve kimin hala borcu olduğunu takip edin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Відстежуйте, що було сплачено, хто скористався, а хто ще винен."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Theo dõi những gì đã thanh toán, ai được hưởng lợi, và ai vẫn còn nợ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "追踪已支付的款项、受益人以及仍然欠款的人。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "追蹤支付了什麼、誰獲益，以及誰仍然欠款。"
          }
        }
      }
    },
