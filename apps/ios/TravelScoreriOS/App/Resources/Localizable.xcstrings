          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Provavelmente sera mais util em areas fortemente turisticas do que em todo lugar."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ar trebui să fie cel mai util în zonele cu turism intens, mai degrabă decât peste tot."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
