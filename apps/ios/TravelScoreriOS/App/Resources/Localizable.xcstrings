    "feedback.intro.body_4" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أنا أقرأ كل رسالة بنفسي وأعمل يوميًا على جعل TAF أفضل. شكرًا لوجودك هنا واستمر في السفر!"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Llegeixo cada missatge personalment i treballo cada dia per fer que TAF sigui millor. Gràcies per ser aquí i continua viatjant!"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Každou zprávu čtu osobně a každý den pracuji na tom, aby byl TAF lepší. Děkuji, že tu jste, a pokračujte v cestování!"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeg læser hver besked personligt og arbejder dagligt på at gøre TAF bedre. Tak fordi du er her, og fortsæt rejsen!"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ich lese jede Nachricht personlich und arbeite jeden Tag daran, TAF besser zu machen. Danke, dass du hier bist, und gute Reise!"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Διαβάζω κάθε μήνυμα προσωπικά και εργάζομαι καθημερινά για να κάνω το TAF καλύτερο. Σας ευχαριστώ που είστε εδώ και συνεχίστε το ταξίδι!"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I read every message personally and work daily to make TAF better. Thank you for being here and travel on!"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leo cada mensaje personalmente y trabajo todos los dias para mejorar TAF. Gracias por estar aqui y buen viaje."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Luen henkilökohtaisesti jokaisen viestin ja työskentelen päivittäin tehdäksemme TAF:ista paremman. Kiitos, että olet täällä, ja jatka matkaa!"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je lis chaque message moi-meme et je travaille chaque jour pour ameliorer TAF. Merci d'etre ici et bon voyage !"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אני קורא כל הודעה באופן אישי ועובד מדי יום כדי לשפר את TAF. תודה שהיית כאן והמשך במסע!"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मैं प्रत्येक संदेश को व्यक्तिगत रूप से पढ़ता हूं और टीएएफ को बेहतर बनाने के लिए प्रतिदिन काम करता हूं। यहां आने और यात्रा करने के लिए धन्यवाद!"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Svaku poruku pročitam osobno i svakodnevno radim na tome da TAF bude bolji. Hvala što ste ovdje i sretan put!"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minden üzenetet személyesen olvasok el, és naponta dolgozom azon, hogy a TAF jobb legyen. Köszönöm, hogy itt vagy, és jó utazást!"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saya membaca setiap pesan secara pribadi dan bekerja setiap hari untuk membuat TAF lebih baik. Terima kasih telah berada di sini dan teruslah melanjutkan perjalanan!"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leggo personalmente ogni messaggio e lavoro ogni giorno per rendere TAF migliore. Grazie per essere qui e buon viaggio!"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "私はすべてのメッセージを個人的に読み、TAFをより良くするために毎日取り組んでいます。ここにいてくれて、そして旅を続けてくれてありがとうございます！"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "저는 모든 메시지를 직접 읽고 매일 TAF를 더 좋게 만들기 위해 노력합니다. 여기 있어 주셔서 감사하고 계속 여행하세요!"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saya membaca setiap mesej secara peribadi dan bekerja setiap hari untuk menjadikan TAF lebih baik. Terima kasih kerana berada di sini dan teruskan perjalanan!"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeg leser hver melding personlig og jobber daglig for å gjøre TAF bedre. Takk for at du er her, og reis videre!"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ik lees elk bericht persoonlijk en werk dagelijks eraan om TAF beter te maken. Bedankt dat je hier bent en reis verder!"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Czytam każdą wiadomość osobiście i codziennie pracuję, aby TAF było lepsze. Dziękuję, że tu jesteś i ruszaj w podróż!"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leio cada mensagem pessoalmente e trabalho todos os dias para melhorar o TAF. Obrigada por estar aqui e boa viagem!"
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Citesc personal fiecare mesaj și lucrez zilnic pentru a face TAF mai bun. Mulțumesc că ești aici și călătorește mai departe!"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Я лично читаю каждое сообщение и каждый день работаю над тем, чтобы сделать TAF лучше. Спасибо, что вы здесь, и счастливых путешествий!"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Každú správu čítam osobne a denne pracujem na tom, aby bol TAF lepší. Ďakujem, že ste tu, a pokračujte v cestovaní!"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jag läser varje meddelande personligen och arbetar dagligen för att göra TAF bättre. Tack för att du är här och fortsätt resan!"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ฉันอ่านข้อความทุกข้อความด้วยตัวเองและทำงานทุกวันเพื่อทำให้ TAF ดีขึ้น ขอบคุณที่อยู่ที่นี่และเดินทางต่อไป!"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her mesajı kişisel olarak okuyorum ve TAF'ı daha iyi hale getirmek için her gün çalışıyorum. Burada olduğunuz için teşekkürler ve yolculuğunuza devam edin!"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Я особисто читаю кожне повідомлення і щодня працюю над тим, щоб TAF став кращим. Дякую, що ви тут, і продовжуйте подорож!"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tôi đọc tất cả tin nhắn một cách cá nhân và làm việc hàng ngày để làm TAF tốt hơn. Cảm ơn bạn đã ở đây và tiếp tục hành trình!"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我会亲自阅读每条消息，并每天努力让TAF变得更好。感谢你的到来，继续前行吧！"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我親自閱讀每一則訊息，並每天努力讓TAF變得更好。感謝你的參與，祝旅途順利！"
          }
        }
      }
    },
