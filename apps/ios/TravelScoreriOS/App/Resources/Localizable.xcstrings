          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η βίζα εκδίδεται κατά την άφιξη· αναμένεται να χειριστείτε τα έγγραφα και πιθανές χρεώσεις στα σύνορα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visa is issued on arrival; expect to handle paperwork and possible fees at the border."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La visa se emite a la llegada; espera realizar tramites y posibles pagos en la frontera."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viisumi myönnetään saavuttaessa; varaa aikaa paperityölle ja mahdollisiin maksuihin rajalla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le visa est delivre a l'arrivee ; attendez-vous a gerer des formalites et d'eventuels frais a la frontiere."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הויזה מונפקת עם ההגעה; צפוי שתצטרך לטפל בניירת ובאגרות אפשריות בגבול."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आगमन पर वीज़ा जारी किया जाता है; सीमा पर कागजी कार्रवाई और संभावित शुल्क को संभालने की अपेक्षा करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viza se izdaje po dolasku; očekujte rješavanje papirologije i moguće naknade na granici."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A vízum a megérkezéskor kerül kiállításra; számíts arra, hogy a határon intézned kell az ügyintézést és esetleges díjakat."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visa diterbitkan saat kedatangan; harapkan untuk mengurus dokumen dan kemungkinan biaya di perbatasan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il visto viene rilasciato all'arrivo; aspettati pratiche burocratiche e possibili costi alla frontiera."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ビザは到着時に発行されます。国境で書類手続きを行い、場合によっては手数料がかかることがあります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "비자는 도착 시 발급됩니다; 국경에서 서류 처리와 가능한 요금을 준비해야 합니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visa dikeluarkan semasa ketibaan; jangkakan untuk menguruskan dokumen dan kemungkinan yuran di sempadan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visum utstedes ved ankomst; forvent å håndtere papirarbeid og mulige gebyrer ved grensen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visum wordt bij aankomst afgegeven; verwacht dat u papierenwerk en eventuele kosten bij de grens moet afhandelen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wiza wydawana jest po przybyciu; należy się spodziewać załatwiania formalności i ewentualnych opłat na granicy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O visto e emitido na chegada; espere lidar com burocracia e possiveis taxas na fronteira."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viza se eliberează la sosire; așteptați-vă să completați formalități și să achitați eventuale taxe la frontieră."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Виза оформляется по прибытии; будьте готовы к документам и возможным сборам на границе."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Víza sa vydávajú po príchode; očakávajte vybavovanie papierovania a možné poplatky na hranici."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visum utfärdas vid ankomst; räkna med att hantera papper och eventuella avgifter vid gränsen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "วีซ่าจะออกเมื่อเดินทางมาถึง คาดว่าจะต้องจัดการเอกสารและค่าใช้จ่ายที่อาจเกิดขึ้นที่ชายแดน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vize varışta verilmektedir; sınırda evrak işleri ve olası ücretlerle ilgilenmeyi bekleyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Віза видається по прибутті; очікуйте, що доведеться оформлювати документи та можливі збори на кордоні."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visa được cấp khi đến nơi; hãy chuẩn bị xử lý giấy tờ và có thể phải trả phí tại biên giới."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "签证在抵达时办理；预计需在边境处理相关文件和可能的费用。"
