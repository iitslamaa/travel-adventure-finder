        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sesonkivaihtelutiedot perustuvat historiallisten ilmastoarvojen keskiarvoihin ja tyypillisiin matkustustottumuksiin. Ajankohta voi vaihdella vuodesta toiseen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les indications de saisonnalite sont basees sur des moyennes climatiques historiques et des habitudes de voyage typiques. La periode peut varier d'une annee a l'autre."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "תובנות עונתיות מבוססות על ממוצעי אקלים היסטוריים ודפוסי נסיעות טיפוסיים. הזמן עשוי להשתנות משנה לשנה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मौसमी अंतर्दृष्टि ऐतिहासिक जलवायु औसत और विशिष्ट यात्रा पैटर्न पर आधारित हैं। समय हर साल अलग-अलग हो सकता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uvidi u sezonalnost temelje se na povijesnim prosjecima klime i uobičajenim obrascima putovanja. Vrijeme se može razlikovati iz godine u godinu."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az évszakonkénti betekintések a történelmi éghajlati átlagokon és a tipikus utazási mintákon alapulnak. Az időzítés évente változhat."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wawasan musiman didasarkan pada rata-rata iklim historis dan pola perjalanan yang umum. Waktu dapat bervariasi dari tahun ke tahun."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le indicazioni sulla stagionalita si basano su medie climatiche storiche e modelli di viaggio tipici. Il periodo puo variare di anno in anno."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "季節性に関する洞察は、過去の気候平均と一般的な旅行パターンに基づいています。時期は年ごとに異なる場合があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "계절적 통찰은 과거 기후 평균과 일반적인 여행 패턴을 기반으로 합니다. 시기는 해마다 달라질 수 있습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wawasan bermusim adalah berdasarkan purata iklim sejarah dan corak perjalanan biasa. Masa boleh berubah dari tahun ke tahun."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sesonginnsikt er basert på historiske klimagjennomsnitt og typiske reisevaner. Tidspunkt kan variere fra år til år."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inzichten over seizoensgebondenheid zijn gebaseerd op historische klimaatgemiddelden en typische reispatronen. De timing kan van jaar tot jaar variëren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wnioski dotyczące sezonowości opierają się na historycznych średnich klimatycznych i typowych wzorcach podróży. Czas może się różnić w zależności od roku."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os insights de sazonalidade se baseiam em medias climaticas historicas e padroes tipicos de viagem. O momento pode variar de ano para ano."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Informațiile despre sezonalitate se bazează pe mediile climatice istorice și pe tiparele obișnuite de călătorie. Momentul poate varia de la an la an."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сведения о сезонности основаны на исторических климатических средних и типичных туристических паттернах. Из года в год время может немного отличаться."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poznatky o sezónnosti sú založené na historických priemeroch klímy a typických cestovných vzoroch. Časovanie sa môže rok od roku líšiť."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Säsongsinsikter baseras på historiska klimatgenomsnitt och typiska resevanor. Tidpunkten kan variera från år till år."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ข้อมูลเชิงลึกเกี่ยวกับฤดูกาลขึ้นอยู่กับค่าเฉลี่ยภูมิอากาศในอดีตและรูปแบบการเดินทางโดยทั่วไป เวลาอาจแตกต่างกันไปในแต่ละปี"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mevsimsellik bilgileri, tarihsel iklim ortalamalarına ve tipik seyahat kalıplarına dayanmaktadır. Zamanlama yıl yıl değişebilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Інформація про сезонність базується на історичних середніх кліматичних показниках та типовій туристичній активності. Часові рамки можуть змінюватися з року в рік."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Những thông tin về tính mùa vụ dựa trên trung bình khí hậu lịch sử và các mô hình du lịch điển hình. Thời gian có thể thay đổi theo từng năm."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "季节性洞察基于历史气候平均值和典型旅行模式。时间可能会因年份而有所不同。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "季節性洞察基於歷史氣候平均值和典型旅行模式。時機可能每年有所不同。"
          }
        }
      }
    },
