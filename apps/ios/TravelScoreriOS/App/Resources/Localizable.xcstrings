        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les regles actuelles peuvent fortement limiter ou interdire l'entree ; verifiez les recommandations officielles avant de planifier."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הכללים הנוכחיים עלולים להגביל באופן חמור או לאסור כניסה; בדוק את ההנחיות הרשמיות לפני התכנון."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "वर्तमान नियम प्रवेश को गंभीर रूप से सीमित या प्रतिबंधित कर सकते हैं; योजना बनाने से पहले आधिकारिक मार्गदर्शन की जाँच करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trenutna pravila mogu ozbiljno ograničiti ili zabraniti ulazak; provjerite službene upute prije planiranja."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A jelenlegi szabályok súlyosan korlátozhatják vagy tilthatják a belépést; a tervezés előtt ellenőrizze a hivatalos útmutatást."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
