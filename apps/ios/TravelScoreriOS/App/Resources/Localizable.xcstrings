    "trip_planner.calendar_error_denied" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم رفض الوصول إلى التقويم. يمكنك تمكينه لاحقًا في الإعدادات."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S'ha denegat l'accés al calendari. Pots activar-lo més tard a Configuració."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přístup ke kalendáři byl odepřen. Můžete jej později povolit v Nastavení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adgang til kalenderen blev nægtet. Du kan aktivere den senere i Indstillinger."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Kalenderzugriff wurde verweigert. Du kannst ihn spater in den Einstellungen aktivieren."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η πρόσβαση στο ημερολόγιο αρνήθηκε. Μπορείτε να την ενεργοποιήσετε αργότερα στις Ρυθμίσεις."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Calendar access was denied. You can enable it later in Settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se denego el acceso al calendario. Puedes activarlo despues en Configuracion."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kalenterin käyttö estettiin. Voit ottaa sen käyttöön myöhemmin Asetuksissa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'acces au calendrier a ete refuse. Vous pouvez l'activer plus tard dans Reglages."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הגישה ליומן נדחתה. ניתן לאפשר אותה מאוחר יותר בהגדרות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कैलेंडर तक पहुंच अस्वीकार कर दी गई। आप इसे बाद में सेटिंग्स में सक्षम कर सकते हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pristup kalendaru je odbijen. Možete ga omogućiti kasnije u Postavkama."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A naptárhoz való hozzáférés megtagadva. Később a Beállításokban engedélyezheti."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Akses kalender ditolak. Anda dapat mengaktifkannya nanti di Pengaturan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'accesso al calendario e stato negato. Puoi abilitarlo piu tardi nelle Impostazioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カレンダーへのアクセスが拒否されました。後で設定で有効にすることができます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "캘린더 접근이 거부되었습니다. 나중에 설정에서 활성화할 수 있습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Akses kalendar ditolak. Anda boleh mengaktifkannya kemudian dalam Tetapan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kalendertilgang ble nektet. Du kan aktivere det senere i Innstillinger."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
