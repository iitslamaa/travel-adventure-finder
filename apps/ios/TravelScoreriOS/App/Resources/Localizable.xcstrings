    "trip_planner.packing.progress_empty" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أضف العناصر إلى قائمة التعبئة الجماعية أولاً، ثم ضع علامة عليها هنا أثناء تعبئتها."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afegeix primer els articles a la llista de batibull del grup, després marca'ls aquí mentre els empaquetes."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nejprve přidejte položky do skupinového seznamu balení, poté je zde odškrtávejte, když je balíte."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tilføj først varer til gruppens pakkeliste, og sæt dem derefter af her, mens du pakker."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fügen Sie zuerst Artikel zur Gruppenpackliste hinzu und haken Sie sie dann hier ab, während Sie packen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Προσθέστε πρώτα αντικείμενα στη λίστα συσκευασίας της ομάδας και στη συνέχεια τσεκάρετέ τα εδώ καθώς τα συσκευάζετε."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add items to the group packing list first, then check them off here as you pack."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agrega los artículos a la lista de empaque del grupo primero, luego márcalos aquí mientras los empacas."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lisää kohteet ensin ryhmän pakkauslistalle, ja merkitse sitten ne täällä, kun pakkaat."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez d'abord des articles à la liste de colisage du groupe, puis cochez-les ici au fur et à mesure que vous les emballez."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הוסף פריטים לרשימת האריזה של הקבוצה קודם, ואז סמן אותם כאן כאשר אתה אורז."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सबसे पहले समूह पैकिंग सूची में आइटम जोड़ें, फिर इन्हें पैक करते समय यहाँ चेक करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prvo dodajte stavke na grupnu listu za pakiranje, a zatim ih ovdje označite kada ih spakirate."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Először add hozzá az elemeket a csoportos csomagolási listához, majd itt pipáld ki őket, ahogy csomagolsz."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tambahkan barang ke daftar pengepakan grup terlebih dahulu, lalu centang di sini saat Anda mengepaknya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiungi prima gli oggetti alla lista di imballaggio del gruppo, poi spuntali qui mentre li metti in valigia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "まずグループの持ち物リストにアイテムを追加し、それからここで梱包する際にチェックしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "먼저 그룹 짐싸기 목록에 항목을 추가한 다음, 짐을 싸면서 여기에서 체크하세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tambah barang ke senarai pembungkusan kumpulan terlebih dahulu, kemudian tandakan di sini semasa anda membungkus."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legg til varer på gruppens pakkeliste først, og kryss dem deretter av her mens du pakker."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voeg eerst de artikelen toe aan de groepsinpaklijst en vink ze hier af terwijl u inpakt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Najpierw dodaj przedmioty do grupowej listy pakowania, a następnie odhaczaj je tutaj podczas pakowania."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adicione os itens à lista de embalagem do grupo primeiro, depois marque-os aqui enquanto faz as malas."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adaugă mai întâi obiectele pe lista de împachetare a grupului, apoi bifează-le aici pe măsură ce le împachetezi."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сначала добавьте товары в общий список упаковки, а затем отмечайте их здесь по мере упаковки."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Najprv pridajte položky do skupinového zoznamu balenia, potom ich tu odškrtávajte, keď ich balíte."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lägg till föremål i gruppens packlista först, och bocka sedan av dem här när du packar."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เพิ่มรายการสิ่งของลงในรายการแพ็คของกลุ่มก่อน จากนั้นทำเครื่องหมายที่นี่เมื่อคุณจัดแพ็คเรียบร้อยแล้ว"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Önce öğeleri grup paketleme listesine ekleyin, ardından paketlerken bunları burada işaretleyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Спочатку додайте предмети до групового списку пакування, а потім відмічайте їх тут під час пакування."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thêm các vật phẩm vào danh sách đóng gói nhóm trước, sau đó đánh dấu chúng ở đây khi bạn đóng gói."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "先将物品添加到团队打包清单中，然后在打包时在这里勾选它们。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "先將物品加入團體打包清單，然後在這裡打勾標記你已打包的物品。"
          }
        }
      }
    },
