          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obowiązujące przepisy mogą znacznie ograniczać lub zakazywać wjazdu; sprawdź oficjalne wytyczne przed planowaniem."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As regras atuais podem limitar severamente ou proibir a entrada; confira orientacoes oficiais antes de planejar."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Regulile actuale pot limita sever sau interzice intrarea; verificați ghidul oficial înainte de a face planuri."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Текущие правила могут серьёзно ограничивать или запрещать въезд; проверьте официальные рекомендации перед планированием."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Súčasné pravidlá môžu výrazne obmedziť alebo zakázať vstup; pred plánovaním si overte oficiálne pokyny."
          }
        },
        "sv" : {
          "stringUnit" : {
