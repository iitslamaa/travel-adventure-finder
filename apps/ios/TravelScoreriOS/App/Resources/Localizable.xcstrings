    "discovery.preview.best_time_summary" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هذا الشهر هو واحد من أفضل الأوقات للزيارة بناءً على الطقس، والزحام، والظروف العامة. افتح صفحة البلد الكاملة لمقارنة السلامة، والتكلفة، وتفاصيل التأشيرة."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aquest mes és una de les millors èpoques per visitar segons el clima, les multituds i les condicions generals. Obriu la pàgina completa del país per comparar la seguretat, l’accessibilitat i els detalls del visat."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tento měsíc je jedním z nejlepších časů pro návštěvu vzhledem k počasí, davům a celkovým podmínkám. Otevřete celou stránku země, abyste mohli porovnat bezpečnost, cenovou dostupnost a podrobnosti o vízech."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne måned er en af de bedste tidspunkter at besøge baseret på vejr, folkemængder og generelle forhold. Åbn hele landets side for at sammenligne sikkerhed, overkommelighed og visaoplysninger."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Monat ist eine der besten Reisezeiten basierend auf Wetter, Andrang und allgemeinen Bedingungen. Offne die vollstandige Landesseite, um Sicherheit, Erschwinglichkeit und Visadetails zu vergleichen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αυτός ο μήνας είναι ένας από τους καλύτερους για να επισκεφθείτε με βάση τον καιρό, τον κόσμο και τις συνολικές συνθήκες. Ανοίξτε τη σελίδα ολόκληρης της χώρας για να συγκρίνετε την ασφάλεια, την οικονομική προσιτότητα και τις λεπτομέρειες για τη βίζα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This month is one of the best times to visit based on weather, crowds, and overall conditions. Open the full country page to compare safety, affordability, and visa details."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este mes es uno de los mejores momentos para visitar segun el clima, las multitudes y las condiciones generales. Abre la pagina completa del pais para comparar seguridad, asequibilidad y detalles de visa."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tämä kuukausi on yksi parhaista ajoista vierailla sääolosuhteiden, väkijoukon ja yleisten olosuhteiden perusteella. Avaa koko maa-sivu vertaillaksesi turvallisuutta, edullisuutta ja viisumitietoja."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce mois-ci est l'un des meilleurs moments pour visiter selon la meteo, l'affluence et les conditions generales. Ouvrez la page complete du pays pour comparer securite, abordabilite et details de visa."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "החודש הזה הוא אחד הזמנים הטובים ביותר לבקר בהתבסס על מזג האוויר, ההמון והתנאים הכלליים. פתח את דף המדינה המלא כדי להשוות בטיחות, עלות ופרטי ויזה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मौसम, भीड़ और समग्र स्थितियों के आधार पर यह महीना यात्रा के लिए सबसे अच्छे समय में से एक है। सुरक्षा, सामर्थ्य और वीज़ा विवरण की तुलना करने के लिए पूरा देश पृष्ठ खोलें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ovaj mjesec je jedno od najboljih vremena za posjet s obzirom na vremenske uvjete, gužve i opće uvjete. Otvorite stranicu cijele zemlje kako biste usporedili sigurnost, pristupačnost i detalje o vizama."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ez a hónap az egyik legjobb időpont a látogatásra az időjárás, a tömeg és az általános feltételek alapján. Nyissa meg az egész ország oldalát, hogy összehasonlítsa a biztonságot, a megfizethetőséget és a vízum részleteit."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bulan ini adalah salah satu waktu terbaik untuk berkunjung berdasarkan cuaca, keramaian, dan kondisi keseluruhan. Buka halaman negara lengkap untuk membandingkan keamanan, keterjangkauan, dan detail visa."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo mese e uno dei momenti migliori per visitare in base a meteo, affollamento e condizioni generali. Apri la pagina completa del paese per confrontare sicurezza, convenienza e dettagli sul visto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この月は天候、混雑、全体的な条件に基づくと、訪れるのに最適な時期の一つです。安全性、費用、ビザの詳細を比較するには、国全体のページを開いてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 달은 날씨, 혼잡도 및 전반적인 조건을 기준으로 방문하기 가장 좋은 시기 중 하나입니다. 안전, 비용 및 비자 세부 정보를 비교하려면 국가 전체 페이지를 열어보세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bulan ini adalah salah satu masa terbaik untuk melawat berdasarkan cuaca, jumlah orang, dan keadaan keseluruhan. Buka halaman penuh negara untuk membandingkan keselamatan, kemampuan bayar, dan butiran visa."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne måneden er en av de beste tidene å besøke basert på vær, folkemengder og generelle forhold. Åpne hele landets side for å sammenligne sikkerhet, prisnivå og visumdetaljer."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze maand is een van de beste tijden om te bezoeken op basis van weer, drukte en algehele omstandigheden. Open de volledige landpagina om veiligheid, betaalbaarheid en visuminformatie te vergelijken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ten miesiąc jest jednym z najlepszych okresów na odwiedzenie ze względu na pogodę, tłumy i ogólne warunki. Otwórz pełną stronę kraju, aby porównać bezpieczeństwo, przystępność cenową i informacje o wizach."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este mes e um dos melhores para visitar com base no clima, nas multidoes e nas condicoes gerais. Abra a pagina completa do pais para comparar seguranca, custo e detalhes de visto."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Luna aceasta este una dintre cele mai bune perioade pentru a vizita, în funcție de vreme, mulțimi și condițiile generale. Deschide pagina completă a țării pentru a compara siguranța, accesibilitatea și detaliile privind viza."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Лучшее время"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tento mesiac je jedným z najlepších období na návštevu vzhľadom na počasie, dav a celkové podmienky. Otvorte celú stránku krajiny, aby ste porovnali bezpečnosť, cenovú dostupnosť a údaje o vízach."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den här månaden är en av de bästa tiderna att besöka baserat på väder, folkmassor och allmänna förhållanden. Öppna hela landssidan för att jämföra säkerhet, prisvärdhet och visumdetaljer."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เดือนนี้เป็นหนึ่งในช่วงเวลาที่ดีที่สุดในการเยี่ยมชมตามสภาพอากาศ ผู้คน และสภาพโดยรวม เปิดหน้าประเทศทั้งหมดเพื่อเปรียบเทียบความปลอดภัย ราคาที่เหมาะสม และรายละเอียดวีซ่า"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu ay, hava, kalabalık ve genel koşullar göz önüne alındığında ziyaret etmek için en iyi zamanlardan biridir. Güvenlik, uygun maliyet ve vize detaylarını karşılaştırmak için ülkenin tam sayfasını açın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Цей місяць є одним з найкращих часів для відвідування з огляду на погоду, натовпи та загальні умови. Відкрийте сторінку країни повністю, щоб порівняти безпеку, доступність та деталі щодо візи."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tháng này là một trong những thời điểm tốt nhất để tham quan dựa trên thời tiết, lượng khách và điều kiện tổng thể. Mở trang đầy đủ về quốc gia để so sánh về an toàn, chi phí và chi tiết về thị thực."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "根据天气、人群和整体情况，本月是访问的最佳时间之一。打开完整的国家页面以比较安全性、经济性和签证详情。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "根據天氣、人潮和整體狀況，本月是造訪的最佳時機之一。打開整個國家頁面以比較安全性、經濟性和簽證細節。"
          }
        }
      }
    },
