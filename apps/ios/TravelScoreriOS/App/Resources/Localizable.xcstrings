          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Malo by byť najviac užitočné v oblastiach s vysokou turistickou návštevnosťou, skôr než všade."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det borde vara mest användbart i områden med mycket turism snarare än överallt."
