    "planning.list_kind.visited.empty_description" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اضغط على تعديل لإضافة دول هنا، أو اسحب لليسار على دولة واضغط تم زيارتها."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca Edita per afegir països aquí, o llisca cap a l'esquerra sobre un país i toca Visitats."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klepněte na Upravit pro přidání zemí sem, nebo přejeďte prstem doleva po zemi a klepněte na Navštíveno."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryk på Rediger for at tilføje lande her, eller stryg til venstre på et land og tryk på Besøgt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe auf Bearbeiten, um hier Lander hinzuzufugen, oder wische bei einem Land nach links und tippe auf Besucht."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πατήστε Επεξεργασία για να προσθέσετε χώρες εδώ ή σύρετε αριστερά πάνω σε μια χώρα και πατήστε Επισκέφτηκε."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap Edit to add countries here, or swipe left on a country and tap Visited."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca Editar para agregar paises aqui, o desliza a la izquierda en un pais y toca Visitado."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Napauta Muokkaa lisätäksesi maita tänne, tai pyyhkäise maata vasemmalle ja napauta Käyty."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez Modifier pour ajouter des pays ici, ou balayez un pays vers la gauche et touchez Visite."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הקש על ערוך כדי להוסיף מדינות כאן, או החלק שמאלה על מדינה והקש על ביקרתי."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यहां देशों को जोड़ने के लिए संपादित करें पर टैप करें, या किसी देश पर बाईं ओर स्वाइप करें और विज़िट पर टैप करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodirnite Uredi da dodate zemlje ovdje, ili povucite ulijevo na zemlji i dodirnite Posjećeno."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Érintse meg a Szerkesztés gombot az országok hozzáadásához, vagy húzza balra az országon, majd érintse meg a Látogatott gombot."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ketuk Edit untuk menambahkan negara di sini, atau geser ke kiri pada suatu negara dan ketuk Dikunjungi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocca Modifica per aggiungere paesi qui oppure scorri a sinistra su un paese e tocca Visitato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "編集をタップしてここに国を追加するか、国を左にスワイプして「訪問済み」をタップしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "여기에 국가를 추가하려면 편집을 탭하거나, 국가에서 왼쪽으로 스와이프한 다음 방문함을 탭하세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ketik Edit untuk menambah negara di sini, atau leret ke kiri pada satu negara dan ketik Dilawati."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trykk på Rediger for å legge til land her, eller sveip til venstre på et land og trykk På besøkt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tik op Bewerken om hier landen toe te voegen, of veeg naar links op een land en tik op Bezocht."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stuknij Edytuj, aby dodać tutaj kraje, lub przesuń palcem w lewo po kraju i stuknij Odwiedzone."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque em Editar para adicionar paises aqui ou deslize para a esquerda em um pais e toque em Visitado."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atinge Editare pentru a adăuga țări aici sau glisează spre stânga pe o țară și atinge Vizitat."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отмечайте страны, в которых вы уже были."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klepnutím na Upraviť pridajte sem krajiny, alebo potiahnite krajinu doľava a klepnite na Navštívené."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryck på Redigera för att lägga till länder här, eller svep åt vänster på ett land och tryck på Besökt."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แตะ แก้ไข เพื่อเพิ่มประเทศที่นี่ หรือปัดซ้ายบนประเทศใดประเทศหนึ่งแล้วแตะ เยี่ยมชมแล้ว"
