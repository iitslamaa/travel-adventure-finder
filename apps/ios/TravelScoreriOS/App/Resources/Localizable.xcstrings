    "discovery.weights.subtitle" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الأوزان التي تختارها تحدد كيفية حساب درجات القدرة على السفر في التطبيق. يتم تحديث التصنيفات بعد الحفظ."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Els pesos que heu seleccionat determinen com es calculen les puntuacions de viatjabilitat a tota l'aplicació. Els rànquings s'actualitzen després de desar."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaše vybrané váhy určují, jak jsou v celé aplikaci vypočítávány skóre cestovatelnosti. Po uložení se aktualizují žebříčky."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dine valgte vægte bestemmer, hvordan rejsevenlighedsscorer beregnes i hele appen. Rangordninger opdateres, efter du har gemt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine ausgewahlten Gewichtungen bestimmen, wie Travelability Scores in der ganzen App berechnet werden. Die Ranglisten werden nach dem Speichern aktualisiert."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τα επιλεγμένα βάρη σας καθορίζουν πώς υπολογίζονται οι Βαθμολογίες Ταξιδιμότητας σε όλη την εφαρμογή. Οι κατατάξεις ενημερώνονται μετά την αποθήκευση."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your selected weights determine how Travelability Scores are calculated throughout the app. Rankings update after you save."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus pesos seleccionados determinan como se calculan los Travelability Scores en toda la app. Las clasificaciones se actualizan despues de guardar."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valitsemasi painot määräävät, miten matkustuskelpoisuuspisteet lasketaan sovelluksessa. Järjestykset päivittyvät, kun tallennat."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les ponderations selectionnees determinent comment les Travelability Scores sont calcules dans l'application. Les classements se mettent a jour apres enregistrement."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "המשקלים שבחרת קובעים כיצד מחושבים ציוני הנסיעה באפליקציה. הדירוגים יתעדכנו לאחר שתשמור."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपके चयनित वज़न यह निर्धारित करते हैं कि पूरे ऐप में ट्रैवलेबिलिटी स्कोर की गणना कैसे की जाती है। आपके सेव करने के बाद रैंकिंग अपडेट हो जाती है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odabrane težine određuju kako se bodovi putne sposobnosti izračunavaju u cijeloj aplikaciji. Rangiranje se ažurira nakon što spremite."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A kiválasztott súlyok határozzák meg, hogyan számítódnak a Travelability pontszámok az alkalmazásban. A rangsorok frissülnek, miután mentettél."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Berat yang Anda pilih menentukan bagaimana Skor Kelayakan Perjalanan dihitung di seluruh aplikasi. Peringkat diperbarui setelah Anda menyimpan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I pesi selezionati determinano come i Travelability Scores vengono calcolati nell'app. Le classifiche si aggiornano dopo il salvataggio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選択した重みは、アプリ全体でトラベラビリティスコアがどのように計算されるかを決定します。保存後にランキングが更新されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "선택한 가중치는 앱 전체에서 여행 가능 점수가 계산되는 방식을 결정합니다. 저장하면 순위가 업데이트됩니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Berat yang anda pilih menentukan bagaimana Skor Kebolehperjalanan dikira di seluruh aplikasi. Kedudukan dikemas kini selepas anda menyimpan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dine valgte vekter bestemmer hvordan reisebarhetspoeng beregnes gjennom hele appen. Rangeringer oppdateres etter at du lagrer."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uw geselecteerde gewichten bepalen hoe Reisbaarheidsscores in de hele app worden berekend. Ranglijsten worden bijgewerkt nadat u opslaat."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wybrane przez Ciebie wagi określają, jak obliczane są wyniki podróży w całej aplikacji. Rankingi aktualizują się po zapisaniu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os pesos selecionados determinam como as Travelability Scores sao calculadas em todo o aplicativo. As classificacoes sao atualizadas depois que voce salva."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Greutățile selectate de tine determină modul în care sunt calculate scorurile de călătorie în aplicație. Clasamentele se actualizează după ce salvezi."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Настройте, как рассчитывается общий балл"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaše vybrané váhy určujú, ako sa budú vypočítavať skóre cestovateľnosti v celej aplikácii. Poradie sa aktualizuje po uložení."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dina valda vikter avgör hur Resbarhetspoäng beräknas i hela appen. Rankningarna uppdateras efter att du sparat."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "น้ำหนักที่คุณเลือกจะกำหนดวิธีการคำนวณคะแนนการเดินทางทั่วทั้งแอป การจัดอันดับจะอัปเดตหลังจากที่คุณบันทึก"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seçtiğiniz ağırlıklar, uygulama genelinde Gezi Skorlarının nasıl hesaplandığını belirler. Kaydettikten sonra sıralamalar güncellenir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Обрані вами ваги визначають, як обчислюються оцінки подорожуваності у додатку. Рейтинги оновлюються після збереження."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các trọng số bạn chọn xác định cách Điểm Khả năng Du lịch được tính toán trong toàn bộ ứng dụng. Xếp hạng sẽ được cập nhật sau khi bạn lưu."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您选择的权重决定了整个应用中旅行能力得分的计算方式。保存后排名会更新。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您所選擇的權重決定了整個應用程式中旅行度分數的計算方式。儲存後排名會更新。"
          }
        }
      }
    },
