    "seasonality.section.shoulder.note" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حل وسط متوازن. قد تتنازل عن الطقس المثالي مقابل حشود أقل، أو أسعار أقل، أو رحلة أكثر مرونة."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un punt mitjà equilibrat. Pots canviar una mica del temps ideal per menys aglomeració, preus més baixos o un viatge més flexible."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vyvážená zlatá střední cesta. Můžete obětovat část ideálního počasí výměnou za menší davy, nižší ceny nebo flexibilnější cestu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En afbalanceret mellemvej. Du kan bytte noget ideelt vejr for lettere folkemængder, lavere priser eller en mere fleksibel rejse."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein ausgewogenes Mittelmaß. Sie können etwas ideales Wetter gegen geringere Menschenmengen, niedrigere Preise oder eine flexiblere Reise eintauschen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ένα ισορροπημένο μέσο δρόμο. Μπορείτε να θυσιάσετε λίγο από τον ιδανικό καιρό για λιγότερους ανθρώπους, χαμηλότερες τιμές ή ένα πιο ευέλικτο ταξίδι."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A balanced middle ground. You may trade some ideal weather for lighter crowds, lower prices, or a more flexible trip."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un punto medio equilibrado. Puede que cambie algo del clima ideal por menos multitudes, precios más bajos o un viaje más flexible."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tasapainoinen keskitie. Voit vaihtaa osan ihanteellisesta säästä kevyempiin väkijoukkoihin, alhaisempiin hintoihin tai joustavampaan matkaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un juste milieu équilibré. Vous pouvez échanger un temps idéal contre des foules plus légères, des prix plus bas ou un voyage plus flexible."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "איזון מאוזן. אתה עשוי לוותר על מזג אוויר אידיאלי תמורת פחות עומס, מחירים נמוכים יותר או טיול גמיש יותר."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एक संतुलित मध्य मार्ग। आप हल्की भीड़, कम कीमतों, या अधिक लचीली यात्रा के लिए कुछ आदर्श मौसम का आदान-प्रदान कर सकते हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uravnotežena sredina. Možda ćete žrtvovati savršeno vrijeme za rjeđe gužve, niže cijene ili fleksibilnije putovanje."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Egy kiegyensúlyozott középút. Kihagyhat némi ideális időjárást a könnyebb tömegért, alacsonyabb árakért vagy rugalmasabb utazásért."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sebuah keseimbangan yang ideal. Anda mungkin menukar cuaca yang ideal dengan keramaian yang lebih sedikit, harga yang lebih rendah, atau perjalanan yang lebih fleksibel."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un equilibrio ragionevole. Potresti scambiare qualche condizione meteo ideale per folle più leggere, prezzi più bassi o un viaggio più flessibile."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バランスの取れた中庸。理想的な天気の一部を、人混みの少なさ、低価格、あるいはより柔軟な旅行と交換することができます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "균형 잡힌 중간 지점. 날씨는 이상적이지 않을 수 있지만, 대신 덜 붐비는 인파, 낮은 가격 또는 더 유연한 여행을 선택할 수 있습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Satu jalan tengah yang seimbang. Anda mungkin menukar sedikit cuaca yang ideal untuk kurang ramai pengunjung, harga yang lebih rendah, atau perjalanan yang lebih fleksibel."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Et balansert midtpunkt. Du kan bytte noe ideelt vær mot lettere folkemengder, lavere priser eller en mer fleksibel reise."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een evenwichtige middenweg. Je kunt wat ideaal weer inruilen voor lichtere drukte, lagere prijzen of een flexibelere reis."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zrównoważony kompromis. Możesz poświęcić idealną pogodę na rzecz mniejszego tłoku, niższych cen lub bardziej elastycznej podróży."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um meio-termo equilibrado. Você pode trocar um clima ideal por multidões menores, preços mais baixos ou uma viagem mais flexível."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un echilibru rezonabil. Poți renunța la vremea ideală în schimbul unor mulțimi mai mici, prețuri mai scăzute sau o călătorie mai flexibilă."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сбалансированный компромисс. Вы можете обменять идеальную погоду на меньшее количество людей, более низкие цены или большую гибкость поездки."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vyvážená stredná cesta. Môžete obetovať ideálne počasie výmenou za menšie davy, nižšie ceny alebo flexibilnejšiu cestu."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En balanserad mellanväg. Du kan byta lite idealiskt väder mot lättare folkmassor, lägre priser eller en mer flexibel resa."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "พื้นกลางที่สมดุล คุณอาจแลกเปลี่ยนสภาพอากาศในอุดมคติกับผู้คนจำนวนไม่มาก ราคาที่ต่ำกว่า หรือการเดินทางที่ยืดหยุ่นมากขึ้น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dengeli bir orta yol. Daha ideal havayı biraz ödün verip daha az kalabalık, daha düşük fiyatlar veya daha esnek bir geziyle değiştirebilirsiniz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Збалансований середній варіант. Ви можете пожертвувати частково ідеальною погодою заради меншої кількості людей, нижчих цін або більш гнучкої поїздки."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Một sự cân bằng hợp lý. Bạn có thể đánh đổi một phần thời tiết lý tưởng để có ít đám đông hơn, giá cả thấp hơn, hoặc một chuyến đi linh hoạt hơn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一个平衡的中间地带。你可能会为了更少的人群、更低的价格或更灵活的行程而牺牲一些理想的天气。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "平衡的中間地帶。您可能會為了較少的人潮、更低的價格或更靈活的行程，而犧牲一些理想的天氣。"
          }
        }
      }
    },
