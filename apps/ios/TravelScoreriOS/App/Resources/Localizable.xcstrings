    "trip_planner.expenses.split_guidance.accommodation" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "جيد للفنادق أو الإقامات التي عادةً ما يتم تقسيمها بين الأشخاص المشاركين فيها."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bé per a hotels o estades que normalment es divideixen entre les persones que les comparteixen."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dobré pro hotely nebo pobyty, které se obvykle dělí mezi lidi, kteří je sdílejí."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Godt for hoteller eller ophold, der normalt bliver delt mellem de personer, der deler dem."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gut für Hotels oder Aufenthalte, die normalerweise auf die Personen, die sie teilen, aufgeteilt werden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κατάλληλο για ξενοδοχεία ή διαμονές που συνήθως μοιράζονται μεταξύ των ανθρώπων που τις χρησιμοποιούν."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Good for hotels or stays that usually get split across the people sharing them."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bueno para hoteles o estancias que generalmente se dividen entre las personas que los comparten."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hyvä hotelleille tai majoituksille, jotka yleensä jaetaan niiden kesken, jotka niitä jakavat."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bon pour les hôtels ou les séjours qui sont généralement partagés entre les personnes qui les occupent."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "טוב לבתי מלון או לשהיות שלרוב מתחלקות בין האנשים החולקים אותן."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अच्छा उन होटलों या ठहराव के लिए जो आमतौर पर उन लोगों में बांटे जाते हैं जो उनका साझा उपयोग करते हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dobar za hotele ili boravke koji se obično dijele među osobama koje ih dijele."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jó hotelekhez vagy tartózkodásokhoz, amelyeket általában az azt megosztó emberek között osztanak fel."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bagus untuk hotel atau akomodasi yang biasanya dibagi di antara orang-orang yang menempatinya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buono per hotel o soggiorni che di solito vengono divisi tra le persone che li condividono."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通常、共有する人たちで費用を分けるホテルや滞在に適しています。"
