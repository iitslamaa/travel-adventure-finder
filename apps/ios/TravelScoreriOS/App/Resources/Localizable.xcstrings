    "trip_planner.itinerary.day_by_day_subtitle" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختر البلد لكل يوم، أو ضع علامة على يوم كرحلة حتى تعكس تكاليف الرحلة مسارك الفعلي."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tria el país per a cada dia, o marca un dia com a viatge perquè els costos del viatge reflecteixin la teva ruta real."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vyberte zemi pro každý den, nebo označte den jako cestování, aby náklady na cestu odpovídaly vašemu skutečnému trasování."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vælg landet for hver dag, eller marker en dag som rejse, så rejseomkostningerne afspejler din faktiske rute."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wahle fur jeden Tag das Land aus oder markiere einen Tag als Reisetag, damit die Kosten die tatsachliche Route widerspiegeln."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Επιλέξτε τη χώρα για κάθε ημέρα ή επισημάνετε μια ημέρα ως ταξίδι ώστε τα έξοδα του ταξιδιού να αντικατοπτρίζουν τη πραγματική σας διαδρομή."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose the country for each day, or mark a day as travel so trip costs reflect your actual routing."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige el pais para cada dia o marca un dia como traslado para que los costos reflejen tu ruta real."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valitse maa jokaiselle päivälle, tai merkitse päivä matkaksi, jotta matkan kustannukset heijastavat todellista reittivalintaasi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez le pays pour chaque jour, ou marquez un jour comme trajet pour que les couts du voyage refletent votre vrai parcours."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "בחר את המדינה לכל יום, או סמן יום כטיול כך שעלות הטיול תתאים למסלול האמיתי שלך."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "प्रत्येक दिन के लिए देश चुनें, या किसी दिन को यात्रा के रूप में चिह्नित करें ताकि यात्रा की लागत आपकी वास्तविक मार्ग योजना को दर्शाए।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odaberite zemlju za svaki dan, ili označite dan kao putovanje kako bi troškovi putovanja odražavali vašu stvarnu rutu."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Válassza ki az országot minden napra, vagy jelöljön meg egy napot utazásként, hogy az utazási költségek tükrözzék a tényleges útvonalát."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pilih negara untuk setiap hari, atau tandai satu hari sebagai hari perjalanan sehingga biaya perjalanan mencerminkan rute Anda yang sebenarnya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli il paese per ogni giorno oppure segna un giorno come viaggio, cosi i costi riflettono il percorso reale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "各日の国を選ぶか、または1日を移動日としてマークして、旅行費用が実際のルートを反映するようにしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "각 날짜마다 국가를 선택하거나 여행일로 표시하여 실제 경로에 맞게 여행 비용을 반영하세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pilih negara untuk setiap hari, atau tandakan satu hari sebagai perjalanan supaya kos perjalanan mencerminkan laluan sebenar anda."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velg landet for hver dag, eller merk en dag som reise slik at turkostnadene gjenspeiler din faktiske rute."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kies het land voor elke dag, of markeer een dag als reisdag zodat de reiskosten uw werkelijke route weerspiegelen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wybierz kraj na każdy dzień lub oznacz dzień jako podróż, aby koszty wycieczki odzwierciedlały rzeczywistą trasę."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha o pais para cada dia ou marque um dia como deslocamento para que os custos reflitam sua rota real."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alegeți țara pentru fiecare zi sau marcați o zi ca zi de călătorie astfel încât costurile călătoriei să reflecte ruta dvs. reală."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выберите страну для каждого дня или отметьте день как дорогу, чтобы расходы на поездку отражали ваш реальный маршрут."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vyberte krajinu pre každý deň alebo označte deň ako cestovanie, aby náklady na výlet zodpovedali vášmu skutočnému itineráru."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Välj landet för varje dag, eller markera en dag som resa så att reskostnaderna speglar din faktiska rutt."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เลือกประเทศสำหรับแต่ละวัน หรือทำเครื่องหมายวันหนึ่งเป็นวันเดินทางเพื่อให้ค่าใช้จ่ายทริปสะท้อนเส้นทางจริงของคุณ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her gün için bir ülke seçin veya bir günü seyahat günü olarak işaretleyin, böylece seyahat maliyetleri gerçek rotanızı yansıtır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Виберіть країну для кожного дня або позначте день як день подорожі, щоб витрати на поїздку відображали ваш фактичний маршрут."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chọn quốc gia cho mỗi ngày, hoặc đánh dấu một ngày là đi du lịch để chi phí chuyến đi phản ánh tuyến đường thực tế của bạn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "为每一天选择国家，或者将某一天标记为旅行，以便旅行费用反映您的实际路线。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "為每一天選擇國家，或將某一天標記為旅行，以便行程費用反映您的實際路線。"
          }
        }
      }
    },
