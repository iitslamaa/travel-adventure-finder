    "seasonality.section.good.note" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "شهر قوي لمواكبة الظروف الموثوقة، لكنه عادة أقل كمالًا قليلًا من أفضل فترة مثالية مطلقة."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mes fort per anar-hi amb condicions fiables, però normalment una mica menys perfecte que la millor finestra absoluta."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silný měsíc s možností spolehlivých podmínek, ale obvykle o něco méně dokonalý než absolutně nejlepší období."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stærk måned at vælge med pålidelige forhold, men normalt lidt mindre perfekt end det absolut bedste vindue."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starker Monat mit verlässlichen Bedingungen, aber normalerweise etwas weniger perfekt als das absolut beste Zeitfenster."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ισχυρός μήνας να πάει με αξιόπιστες συνθήκες, αλλά συνήθως λίγος λιγότερο τέλειος από το απόλυτα καλύτερο παράθυρο."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Strong month to go with reliable conditions, but usually a little less perfect than the absolute best window."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mes fuerte para ir con condiciones confiables, pero usualmente un poco menos perfecto que la ventana absolutamente mejor."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vahva kuukausi luotettavien olosuhteiden kanssa, mutta yleensä hieman vähemmän täydellinen kuin absoluuttisesti paras ajankohta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mois fort avec des conditions fiables, mais généralement un peu moins parfait que la fenêtre absolument idéale."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "חודש חזק ללכת עם תנאים אמינים, אבל בדרך כלל קצת פחות מושלם מהחלון הטוב ביותר האבסולוטי."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "विश्वसनीय परिस्थितियों के साथ जाने के लिए मजबूत महीना, लेकिन आम तौर पर यह बिल्कुल सर्वोत्तम समय से थोड़ा कम आदर्श होता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Snažan mjesec s pouzdanim uvjetima, ali obično malo manje savršen od apsolutno najboljeg razdoblja."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erős hónap megbízható feltételekkel, de általában kicsit kevésbé tökéletes, mint a legjobb időszak."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bulan yang kuat untuk pergi dengan kondisi yang dapat diandalkan, tetapi biasanya sedikit kurang sempurna daripada jendela terbaik."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mese forte da affrontare con condizioni affidabili, ma di solito un po' meno perfetto rispetto alla finestra assolutamente migliore."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "信頼できる条件と共に過ごすのに強い月ですが、通常は絶対に最高の期間より少し完璧さに欠けます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "신뢰할 수 있는 조건과 함께하기에 강한 달이지만, 보통 절대적으로 가장 좋은 시기보다는 조금 덜 완벽합니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bulan yang kuat dengan keadaan yang boleh dipercayai, tetapi biasanya sedikit kurang sempurna daripada jendela terbaik mutlak."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sterk måned å gå med pålitelige forhold, men vanligvis litt mindre perfekt enn det absolutt beste vinduet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sterke maand om mee te gaan met betrouwbare omstandigheden, maar meestal iets minder perfect dan het absolute beste venster."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silny miesiąc z wiarygodnymi warunkami, ale zwykle nieco mniej idealny niż absolutnie najlepsze okno."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mês forte para ir com condições confiáveis, mas geralmente um pouco menos perfeito do que a janela absoluta ideal."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lună puternică cu condiții fiabile, dar de obicei puțin mai puțin perfectă decât fereastra absolut cea mai bună."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сильный месяц с надежными условиями, но обычно немного менее идеальный, чем абсолютно лучший период."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silný mesiac s spoľahlivými podmienkami, ale obyčajne o niečo menej dokonalý ako absolútne najlepšie obdobie."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stark månad att välja med pålitliga förhållanden, men vanligtvis lite mindre perfekt än det absolut bästa fönstret."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เดือนที่แข็งแกร่งพร้อมเงื่อนไขที่เชื่อถือได้ แต่มักจะสมบูรณ์แบบน้อยกว่าหน้าต่างที่ดีที่สุดเล็กน้อย"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Güvenilir koşullarla gitmek için güçlü bir ay, ama genellikle mutlak en iyi pencerenin biraz daha az mükemmeldir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сильний місяць з надійними умовами, але зазвичай трохи менш ідеальний, ніж абсолютно найкращий період."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tháng mạnh mẽ sẽ đi với các điều kiện đáng tin cậy, nhưng thường kém hoàn hảo hơn một chút so với thời điểm tốt nhất."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这是一个强劲的月份，条件可靠，但通常比绝对最佳时期稍微不那么完美。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這是一個條件可靠的強月份，但通常比絕佳時機稍微不那麼完美。"
          }
        }
      }
    },
