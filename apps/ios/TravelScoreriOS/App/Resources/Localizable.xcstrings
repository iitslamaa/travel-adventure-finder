    "trip_planner.visa.traveler_overstay_summary_format" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قد يتجاوز %@ مدة الإقامة المسموح بها في %@ %@ على جواز سفرهم المحفوظ بأفضل حال (%@): حوالي %lld يومًا مسموح بها لرحلة مدتها %lld يومًا."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ podria excedir l’estada permesa a %@ %@ amb el seu passaport millor guardat (%@): aproximadament %lld dia(es) permesos per a un viatge de %lld dies."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ může překročit povolený pobyt v %@ %@ na svém nejlépe uloženém pasu (%@): povoleno asi %lld den(ů) pro %llddenní cestu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ kan overskride den tilladte opholdstid i %@ %@ på deres bedst gemte pas (%@): cirka %lld dag(e) tilladt for en %lld-dages rejse."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ könnte den erlaubten Aufenthalt in %@ %@ mit dem besten gespeicherten Pass (%@) überschreiten: etwa %lld Tag(e) erlaubt fur eine Reise von %lld Tagen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ο %@ ενδέχεται να υπερβεί τη μέγιστη διάρκεια διαμονής στο %@ %@ με το καλύτερα διατηρημένο διαβατήριό του (%@): περίπου %lld ημέρες επιτρέπονται για ένα ταξίδι %lld ημερών."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ may exceed the allowed stay in %@ %@ on their best saved passport (%@): about %lld day(s) allowed for a %lld-day trip."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ podria exceder la estancia permitida en %@ %@ con su mejor pasaporte guardado (%@): alrededor de %lld dia(s) permitidos para un viaje de %lld dias."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ saattaa ylittää sallittua oleskeluaikaa %@ %@ parhaalla tallennetulla passillaan (%@): noin %lld päivää sallittu %lld päivän matkalle."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld voyageur(s) pourraient depasser la duree de sejour autorisee."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ עלול לחרוג מהשהייה המותרת ב-%@ %@ עם הדרכון הטוב ביותר שנשמר (%@): כ-%lld יום(ים) מותר עבור טיול של %lld יום."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ %@ %@ में अपने सबसे अच्छे सुरक्षित पासपोर्ट (%@) पर अनुमत प्रवास से अधिक रह सकते हैं: %lld-दिन की यात्रा के लिए लगभग %lld दिन अनुमति है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ može premašiti dopušteni boravak u %@ %@ na svom najbolje spremljenom putovnici (%@): oko %lld dana dopušteno za putovanje od %lld dana."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ meghaladhatja a megengedett tartózkodást %@ %@ a legjobban elmentett útlevelén (%@): kb. %lld nap engedélyezett egy %lld napos utazáshoz."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ mungkin melebihi masa tinggal yang diizinkan di %@ %@ dengan paspor terbaik yang disimpan (%@): sekitar %lld hari diizinkan untuk perjalanan selama %lld hari."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ potrebbe superare il soggiorno consentito in %@ %@ con il miglior passaporto salvato (%@): circa %lld giorno(i) consentiti per un viaggio di %lld giorni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ は、最もよく保存されたパスポート（%@）で %@ %@ に許可された滞在日数を超える可能性があります：%lld日間の旅行に対して約 %lld 日が許可されています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@는(은) 최고로 잘 보관된 여권(%@)으로 %@ %@에서 허용된 체류를 초과할 수 있습니다: %lld일 여행에 대하여 약 %lld일 허용됩니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ mungkin melebihi tempoh tinggal yang dibenarkan di %@ %@ dengan pasport terbaik yang disimpan (%@): kira-kira %lld hari dibenarkan untuk perjalanan %lld hari."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ kan overskride tillatt opphold i %@ %@ på deres best lagrede pass (%@): omtrent %lld dag(er) tillatt for en %lld-dagers tur."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ kan het toegestane verblijf in %@ %@ overschrijden met hun best bewaarde paspoort (%@): ongeveer %lld dag(en) toegestaan voor een reis van %lld dagen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ może przekroczyć dozwolony pobyt w %@ %@ na swoim najlepiej zachowanym paszporcie (%@): do około %lld dnia/dni dozwolone na podróż trwającą %lld dni."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ pode ultrapassar a permanencia permitida em %@ %@ com seu melhor passaporte salvo (%@): cerca de %lld dia(s) permitidos para uma viagem de %lld dias."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ poate depăși șederea permisă în %@ %@ pe cel mai bine păstrat pașaport (%@): aproximativ %lld zi(e) permisă pentru o călătorie de %lld zile."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ может превысить разрешенный срок пребывания в %@ %@ по своему лучшему сохраненному паспорту (%@): разрешено около %lld дней для поездки длительностью %lld дней."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ môže prekročiť povolený pobyt v %@ %@ na svojom najlepšie uloženom pase (%@): povolené približne %lld dní na %lld-dňovú cestu."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ kan överskrida den tillåtna vistelsen i %@ %@ på deras bäst sparade pass (%@): cirka %lld dag(ar) tillåtna för en %lld-dagars resa."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ อาจเกินระยะเวลาที่อนุญาตใน %@ %@ บนหนังสือเดินทางที่บันทึกดีที่สุดของพวกเขา (%@): ประมาณ %@ วันที่อนุญาตสำหรับการเดินทาง %@ วัน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, en iyi kaydedilmiş pasaportlarıyla %@ %@’da izin verilen kalış süresini aşabilir (%@): %lld günlük bir gezi için yaklaşık %lld gün izin verilmiştir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ може перевищити дозволене перебування в %@ %@ за своїм найкраще збереженим паспортом (%@): приблизно %lld день(днів) дозволено для подорожі тривалістю %lld днів."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ có thể ở quá thời gian cho phép tại %@ %@ trên hộ chiếu được lưu giữ tốt nhất của họ (%@): khoảng %lld ngày được phép cho chuyến đi %lld ngày."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 可能会在 %@ %@ 上超过其最佳保存护照（%@）允许的停留时间：一趟 %lld 天的旅行允许大约 %lld 天。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 可能會超過在 %@ %@ 的最長停留期限，依其最佳保存的護照（%@）：約允許 %lld 天停留於 %lld 天的行程。"
          }
        }
      }
    },
