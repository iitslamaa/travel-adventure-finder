    "trip_planner.detail.availability_group_subtitle" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قارن متى يكون الجميع متاحًا وحدد أفضل فترة."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compara quan tothom és lliure i fixa la millor franja horària."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Porovnejte, kdy má každý volno, a zarezervujte nejlepší časový úsek."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sammenlign, hvornår alle er ledige, og fastlæg det bedste tidspunkt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vergleicht, wann alle frei sind, und legt das beste Zeitfenster fest."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Σύγκρινε πότε είναι όλοι ελεύθεροι και κλείδωσε το καλύτερο παράθυρο."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compare when everyone is free and lock in the best window."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compara cuando todos estan libres y fija la mejor ventana."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vertaile, milloin kaikki ovat vapaita, ja lukitse paras ajankohta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comparez les disponibilites de chacun et fixez la meilleure periode."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "השווה מתי כולם פנויים ונעול את החלון הטוב ביותר."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सभी के फ्री होने पर तुलना करें और सबसे अच्छा समय तय करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usporedite kada su svi slobodni i odaberite najbolje vrijeme."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hasonlítsd össze, mikor van mindenkinek szabadideje, és rögzítsd a legjobb időablakot."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bandingkan ketika semua orang bebas dan kunci jendela terbaik."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Confronta quando tutti sono liberi e blocca la finestra migliore."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "みんながいつ空いているかを比較して、最適な時間帯を決めて確定する。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모두가 자유로운 시간을 비교하고 가장 좋은 시간대를 고정하세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bandingkan bila semua orang bebas dan tetapkan tingkap terbaik."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sammenlign når alle er ledige og lås inn den beste tiden."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vergelijk wanneer iedereen vrij is en blokkeer het beste tijdvak."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Porównaj, kiedy wszyscy są wolni i zarezerwuj najlepszy termin."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compare quando todos estao livres e encontre a melhor janela."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compară când toată lumea este liberă și blochează cea mai bună fereastră."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сравните, когда все свободны, и закрепите лучшее окно."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Porovnajte, kedy má každý voľno, a zafixujte najlepší časový úsek."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jämför när alla är lediga och lås fast det bästa tiden."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เปรียบเทียบเมื่อทุกคนว่างและกำหนดเวลาที่ดีที่สุด"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Herkesin ne zaman uygun olduğunu karşılaştırın ve en iyi zamanı kilitleyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Порівняйте, коли всі вільні, і забронюйте найкращий час."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "So sánh khi mọi người rảnh và khóa cửa sổ tốt nhất."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "比较大家什么时候有空，然后确定最佳时间段。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "比較大家何時有空，並鎖定最佳時段。"
          }
        }
      }
    },
