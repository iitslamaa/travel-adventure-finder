    "trip_planner.packing.liquids_hint" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تطبق معظم المطارات حدًا أقصى قدره 100 مل / 3.4 أونصة من السوائل المحمولة، لكن القواعد يمكن أن تختلف حسب المطار والبلد وشركة الطيران. تحقق من المتطلبات قبل السفر، وضع سوائل أكبر في الأمتعة المسجلة عند الحاجة."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La majoria d’aeroports apliquen un límit de líquids de 100 mL / 3,4 oz per a l’equipatge de mà, però les normes poden variar segons l’aeroport, el país i la companyia aèria. Comproveu els requisits abans de volar i col·loqueu els líquids més grans en l’equipatge facturat si cal."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Většina letišť uplatňuje limit na tekutiny v příručním zavazadle 100 ml / 3,4 oz, ale pravidla se mohou lišit podle letiště, země a letecké společnosti. Před letem si ověřte požadavky a větší množství tekutin vložte do odbaveného zavazadla, pokud je to potřeba."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De fleste lufthavne anvender en grænse på 100 ml / 3,4 oz for væsker i håndbagage, men reglerne kan variere afhængigt af lufthavn, land og flyselskab. Tjek kravene, før du flyver, og læg større væsker i indtjekket bagage, når det er nødvendigt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die meisten Flughäfen wenden ein Handgepäck- Flüssigkeitslimit von 100 ml / 3,4 oz an, aber die Regeln können je nach Flughafen, Land und Fluggesellschaft variieren. Überprüfen Sie die Anforderungen, bevor Sie fliegen, und legen Sie größere Flüssigkeiten bei Bedarf in das Aufgabegepäck."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τα περισσότερα αεροδρόμια εφαρμόζουν όριο 100 mL / 3,4 ουγκιές για υγρά στο χειραποσκευές, αλλά οι κανόνες μπορεί να διαφέρουν ανά αεροδρόμιο, χώρα και αεροπορική εταιρεία. Ελέγξτε τις απαιτήσεις πριν πετάξετε και τοποθετήστε μεγαλύτερα υγρά στις ελεγμένες αποσκευές όταν χρειάζεται."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Most airports apply a 100 mL / 3.4 oz carry-on liquid limit, but rules can vary by airport, country, and airline. Check requirements before you fly, and place larger liquids in checked baggage when needed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La mayoría de los aeropuertos aplican un límite de líquidos de 100 mL / 3,4 oz en el equipaje de mano, pero las normas pueden variar según el aeropuerto, el país y la aerolínea. Verifique los requisitos antes de volar y coloque líquidos más grandes en el equipaje facturado cuando sea necesario."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Useimmat lentokentät soveltavat 100 ml / 3,4 oz käsimatkatavarassa sallittujen nesteiden rajoitusta, mutta säännöt voivat vaihdella lentokentän, maan ja lentoyhtiön mukaan. Tarkista vaatimukset ennen lentoa ja laita tarvittaessa suuremmat nesteet ruumaan menevään matkatavaraan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La plupart des aéroports appliquent une limite de 100 mL / 3,4 oz pour les liquides en cabine, mais les règles peuvent varier selon l'aéroport, le pays et la compagnie aérienne. Vérifiez les exigences avant de voler et placez les liquides plus volumineux dans les bagages enregistrés si nécessaire."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "רוב שדות התעופה מטילים מגבלת נוזלים של 100 מ\"ל / 3.4 אונקיות למטען, אך הכללים יכולים להשתנות בין נמל תעופה, מדינה וחברת תעופה. בדוק את הדרישות לפני הטיסה, והניח נוזלים גדולים יותר במזוודות שנשלחות בעת הצורך."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ज्यादातर हवाई अड्डे 100 mL / 3.4 oz कैरी-ऑन तरल सीमा लागू करते हैं, लेकिन नियम हवाई अड्डे, देश और एयरलाइन के अनुसार अलग हो सकते हैं। उड़ान भरने से पहले आवश्यकताओं की जाँच करें, और आवश्यकता होने पर बड़े तरलों को चेक किए गए सामान में रखें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Većina zračnih luka primjenjuje ograničenje tekućina u ručnoj prtljazi od 100 mL / 3,4 oz, ali pravila se mogu razlikovati ovisno o zračnoj luci, zemlji i zrakoplovnoj kompaniji. Provjerite zahtjeve prije putovanja i stavite veće količine tekućina u prijavljenu prtljagu kad je potrebno."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A legtöbb repülőtér mostanra 100 ml / 3,4 oz kézipoggyász folyadékkorlátozást alkalmaz, de a szabályok repülőtérenként, országonként és légitársaságonként eltérhetnek. Ellenőrizze a követelményeket a repülés előtt, és a szükséges esetben helyezze a nagyobb folyadékokat a feladott poggyászba."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kebanyakan bandara menerapkan batas cairan dalam bagasi kabin sebesar 100 mL / 3,4 oz, tetapi aturan dapat bervariasi menurut bandara, negara, dan maskapai. Periksa persyaratan sebelum Anda terbang, dan letakkan cairan yang lebih besar dalam bagasi tercatat jika diperlukan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La maggior parte degli aeroporti applica un limite di liquidi per il bagaglio a mano di 100 mL / 3,4 oz, ma le regole possono variare a seconda dell'aeroporto, del paese e della compagnia aerea. Controlla i requisiti prima di volare e metti i liquidi più grandi nel bagaglio da stiva quando necessario."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ほとんどの空港では手荷物の液体持ち込み制限が100 mL / 3.4 ozですが、空港、国、航空会社によってルールは異なる場合があります。飛行前に要件を確認し、必要に応じて大きな液体は預け荷物に入れてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "대부분의 공항은 100mL / 3.4oz 기내 액체 제한을 적용하지만, 규정은 공항, 국가, 항공사에 따라 달라질 수 있습니다. 비행 전에 요구 사항을 확인하고, 필요할 경우 더 큰 액체는 수하물에 넣으세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kebanyakan lapangan terbang mengenakan had cecair untuk dibawa dalam pesawat sebanyak 100 mL / 3.4 oz, tetapi peraturan boleh berbeza mengikut lapangan terbang, negara, dan syarikat penerbangan. Semak keperluan sebelum anda terbang, dan letakkan cecair yang lebih besar dalam bagasi daftar masuk jika perlu."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De fleste flyplasser bruker en grense på 100 ml / 3,4 oz for væsker i håndbagasjen, men reglene kan variere mellom flyplasser, land og flyselskaper. Sjekk kravene før du flyr, og legg større væsker i innsjekket bagasje når det er nødvendig."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De meeste luchthavens hanteren een limiet van 100 ml/3,4 oz handbagagevloeistof, maar de regels kunnen per luchthaven, land en luchtvaartmaatschappij verschillen. Controleer de vereisten voordat u vliegt en plaats indien nodig grotere vloeistoffen in ingecheckte bagage."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Większość lotnisk stosuje limit płynów w bagażu podręcznym wynoszący 100 ml / 3,4 oz, ale zasady mogą się różnić w zależności od lotniska, kraju i linii lotniczej. Sprawdź wymagania przed lotem i umieść większe ilości płynów w bagażu rejestrowanym, jeśli to konieczne."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A maioria dos aeroportos aplica um limite de líquidos de 100 mL / 3,4 oz para bagagem de mão, mas as regras podem variar dependendo do aeroporto, país e companhia aérea. Verifique os requisitos antes de voar e coloque líquidos maiores na bagagem despachada quando necessário."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Majoritatea aeroporturilor aplică o limită de 100 mL / 3,4 oz pentru lichidele din bagajul de mână, dar regulile pot varia în funcție de aeroport, țară și companie aeriană. Verifică cerințele înainte de a zbura și pune lichidele mai mari în bagajul de cală atunci când este necesar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Большинство аэропортов устанавливают ограничение на ручную кладь по жидкостям в 100 мл / 3,4 унции, но правила могут различаться в зависимости от аэропорта, страны и авиакомпании. Уточняйте требования перед полетом и помещайте большие объемы жидкостей в сдаваемый багаж по мере необходимости."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Väčšina letísk uplatňuje limit na tekutiny v príručnej batožine 100 ml / 3,4 oz, ale pravidlá sa môžu líšiť podľa letiska, krajiny a leteckej spoločnosti. Pred letom skontrolujte požiadavky a väčšie tekutiny podľa potreby vložte do odbavenej batožiny."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De flesta flygplatser tillämpar en gräns på 100 ml / 3,4 oz för vätskor i handbagage, men reglerna kan variera mellan flygplats, land och flygbolag. Kontrollera kraven innan du flyger och lägg större vätskor i incheckat bagage vid behov."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "สนามบินส่วนใหญ่กำหนดให้ของเหลวในกระเป๋าถือมีขนาดไม่เกิน 100 มล. / 3.4 ออนซ์ แต่กฎระเบียบอาจแตกต่างกันไปตามสนามบิน ประเทศ และสายการบิน ตรวจสอบข้อกำหนดก่อนการบิน และใส่ของเหลวที่มีขนาดใหญ่กว่าในสัมภาระที่โหลดใต้เครื่องเมื่อจำเป็น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Çoğu havaalanı 100 mL / 3,4 oz el bagajı sıvı sınırlaması uygular, ancak kurallar havaalanına, ülkeye ve havayoluna göre değişebilir. Uçmadan önce gereksinimleri kontrol edin ve gerektiğinde daha büyük sıvıları kontrol edilen bagaja koyun."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Більшість аеропортів застосовують обмеження на рідини в ручній поклажі до 100 мл / 3,4 унції, але правила можуть відрізнятися в залежності від аеропорту, країни та авіакомпанії. Перевірте вимоги перед польотом і, за потреби, поміщайте більші обсяги рідин у зареєстрований багаж."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hầu hết các sân bay áp dụng giới hạn chất lỏng mang theo 100 mL / 3,4 oz, nhưng quy tắc có thể khác nhau theo sân bay, quốc gia và hãng hàng không. Hãy kiểm tra các yêu cầu trước khi bay, và đặt chất lỏng lớn hơn vào hành lý ký gửi khi cần thiết."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "大多数机场对随身携带的液体限制为100毫升/3.4盎司，但各机场、国家和航空公司的规定可能有所不同。飞行前请检查具体要求，并在必要时将较大液体放入托运行李中。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "大多數機場對隨身攜帶液體的限制為100毫升 / 3.4盎司，但規定可能因機場、國家和航空公司而異。飛行前請檢查相關要求，如有需要，將容量較大的液體放入托運行李中。"
          }
        }
      }
    },
    "trip_planner.packing.list_subtitle" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إذا كنت تسافر مع الأصدقاء، فهذه القائمة الخاصة بالتعبئة مُشتركة بحيث يمكن للجميع استخدام نفس المرجع أثناء التعبئة."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si viatgeu amb amics, aquesta llista de coses per empaquetar es comparteix perquè tothom pugui utilitzar la mateixa referència mentre fa les maletes."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokud cestujete s přáteli, tento seznam věcí k zabalení je sdílen, aby jej všichni mohli při balení používat jako stejnou referenci."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis du rejser med venner, deles denne pakkeliste, så alle kan bruge den samme reference, mens de pakker."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn man mit Freunden reist, wird diese Packliste geteilt, damit jeder beim Packen dasselbe Referenzmaterial verwenden kann."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αν ταξιδεύετε με φίλους, αυτή η λίστα πακεταρίσματος μοιράζεται ώστε όλοι να μπορούν να χρησιμοποιούν την ίδια αναφορά κατά το πακετάρισμα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If traveling with friends, this packing list is shared so everyone can use the same reference while packing."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si viaja con amigos, esta lista de empaque se comparte para que todos puedan usar la misma referencia al empacar."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jos matkustat ystävien kanssa, tämä pakkauslista on jaettu, jotta kaikki voivat käyttää samaa viitepistettä pakatessaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si vous voyagez avec des amis, cette liste de bagages est partagée afin que tout le monde puisse utiliser la même référence lors de la préparation des bagages."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אם נוסעים עם חברים, רשימת האריזה הזו משותפת כדי שכולם יוכלו להשתמש באותה נקודת ייחוס בעת האריזה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यदि दोस्तों के साथ यात्रा कर रहे हैं, तो यह पैकिंग सूची साझा की जाती है ताकि सभी पैकिंग करते समय एक ही संदर्भ का उपयोग कर सकें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ako putujete s prijateljima, ovaj popis za pakiranje dijeli se kako bi svi mogli koristiti istu referencu pri pakiranju."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ha barátokkal utazik, ezt a csomagolási listát megosztják, hogy mindenki ugyanazt a hivatkozást használhassa a pakolás során."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jika bepergian dengan teman, daftar barang bawaan ini dibagikan agar semua orang dapat menggunakan referensi yang sama saat mengemas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se si viaggia con gli amici, questa lista di imballaggio viene condivisa in modo che tutti possano usare lo stesso riferimento durante il fare le valigie."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "友達と旅行する場合、この荷造りリストは共有されるので、皆が荷造りの際に同じ参考にすることができます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "친구들과 여행할 경우, 이 짐 싸기 목록은 모든 사람이 짐을 싸면서 같은 참조를 사용할 수 있도록 공유됩니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jika melakukan perjalanan dengan rakan-rakan, senarai pembungkusan ini dikongsi supaya semua orang boleh menggunakan rujukan yang sama semasa membungkus."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis du reiser med venner, deles denne pakkelisten slik at alle kan bruke samme referanse når de pakker."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als u met vrienden reist, wordt deze paklijst gedeeld, zodat iedereen tijdens het inpakken dezelfde referentie kan gebruiken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeżeli podróżujesz z przyjaciółmi, ta lista pakowania jest udostępniona, aby wszyscy mogli korzystać z tego samego odniesienia podczas pakowania."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se estiver viajando com amigos, esta lista de embalagem é compartilhada para que todos possam usar a mesma referência ao fazer as malas."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dacă călătorești cu prietenii, această listă de bagaje este împărtășită pentru ca toată lumea să poată folosi aceeași referință în timp ce face bagajele."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если путешествовать с друзьями, этот список для упаковки предоставляется для того, чтобы все могли использовать одну и ту же ссылку при упаковке."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ak cestujete s priateľmi, tento zoznam balenia je zdieľaný, aby ho mohli všetci použiť ako rovnaký referenčný bod pri balení."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om du reser med vänner delas denna packningslista så att alla kan använda samma referens när de packar."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "หากเดินทางกับเพื่อน รายการสิ่งของสำหรับจัดกระเป๋านี้ถูกแชร์เพื่อให้ทุกคนสามารถใช้เป็นข้อมูลอ้างอิงเดียวกันขณะจัดกระเป๋าได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arkadaşlarla seyahat ediliyorsa, herkesin paketleme sırasında aynı referansı kullanabilmesi için bu paketleme listesi paylaşılıyor."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Якщо подорожуєте з друзями, цей список для пакування надається, щоб усі могли користуватися одним і тим же орієнтиром під час пакування."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nếu đi du lịch với bạn bè, danh sách đóng gói này được chia sẻ để tất cả mọi người có thể sử dụng cùng một tham chiếu khi đóng gói."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果与朋友一起旅行，这份打包清单是共享的，以便每个人在打包时都可以使用相同的参考。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果與朋友一起旅行，這個打包清單可以共享，以便每個人在打包時使用相同的參考。"
          }
        }
      }
    },
