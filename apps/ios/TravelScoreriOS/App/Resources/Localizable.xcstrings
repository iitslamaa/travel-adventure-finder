    "trip_planner.countries.subtitle" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "احتفظ بالمسار هنا، ثم افتح قائمة البلدان المصنفة عندما تريد إضافة المزيد."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantingueu la ruta aquí, després obriu la llista de països classificats quan vulgueu afegir-ne més."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Držte zde trasu, poté otevřete seznam hodnocených zemí, když budete chtít přidat další."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Behold ruten her, og åbn derefter listen over rangerede lande, når du vil tilføje flere."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Behalte die Route hier und offne die sortierte Landerliste, wenn du mehr hinzufugen willst."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κράτα τη διαδρομή εδώ, και μετά άνοιξε τη λίστα ταξινομημένων χωρών όταν θέλεις να προσθέσεις περισσότερα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep the route here, then open the ranked country list when you want to add more."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén la ruta aqui y abre la lista de paises cuando quieras agregar mas."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pidä reitti täällä, sitten avaa sijoiteltu maiden luettelo, kun haluat lisätä lisää."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gardez l'itineraire ici, puis ouvrez la liste classee pour en ajouter plus."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "שמור את הנתיב כאן, ואז פתח את רשימת המדינות המדורגות כשאתה רוצה להוסיף עוד."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यहाँ मार्ग रखें, फिर जब आप और जोड़ना चाहें तो रैंक की गई देश सूची खोलें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Držite rutu ovdje, zatim otvorite rangiranu listu zemalja kad želite dodati više."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tartsd meg az útvonalat itt, majd nyisd meg a rangsorolt országlistát, amikor többet szeretnél hozzáadni."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tetap di rute ini, lalu buka daftar negara berperingkat saat Anda ingin menambahkan lebih banyak."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantieni qui l'itinerario e apri la lista dei paesi classificati quando vuoi aggiungerne altri."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ここでルートを維持し、追加したいときにランキング付きの国リストを開いてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "여기서 경로를 유지한 후, 더 추가하고 싶을 때 순위 국가 목록을 여세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simpan laluan di sini, kemudian buka senarai negara berperingkat apabila anda ingin menambah lebih banyak."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hold på ruten her, åpne deretter den rangerte landslisten når du vil legge til flere."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Houd hier de route aan, en open vervolgens de gerangschikte landenlijst wanneer je er meer wilt toevoegen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trzymaj tutaj trasę, a następnie otwórz listę krajów w rankingu, gdy chcesz dodać więcej."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantenha a rota aqui e abra a lista ranqueada de paises quando quiser adicionar mais."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Păstrează ruta aici, apoi deschide lista de țări clasificate când vrei să adaugi mai multe."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Держите маршрут здесь, а когда захотите добавить больше, откройте ранжированный список стран."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Držte sa tejto trasy a potom otvorte zoznam zoradených krajín, keď chcete pridať viac."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Håll rutten här, öppna sedan den rankade landslistan när du vill lägga till fler."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เก็บเส้นทางไว้ที่นี่ จากนั้นเปิดรายการประเทศจัดอันดับเมื่อคุณต้องการเพิ่มมากขึ้น"
