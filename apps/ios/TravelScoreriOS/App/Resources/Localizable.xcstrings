            "value" : "Ajoutez d'abord les dates du voyage ci-dessus avant d'attribuer les jours aux pays."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הוסף את תאריכי הטיול למעלה לפני הקצאת ימים למדינות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "देशों को दिन देने से पहले ऊपर यात्रा की तिथियाँ जोड़ें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodajte datume putovanja iznad prije nego što dodijelite dane zemljama."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add meg az utazás dátumait fent, mielőtt napokat rendelnél az országokhoz."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tambahkan tanggal perjalanan di atas sebelum menetapkan hari ke negara."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiungi prima le date del viaggio qui sopra prima di assegnare i giorni ai paesi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "国に日を割り当てる前に、上に旅行日を追加してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "국가별로 일정을 배정하기 전에 위에 여행 날짜를 추가하세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tambah tarikh perjalanan di atas sebelum menetapkan hari kepada negara."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legg til reisedatoer ovenfor før du tildeler dager til land."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voeg eerst de reisdata hierboven toe voordat u dagen aan landen toewijst."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodaj daty podróży powyżej przed przypisaniem dni do krajów."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adicione as datas da viagem acima antes de atribuir os dias aos paises."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adăugați datele călătoriei de mai sus înainte de a atribui zilele țărilor."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добавьте даты поездки выше, прежде чем распределять дни по странам."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pridajte dátumy cesty vyššie pred priradením dní k jednotlivým krajinám."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lägg till resedatum ovan innan du tilldelar dagar till länder."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เพิ่มวันที่การเดินทางด้านบนก่อนกำหนดวันให้กับประเทศต่างๆ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Günleri ülkelere atamadan önce yukarıya seyahat tarihlerini ekleyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Додайте дати подорожі зверху перед призначенням днів країнам."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thêm ngày chuyến đi ở trên trước khi gán ngày cho các quốc gia."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在将天数分配给各个国家之前，请在上方添加旅行日期。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在分配國家天數之前，先在上方添加旅行日期。"
          }
        }
      }
    },
    "trip_planner.availability.trip_route_subtitle" : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختر أي دولة ينتمي إليها كل يوم، أو ضع علامة على اليوم كالسفر."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trieu a quin país pertany cada dia, o marqueu el dia com a viatge."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vyberte, ke které zemi každý den patří, nebo označte den jako cestování."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vælg, hvilket land hver dag tilhører, eller marker dagen som rejse."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wahle, zu welchem Land jeder Tag gehort, oder markiere den Tag als Reise."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Επιλέξτε σε ποια χώρα ανήκει κάθε ημέρα, ή επισημάνετε την ημέρα ως ταξίδι."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose which country each day belongs to, or mark the day as travel."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige a que pais pertenece cada dia o marca el dia como traslado."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valitse, mihin maahan kukin päivä kuuluu, tai merkitse päivä matkustuspäiväksi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez a quel pays appartient chaque jour, ou marquez le jour comme trajet."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "בחר לאיזו מדינה שייך כל יום, או סמן את היום כטיול."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "निर्धारित करें कि प्रत्येक दिन किस देश से संबंधित है, या उस दिन को यात्रा के रूप में अंकित करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odaberite kojoj zemlji pripada svaki dan ili označite dan kao putovanje."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Válaszd ki, hogy melyik országhoz tartozik az egyes nap, vagy jelöld a napot utazásként."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pilih negara mana yang sesuai dengan setiap hari, atau tandai harinya sebagai perjalanan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli a quale paese appartiene ogni giorno oppure segnalo come viaggio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "各日がどの国に属するかを選ぶか、その日を旅行としてマークしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "각 날이 어느 나라에 속하는지 선택하거나, 그 날을 여행으로 표시하세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pilih negara yang dimiliki setiap hari, atau tandakan hari itu sebagai perjalanan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velg hvilket land hver dag tilhører, eller merk dagen som reise."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kies bij welk land elke dag hoort, of markeer de dag als reis."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wybierz, do którego kraju należy każdy dzień, lub zaznacz dzień jako podróż."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha a qual pais cada dia pertence ou marque o dia como deslocamento."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alegeți la ce țară aparține fiecare zi sau marcați ziua ca fiind de călătorie."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выберите, к какой стране относится каждый день, или отметьте день как день дороги."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vyberte, ku ktorej krajine patrí každý deň, alebo označte deň ako cestovanie."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Välj vilket land varje dag tillhör, eller markera dagen som resa."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เลือกว่าประเทศใดตรงกับแต่ละวัน หรือทำเครื่องหมายว่าวันนั้นเป็นวันเดินทาง"
