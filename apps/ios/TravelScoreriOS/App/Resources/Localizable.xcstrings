    "trip_planner.visa.overstay_warning_format" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قد يتجاوز %@ مدة الإقامة المسموح بها بدون تأشيرة لرحلة مدتها %lld يومًا."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ pot superar l’estada sense visat permesa per a un viatge de %lld dies."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ může překročit povolenou dobu pobytu bez víza při %llddenní cestě."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ kan overskride den tilladte visumfriophold for en %lld-dages rejse."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ konnte den erlaubten visafreien Aufenthalt fur eine Reise von %lld Tagen überschreiten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ο %@ ενδέχεται να υπερβεί τη μέγιστη επιτρεπόμενη διάρκεια παραμονής χωρίς βίζα για ένα ταξίδι %lld ημερών."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ may exceed the allowed visa-free stay for a %lld-day trip."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ podria exceder la estancia permitida sin visa para un viaje de %lld dias."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ saattaa ylittää sallitun viisumivapaan oleskelun %lld päivän matkalla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ pourrait depasser la duree de sejour sans visa autorisee pour un voyage de %lld jours."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ עלול לחרוג מהשהייה המותרת ללא ויזה עבור טיול של %lld ימים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ %lld-दिन की यात्रा के लिए अनुमत वीज़ा-मुक्त Aufenthalt से अधिक हो सकता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ može premašiti dopušteni boravak bez vize za putovanje od %lld dana."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ túllépheti a megengedett vízummentes tartózkodást egy %lld napos utazás esetén."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ mungkin melebihi masa tinggal bebas visa yang diizinkan untuk perjalanan selama %lld hari."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ potrebbe superare il soggiorno senza visto consentito per un viaggio di %lld giorni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ は %lld 日間の旅行に対して許可されているビザ免除滞在期間を超える可能性があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@는 %lld일 여행에 대해 허용된 무비자 체류 기간을 초과할 수 있습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ mungkin melebihi tempoh tinggal bebas visa yang dibenarkan untuk perjalanan selama %lld hari."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ kan overskride den tillatte visumfrie oppholdstiden for en %lld-dagers tur."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ kan de toegestane visumvrije verblijfsduur voor een reis van %lld dagen overschrijden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ może przekroczyć dozwolony okres pobytu bez wizy podczas %@-dniowej podróży."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ pode ultrapassar a permanencia sem visto permitida para uma viagem de %lld dias."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ poate depăși șederea permisă fără viză pentru o călătorie de %lld zile."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ может превысить разрешенный безвизовый срок для поездки на %lld дней."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Používateľ %@ môže prekročiť povolený bezvízový pobyt na %lld-dňovej ceste."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ kan överskrida den tillåtna visumfria vistelsen för en %lld-dagarsresa."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ อาจเกินระยะเวลาพำนักโดยไม่ต้องขอวีซ่าสำหรับการเดินทาง %lld วัน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, %lld günlük bir seyahat için izin verilen vizesiz kalış süresini aşabilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Можливо, %@ перевищить дозволений безвізовий термін перебування для подорожі тривалістю %lld днів."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ có thể vượt quá thời gian lưu trú miễn thị thực cho chuyến đi %@ ngày."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 可能会超过 %lld 天行程允许的免签停留时间。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 可能會超過 %lld 天行程的免簽停留期限。"
          }
        }
      }
    },
    "trip_planner.visa.overstay_warning_generic" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قد يتجاوز توقف واحد أو أكثر الإقامة المسموح بها لهذه الرحلة."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una o més parades poden excedir l'estada permesa per a aquest viatge."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jedna nebo více zastávek může překročit povolenou dobu pobytu pro tuto cestu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Et eller flere stop kan overskride den tilladte opholdstid for denne rejse."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein oder mehrere Stopps könnten den erlaubten Aufenthalt fur diese Reise überschreiten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ένα ή περισσότερα ενδιάμεσα σημεία ενδέχεται να υπερβούν την επιτρεπόμενη διάρκεια παραμονής για αυτό το ταξίδι."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "One or more stops may exceed the allowed stay for this trip."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una o mas paradas podrian exceder la estancia permitida para este viaje."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yksi tai useampi pysähdys saattaa ylittää sallitun oleskeluajan tälle matkalle."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une ou plusieurs etapes pourraient depasser la duree de sejour autorisee pour ce voyage."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "עצירה אחת או יותר עשויה לחרוג מהשהייה המותרת לטיול זה."
          }
        },
        "hi" : {
          "stringUnit" : {
