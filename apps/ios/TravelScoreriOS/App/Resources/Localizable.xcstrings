        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jedna ili više presjedanja mogu premašiti dopušteni boravak za ovo putovanje."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
