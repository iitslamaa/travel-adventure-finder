    "feedback.intro.body_1" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أنشأت TAF لأنني كنت أستمر في البحث عن نفس إحصاءات السفر عند اتخاذ قرار إلى أين أذهب، ولم أستطع تصديق أن أداة مثل هذه لم تكن موجودة بالفعل."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaig crear TAF perquè seguia consultant les mateixes estadístiques de viatge quan decidia on anar, i no podia creure que una eina com aquesta no existís ja."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Postavil jsem TAF, protože jsem pořád hledal stejné cestovní statistiky při rozhodování, kam jet, a nemohl jsem uvěřit, že takový nástroj už neexistuje."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeg byggede TAF, fordi jeg blev ved med at slå de samme rejse-statistikker op, når jeg skulle beslutte, hvor jeg ville tage hen, og jeg kunne ikke tro, at et værktøj som dette ikke allerede eksisterede."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ich habe TAF gebaut, weil ich bei der Reiseplanung immer wieder dieselben Statistiken gesucht habe und kaum glauben konnte, dass es so ein Tool noch nicht gab."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Έφτιαξα το TAF γιατί συνέχιζα να αναζητώ τα ίδια στατιστικά ταξιδιών όταν αποφάσιζα πού να πάω, και δεν μπορούσα να πιστέψω ότι ένα εργαλείο σαν κι αυτό δεν υπήρχε ήδη."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I built TAF because I kept looking up the same travel statistics when deciding where to go, and I could not believe a tool like this did not already exist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Construí TAF porque siempre buscaba las mismas estadisticas de viaje al decidir a donde ir, y no podia creer que una herramienta asi no existiera."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rakensin TAF:n, koska jatkuvasti etsin samoja matkailutilastoja päättäessäni, minne mennä, enkä voinut uskoa, ettei tällainen työkalu ollut jo olemassa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "J'ai cree TAF parce que je cherchais toujours les memes statistiques de voyage au moment de choisir ou partir, et je n'arrivais pas a croire qu'un outil comme celui-ci n'existait pas deja."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "בניתי את TAF כי המשכתי לחפש את אותן סטטיסטיקות נסיעה כשקבעתי לאיפה ללכת, ולא יכולתי להאמין שכלי כזה עדיין לא קיים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मैंने टीएएफ का निर्माण किया क्योंकि मैं कहाँ जाना है यह तय करते समय वही यात्रा आँकड़े देखता रहता था, और मुझे विश्वास नहीं हो रहा था कि इस तरह का कोई उपकरण पहले से मौजूद नहीं था।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izgradio sam TAF jer sam stalno provjeravao iste statistike putovanja kada sam odlučivao kamo ići, i nisam mogao vjerovati da alat poput ovog već ne postoji."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A TAF-ot azért építettem, mert mindig ugyanazokat az utazási statisztikákat kerestem, amikor eldöntöttem, hová menjek, és nem tudtam elhinni, hogy egy ilyen eszköz még nem létezik."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saya membangun TAF karena saya terus mencari statistik perjalanan yang sama saat memutuskan ke mana akan pergi, dan saya tidak percaya alat seperti ini belum ada."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ho creato TAF perche continuavo a cercare le stesse statistiche di viaggio quando decidevo dove andare e non riuscivo a credere che uno strumento cosi non esistesse gia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "私はTAFを作りました。なぜなら、どこに行くか決めるときに同じ旅行統計を何度も調べていて、こんなツールがすでに存在していないとは信じられなかったからです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "나는 어디로 갈지 결정할 때 같은 여행 통계를 계속 찾아보고 있었기 때문에 TAF를 만들었고, 이런 도구가 이미 존재하지 않는다는 것이 믿기지 않았다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saya membina TAF kerana saya sentiasa melihat statistik perjalanan yang sama ketika memutuskan ke mana hendak pergi, dan saya tidak percaya alat seperti ini belum wujud."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeg bygde TAF fordi jeg stadig måtte se opp de samme reise-statistikkene når jeg skulle bestemme hvor jeg skulle dra, og jeg kunne ikke tro at et verktøy som dette ikke allerede eksisterte."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ik heb TAF gebouwd omdat ik steeds dezelfde reisstatistieken opzocht bij het beslissen waar ik naartoe wilde gaan, en ik kon niet geloven dat een tool zoals deze nog niet bestond."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zbudowałem TAF, ponieważ ciągle sprawdzałem te same statystyki podróży, decydując, dokąd się wybrać, i nie mogłem uwierzyć, że narzędzie takie jak to jeszcze nie istnieje."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Criei o TAF porque eu sempre pesquisava as mesmas estatisticas de viagem ao decidir para onde ir e nao conseguia acreditar que uma ferramenta assim ainda nao existia."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Am creat TAF deoarece tot căutam aceleași statistici de călătorie când decideam unde să merg, și nu puteam să cred că un astfel de instrument nu exista deja."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Я создала TAF, потому что постоянно искала одни и те же туристические показатели, когда решала, куда поехать, и не могла поверить, что такого инструмента еще не существует."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vytvoril som TAF, pretože som neustále vyhľadával tie isté cestovné štatistiky, keď som rozhodoval, kam ísť, a nemohol som uveriť, že nástroj ako tento ešte neexistuje."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jag byggde TAF eftersom jag ständigt letade upp samma resetistik när jag bestämde vart jag skulle åka, och jag kunde inte tro att ett verktyg som detta inte redan fanns."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ฉันสร้าง TAF ขึ้นเพราะฉันมักจะค้นหาสถิติการเดินทางเดียวกันซ้ำ ๆ เมื่อกำลังตัดสินใจว่าจะไปที่ไหน และฉันไม่สามารถเชื่อได้ว่าเครื่องมือแบบนี้ยังไม่มีอยู่แล้ว"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TAF'ı, nereye gideceğime karar verirken sürekli aynı seyahat istatistiklerine bakıyordum ve böyle bir aracın zaten mevcut olmadığına inanamadığım için kurdum."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Я створив TAF, тому що постійно шукав ті самі туристичні статистики, коли вирішував, куди поїхати, і не міг повірити, що такого інструменту ще не існує."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tôi đã xây dựng TAF vì tôi liên tục phải tra cứu cùng một thống kê du lịch khi quyết định đi đâu, và tôi không thể tin rằng một công cụ như thế này lại chưa tồn tại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我创建TAF是因为在决定去哪里旅行时，我总是不断查找相同的旅行统计数据，而且我无法相信像这样的工具居然还不存在。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我創建了TAF，因為在決定去哪裡旅行時，我總是反覆查找相同的旅遊統計數據，而我無法相信這樣的工具居然還不存在。"
          }
        }
      }
    },
    "feedback.intro.body_2" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أنا شغوف بالسفر والتواصل مع الناس، وأرغب حقًا أن تكون TAF شيئًا يجده المسافرون مفيدًا."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tinc passió per viatjar i connectar amb la gent, i de veritat vull que TAF sigui alguna cosa que els viatgers trobin útil."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jsem nadšený z cestování a navazování kontaktů s lidmi a upřímně chci, aby TAF bylo něčím, co cestovatelé považují za užitečné."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeg brænder for at rejse og knytte forbindelser med mennesker, og jeg ønsker oprigtigt, at TAF skal være noget, som rejsende finder nyttigt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ich reise leidenschaftlich gern und liebe es, mit Menschen in Kontakt zu kommen, und ich mochte wirklich, dass TAF fur Reisende nutzlich ist."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Είμαι παθιασμένος με τα ταξίδια και τη σύνδεση με ανθρώπους, και θέλω πραγματικά το TAF να είναι κάτι που οι ταξιδιώτες βρίσκουν χρήσιμο."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I am passionate about traveling and connecting with people, and I genuinely want TAF to be something travelers find useful."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Me apasiona viajar y conectar con la gente, y de verdad quiero que TAF sea algo util para los viajeros."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Olen intohimoinen matkustamisesta ja ihmisiin tutustumisesta, ja haluan aidosti, että TAF on jotakin, mitä matkailijat pitävät hyödyllisenä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je suis passionnee par le voyage et les rencontres, et je veux sincerement que TAF soit vraiment utile aux voyageurs."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אני נלהב מטיולים ומקשר עם אנשים, ואני באמת רוצה ש-TAF יהיה משהו שמטיילים מוצאים בו שימושי."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मुझे यात्रा करने और लोगों से जुड़ने का शौक है और मैं सचमुच चाहता हूं कि टीएएफ कुछ ऐसा हो जो यात्रियों के लिए उपयोगी हो।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Strastveno se bavim putovanjima i povezivanjem s ljudima, te istinski želim da TAF bude nešto što putnici smatraju korisnim."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Szenvedélyesen rajongok az utazásért és az emberekkel való kapcsolatteremtésért, és őszintén azt szeretném, ha a TAF olyasmi lenne, amit az utazók hasznosnak találnak."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saya bersemangat tentang perjalanan dan berinteraksi dengan orang-orang, dan saya sungguh-sungguh ingin TAF menjadi sesuatu yang berguna bagi para pelancong."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Amo viaggiare e connettermi con le persone, e voglio davvero che TAF sia qualcosa di utile per i viaggiatori."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "私は旅行と人とのつながりに情熱を持っており、旅行者が役立つと感じるようなものにTAFがなることを本当に望んでいます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "저는 여행과 사람들과의 교류에 열정을 가지고 있으며, 여행자들이 TAF를 유용하게 느끼는 것이 되기를 진심으로 바랍니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saya bersemangat tentang melancong dan berhubung dengan orang, dan saya benar-benar mahu TAF menjadi sesuatu yang berguna bagi para pengembara."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeg brenner for å reise og knytte kontakt med mennesker, og jeg ønsker virkelig at TAF skal være noe reisende finner nyttig."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ik ben gepassioneerd over reizen en het verbinden met mensen, en ik wil oprecht dat TAF iets is dat reizigers nuttig vinden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pasjonuję się podróżowaniem i nawiązywaniem kontaktów z ludźmi, i naprawdę chcę, aby TAF było czymś, co podróżnicy uznają za przydatne."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sou apaixonada por viajar e me conectar com pessoas, e realmente quero que o TAF seja algo util para viajantes."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sunt pasionat de călătorii și de a interacționa cu oamenii și îmi doresc cu adevărat ca TAF să fie ceva ce călătorii consideră util."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Я очень люблю путешествия и общение с людьми и искренне хочу, чтобы TAF был полезным для путешественников."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Som nadšený cestovaním a nadväzovaním kontaktov s ľuďmi a úprimne chcem, aby TAF bolo niečo, čo cestovatelia považujú za užitočné."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jag brinner för att resa och knyta kontakt med människor, och jag vill verkligen att TAF ska vara något som resenärer tycker är användbart."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ฉันมีความหลงใหลในการเดินทางและการสร้างความสัมพันธ์กับผู้คน และฉันต้องการอย่างจริงใจให้ TAF เป็นสิ่งที่นักเดินทางพบว่ามีประโยชน์"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seyahat etmeye ve insanlarla bağlantı kurmaya tutkuyla bağlıyım ve TAF'in gezginler için faydalı bir şey olmasını gerçekten istiyorum."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Я пристрасно люблю подорожувати та спілкуватися з людьми, і я щиро хочу, щоб TAF було тим, що мандрівники вважають корисним."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tôi đam mê du lịch và kết nối với mọi người, và tôi thực sự muốn TAF trở thành thứ mà các du khách thấy hữu ích."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我热衷于旅行和与人交流，我真心希望TAF能成为旅行者觉得有用的东西。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我熱衷於旅行和與人交流，我真心希望TAF能成為旅行者覺得有用的東西。"
          }
        }
      }
    },
