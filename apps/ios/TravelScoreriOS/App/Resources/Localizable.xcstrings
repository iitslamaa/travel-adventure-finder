    "trip_planner.availability.summary_no_shared_window" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا توجد نافذة مشتركة بعد. اطلب من الجميع إضافة بضعة أشهر أو نطاقات تواريخ مجانية حتى يتمكن المخطط من العثور على تطابق أفضل."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Encara no hi ha cap finestra compartida. Demana a tothom que afegeixi uns quants mesos o rangs de dates gratuïts més perquè el planificador pugui trobar una millor coincidència."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ještě žádné společné okno. Požádejte všechny, aby přidali několik dalších volných měsíců nebo časových období, aby kalendář mohl najít lepší shodu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingen delt vindue endnu. Bed alle om at tilføje et par flere ledige måneder eller datointervaller, så planlæggeren kan finde et bedre match."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noch kein gemeinsames Zeitfenster. Bitte alle, weitere freie Monate oder Datumsbereiche hinzuzufugen, damit der Planer eine bessere Uberschneidung findet."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν υπάρχει ακόμα κοινό παράθυρο. Ζητήστε από όλους να προσθέσουν λίγους ακόμα ελεύθερους μήνες ή χρονικές περιόδους ώστε ο προγραμματιστής να μπορέσει να βρει καλύτερο ταίριασμα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No shared window yet. Ask everyone to add a few more free months or date ranges so the planner can find a better match."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todavia no hay una ventana compartida. Pidele a todos que agreguen algunos meses libres o rangos mas para que el planificador encuentre una mejor coincidencia."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ei vielä yhteistä ajanjaksoa. Pyydä kaikkia lisäämään muutama vapaa kuukausi tai aikajakso, jotta suunnittelija voi löytää paremman sopivuuden."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pas encore de periode commune. Demandez a chacun d'ajouter plus de mois libres ou de plages de dates pour que le planificateur trouve une meilleure correspondance."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "עדיין אין חלון משותף. בקש מכולם להוסיף עוד כמה חודשים חופשיים או טווחי תאריכים כדי שהמתכנן יוכל למצוא התאמה טובה יותר."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अभी तक कोई साझा विंडो नहीं है। हर किसी से कहें कि वे कुछ और मुफ्त महीने या तिथियाँ जोड़ें ताकि योजनाकार बेहतर मेल खोज सके।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Još nema zajedničkog termina. Zamolite sve da dodaju još nekoliko slobodnih mjeseci ili vremenskih razdoblja kako bi planer mogao pronaći bolje podudaranje."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Még nincs közös időablak. Kérd meg mindenkit, hogy adjon hozzá néhány szabad hónapot vagy időszakot, hogy a tervező jobb egyezést találhasson."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Belum ada jendela yang sama. Minta semua orang untuk menambahkan beberapa bulan atau rentang tanggal gratis lagi agar perencana dapat menemukan kecocokan yang lebih baik."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ancora nessuna finestra condivisa. Chiedi a tutti di aggiungere altri mesi liberi o intervalli di date per trovare un incastro migliore."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "まだ共有されている時間枠はありません。プランナーがより良いマッチを見つけられるように、皆にもう少し自由な月や日付範囲を追加するように頼んでください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아직 공유된 일정이 없습니다. 계획자가 더 나은 일정을 찾을 수 있도록 모두에게 몇 달 또는 날짜 범위를 더 추가하도록 요청하세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiada tingkap dikongsi lagi. Minta semua orang menambah beberapa bulan atau julat tarikh yang bebas supaya perancang dapat mencari padanan yang lebih baik."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingen delt vindu ennå. Be alle legge til noen flere ledige måneder eller datoområder, så planleggeren kan finne en bedre match."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nog geen gedeeld venster. Vraag iedereen om een paar extra vrije maanden of datumbereiken toe te voegen zodat de planner een betere match kan vinden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeszcze nie ma wspólnego okna. Poproś wszystkich, aby dodali kilka dodatkowych wolnych miesięcy lub zakresów dat, aby planer mógł znaleźć lepsze dopasowanie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ainda nao ha uma janela em comum. Peca para todos adicionarem mais meses livres ou intervalos de datas para que o planejador encontre uma combinacao melhor."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Încă nu există o fereastră comună. Cere tuturor să adauge câteva luni sau intervale de date libere pentru ca planificatorul să poată găsi o potrivire mai bună."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Общего окна пока нет. Попросите всех добавить еще несколько свободных месяцев или диапазонов дат, чтобы планировщик смог найти лучшее совпадение."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zatiaľ žiadne spoločné okno. Požiadajte všetkých, aby pridali niekoľko voľných mesiacov alebo časových rozsahov, aby plánovač mohol nájsť lepšie zladenie."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingen gemensam tid ännu. Be alla att lägga till några fler fria månader eller dataintervall så att planeringsverktyget kan hitta en bättre matchning."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ยังไม่มีหน้าต่างเวลาที่ใช้ร่วมกัน แนะนำให้ทุกคนเพิ่มเดือนฟรีหรือช่วงวันที่อีกเล็กน้อยเพื่อให้ตัววางแผนสามารถหาการจับคู่ที่ดีกว่าได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Henüz ortak bir pencere yok. Planlayıcının daha iyi bir eşleşme bulabilmesi için herkesin birkaç ek ücretsiz ay veya tarih aralığı eklemesini isteyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Поки що немає спільного вікна. Попросіть усіх додати ще кілька вільних місяців або діапазонів дат, щоб планувальник міг знайти краще співпадіння."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chưa có khung thời gian chung nào. Hãy yêu cầu mọi người thêm một vài tháng hoặc khoảng ngày trống nữa để người lập kế hoạch có thể tìm được sự phù hợp tốt hơn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "还没有共享的时间窗口。请大家添加几个月或几段日期的空闲时间，这样日程安排者才能找到更合适的匹配。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "尚未有共同的空檔時間。請大家再增加幾個空閒的月份或日期範圍，以便規劃者可以找到更好的匹配。"
          }
        }
      }
    },
