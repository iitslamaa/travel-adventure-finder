            "value" : "Виберіть, чи видалити цю поїздку тільки з вашого планувальника, чи з усієї групи."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chọn xem chỉ xóa chuyến đi này khỏi lịch trình của bạn hay xóa khỏi cả nhóm."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选择是仅从您的行程规划器中移除此行程，还是从整个群组中移除。"
