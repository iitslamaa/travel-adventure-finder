        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "มันควรจะมีประโยชน์มากที่สุดในพื้นที่ที่มีนักท่องเที่ยวหนาแน่นมากกว่าทุกที่"
