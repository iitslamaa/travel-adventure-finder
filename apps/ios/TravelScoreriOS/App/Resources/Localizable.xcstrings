        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Travel Adventure Finder nije odgovoran za odluke donesene na temelju informacija prikazanih u aplikaciji. Korištenje ove aplikacije je na vašu vlastitu odgovornost."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Travel Adventure Finder nem vállal felelősséget az alkalmazásban bemutatott információk alapján hozott döntésekért. Az alkalmazás használata saját belátásod szerint történik."
