    "trip_planner.availability.trip_route_empty" : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أضف تواريخ الرحلة الدقيقة أولاً، ثم خصص كل يوم لدولة معينة أو ضع علامة عليه كوقت للسفر."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afegeix primer les dates exactes del viatge i després assigna cada dia a un país o marca’l com a dia de viatge."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nejprve přidejte přesná data cesty, potom přiřaďte každý den k zemi nebo ho označte jako cestování."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tilføj først de præcise rejsedatoer, og tildel derefter hver dag til et land eller marker den som rejse."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fuge zuerst genaue Reisedaten hinzu und ordne dann jeden Tag einem Land zu oder markiere ihn als Reisetag."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Προσθέστε πρώτα τις ακριβείς ημερομηνίες του ταξιδιού, στη συνέχεια αναθέστε κάθε μέρα σε μια χώρα ή σημειώστε την ως ημέρα ταξιδιού."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add exact trip dates first, then assign each day to a country or mark it as travel."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agrega primero las fechas exactas del viaje y luego asigna cada dia a un pais o marcalo como traslado."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lisää ensin tarkat matkapäivät, sitten määritä jokainen päivä maalle tai merkitse se matkaksi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez d'abord des dates exactes au voyage, puis attribuez chaque jour a un pays ou marquez-le comme trajet."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הוסף תחילה את תאריכי הנסיעה המדויקים, ואז הקצה כל יום למדינה או סמן אותו כנסיעה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पहले सही यात्रा की तारीखें जोड़ें, फिर प्रत्येक दिन को किसी देश के साथ असाइन करें या इसे यात्रा के रूप में चिह्नित करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prvo dodajte točne datume putovanja, zatim svaki dan dodijelite zemlji ili ga označite kao dan putovanja."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Először add meg a pontos utazási dátumokat, majd rendelj minden naphoz egy országot, vagy jelöld utazásként."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tambahkan tanggal perjalanan yang tepat terlebih dahulu, lalu tetapkan setiap hari ke suatu negara atau tandai sebagai perjalanan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiungi prima le date esatte del viaggio, poi assegna ogni giorno a un paese o segnalo come giorno di viaggio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "まず正確な旅行日を追加し、それから各日を国に割り当てるか、移動日としてマークしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "먼저 정확한 여행 날짜를 추가한 후, 각 날을 국가에 배정하거나 이동으로 표시하세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tambah tarikh perjalanan yang tepat dahulu, kemudian tetapkan setiap hari kepada satu negara atau tandakan sebagai perjalanan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legg først til eksakte reisedatoer, deretter tilordne hver dag til et land eller merk den som reisedag."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voeg eerst de exacte reisdata toe, wijs vervolgens elke dag aan een land toe of markeer deze als reistijd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Najpierw dodaj dokładne daty podróży, a następnie przypisz każdy dzień do kraju lub oznacz go jako dzień podróży."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adicione primeiro as datas exatas da viagem e depois associe cada dia a um pais ou marque-o como deslocamento."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adaugă mai întâi datele exacte ale călătoriei, apoi alocă fiecare zi unei țări sau marcheaz-o ca zi de călătorie."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сначала добавьте точные даты поездки, а затем распределите каждый день по стране или отметьте его как день дороги."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Najprv pridajte presné dátumy cesty, potom každý deň priraďte k krajine alebo ho označte ako cestovanie."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lägg till exakta resedatum först, och tilldela sedan varje dag till ett land eller markera den som resdag."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เพิ่มวันที่เดินทางที่แน่นอนก่อน จากนั้นจึงกำหนดแต่ละวันให้กับประเทศใดประเทศหนึ่งหรือทำเครื่องหมายว่าวันนั้นเป็นวันเดินทาง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Önce tam seyahat tarihlerini ekleyin, ardından her günü bir ülkeye atayın veya seyahat olarak işaretleyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Спочатку додайте точні дати поїздки, а потім призначте кожен день країні або позначте його як день подорожі."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trước tiên hãy thêm ngày đi cụ thể, sau đó phân công mỗi ngày cho một quốc gia hoặc đánh dấu là ngày đi lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "首先添加确切的旅行日期，然后将每一天分配到一个国家或标记为旅行日。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "先添加確切的旅行日期，然後將每一天分配到一個國家或標記為旅行日。"
          }
        }
      }
    },
