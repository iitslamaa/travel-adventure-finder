    "trip_planner.empty.subtitle" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ابدأ بفكرة رحلة تقريبية واحدة وصقلها مع وضوح التواريخ والدول والأشخاص."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comença amb una idea de viatge general i refina-la a mesura que les dates, els països i les persones es vagin definint."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Začněte s jedním hrubým nápadem na cestu a zpřesňujte ho, jakmile se vyjasní data, země a lidé."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Start med en grov rejseidé og forfin den, efterhånden som datoer, lande og personer kommer i fokus."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beginne mit einer groben Reiseidee und verfeinere sie, wenn Daten, Lander und Mitreisende klarer werden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ξεκινήστε με μια αδρή ιδέα για ταξίδι και βελτιώστε τη καθώς οι ημερομηνίες, οι χώρες και οι άνθρωποι γίνονται πιο ξεκάθαροι."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Start with one rough trip idea and refine it as dates, countries, and people come into focus."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Empieza con una idea general del viaje y refinála cuando las fechas, paises y personas se definan."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aloita yhdellä alustavalla matkasuunnitelmalla ja tarkenna sitä sitä mukaa, kun päivämäärät, maat ja ihmiset selkiytyvät."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Commencez par une idee approximative de voyage, puis affinez-la au fur et a mesure que les dates, les pays et les personnes se preciseront."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "התחל עם רעיון טיול אחד גס ולטפח אותו ככל שהתאריכים, המדינות והאנשים מתחילים להתבהר."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एक मोटे यात्रा विचार के साथ शुरू करें और जैसे-जैसे तिथियाँ, देश और लोग स्पष्ट होते हैं इसे परिष्कृत करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Započnite s jednom grubljom idejom za putovanje i usavršavajte je kako se datumi, zemlje i ljudi budu jasno oblikovali."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kezdj egy durva utazási ötlettel, majd finomítsd azt, ahogy a dátumok, országok és emberek körvonalazódnak."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mulailah dengan satu ide perjalanan kasar dan perbaiki seiring tanggal, negara, dan orang mulai terlihat jelas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inizia con un'idea di viaggio approssimativa e rifiniscila man mano che date, paesi e persone prendono forma."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "まずはざっくりとした旅行のアイデアから始め、日程や国、同行者がはっきりしてくるにつれてそれを具体化していきます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "하나의 대략적인 여행 아이디어로 시작하고 날짜, 국가, 사람들이 구체화됨에 따라 그것을 다듬어 가세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mulakan dengan satu idea perjalanan kasar dan perbaikannya apabila tarikh, negara, dan orang menjadi jelas."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Start med én grov reiseidé og finsli den etterhvert som datoer, land og folk kommer i fokus."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Begin met één globaal reisidee en werk het bij naarmate data, landen en mensen duidelijker worden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zacznij od jednego ogólnego pomysłu na podróż i dopracowuj go w miarę ustalania dat, krajów i osób."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comece com uma ideia inicial de viagem e refine quando datas, paises e pessoas ficarem mais claras."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Începe cu o idee generală de călătorie și perfecționeaz-o pe măsură ce datele, țările și persoanele devin clare."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Начните с одной примерной идеи поездки и уточняйте ее по мере того, как проясняются даты, страны и люди."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Začnite s jedným hrubým nápadom na cestu a spresnite ho, keď sa objavia presné dátumy, krajiny a ľudia."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Börja med en grov reseidé och förfina den allt eftersom datum, länder och människor blir tydligare."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เริ่มด้วยไอเดียการเดินทางคร่าวๆ หนึ่งไอเดีย แล้วปรับแต่งมันเมื่อวันที่ ประเทศ และผู้คนเริ่มชัดเจนขึ้น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir kaba gezi fikriyle başlayın ve tarihler, ülkeler ve insanlar netleştikçe bunu geliştirin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Почніть з однієї загальної ідеї подорожі та уточнюйте її, коли дати, країни та люди стануть більш чіткими."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bắt đầu với một ý tưởng chuyến đi sơ bộ và tinh chỉnh nó khi ngày tháng, quốc gia và con người dần rõ nét hơn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "从一个大致的旅行想法开始，然后随着日期、国家和人物逐渐明确而完善它。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "從一個粗略的旅行想法開始，隨著日期、國家和人物逐漸明朗，再進行細化。"
          }
        }
      }
    },
