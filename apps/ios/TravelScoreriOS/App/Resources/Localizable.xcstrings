    "planning.list_kind.bucket.empty_description" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اضغط على تعديل لإضافة دول هنا، أو اسحب لليسار على دولة واضغط على سلة."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca Edita per afegir països aquí, o fes lliscar cap a l'esquerra en un país i toca Cubeta."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klepněte na Upravit pro přidání zemí sem, nebo přejeďte prstem doleva na zemi a klepněte na Koš."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryk på Rediger for at tilføje lande her, eller swipe til venstre på et land og tryk på Spand."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe auf Bearbeiten, um hier Lander hinzuzufugen, oder wische bei einem Land nach links und tippe auf Bucket."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πατήστε Επεξεργασία για να προσθέσετε χώρες εδώ, ή σύρετε αριστερά πάνω σε μια χώρα και πατήστε Κουβάς."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap Edit to add countries here, or swipe left on a country and tap Bucket."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca Editar para agregar paises aqui, o desliza a la izquierda en un pais y toca Lista de deseos."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Napauta Muokkaa lisätäksesi maita tähän, tai pyyhkäise vasemmalle maata ja napauta Ämpäri."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez Modifier pour ajouter des pays ici, ou balayez un pays vers la gauche et touchez Bucket."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הקש על עריכה כדי להוסיף מדינות כאן, או החלק שמאלה על מדינה והקש על דלי."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यहां देशों को जोड़ने के लिए संपादित करें पर टैप करें, या किसी देश पर बाईं ओर स्वाइप करें और बकेट पर टैप करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodirnite Uredi da biste ovdje dodali zemlje, ili povucite lijevo na zemlji i dodirnite Kanta."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koppints a Szerkesztésre, hogy országokat adj hozzá ide, vagy húzd balra az országot, és koppints a Vödörre."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ketuk Edit untuk menambahkan negara di sini, atau geser ke kiri pada sebuah negara dan ketuk Bucket."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocca Modifica per aggiungere paesi qui oppure scorri a sinistra su un paese e tocca Bucket."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ここに国を追加するには「編集」をタップするか、国を左にスワイプして「バケット」をタップしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "여기에 국가를 추가하려면 편집을 탭하거나, 국가에서 왼쪽으로 스와이프한 후 버킷을 탭하세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ketik Edit untuk menambah negara di sini, atau leret ke kiri pada satu negara dan ketik Bucket."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trykk på Rediger for å legge til land her, eller sveip til venstre på et land og trykk på Bøtte."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tik op Bewerken om hier landen toe te voegen, of veeg naar links op een land en tik op Emmer."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stuknij Edytuj, aby dodać tutaj kraje, lub przesuń w lewo na kraju i stuknij Kosz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque em Editar para adicionar paises aqui ou deslize para a esquerda em um pais e toque em Lista de desejos."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atinge Editare pentru a adăuga țări aici, sau glisează spre stânga pe o țară și atinge Găleată."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добавляйте страны, которые хотите посетить."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klepnite na Upraviť a pridajte sem krajiny, alebo potiahnite krajinu doľava a klepnite na Kôš."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryck på Redigera för att lägga till länder här, eller svep åt vänster på ett land och tryck på Hink."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แตะ แก้ไข เพื่อเพิ่มประเทศที่นี่ หรือปัดไปทางซ้ายบนประเทศแล้วแตะ ถัง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buraya ülke eklemek için Düzenle'ye dokunun veya bir ülkenin üzerine sola kaydırın ve Kova'ya dokunun."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Натисніть \"Редагувати\", щоб додати країни тут, або проведіть ліворуч по країні та натисніть \"Кошик\"."
          }
        },
        "vi" : {
