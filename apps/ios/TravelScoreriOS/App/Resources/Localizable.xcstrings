    "trip_planner.delete.options_message" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختر ما إذا كنت تريد إزالة هذه الرحلة من مخططك فقط أو من المجموعة بأكملها."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trieu si voleu eliminar aquest viatge només del vostre planificador o de tot el grup."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zvolte, zda chcete tuto cestu odstranit pouze ze svého plánu nebo z celé skupiny."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vælg, om du kun vil fjerne denne tur fra din planlægger eller fra hele gruppen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wählen Sie, ob Sie diese Reise nur aus Ihrem Planer oder aus der gesamten Gruppe entfernen möchten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Επιλέξτε εάν θέλετε να αφαιρέσετε αυτό το ταξίδι μόνο από τον προγραμματιστή σας ή από ολόκληρη την ομάδα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose whether to remove this trip only from your planner or from the whole group."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elija si desea eliminar este viaje solo de su planificador o de todo el grupo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valitse, poistetaanko tämä matka vain suunnittelustasi vai koko ryhmästä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez si vous voulez supprimer ce voyage uniquement de votre planificateur ou de tout le groupe."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "בחר אם להסיר את הנסיעה הזו רק מהמתכנן שלך או מהקבוצה כולה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "निर्धारित करें कि इस यात्रा को केवल आपके योजना में से हटाना है या पूरे समूह से।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odaberite želite li ukloniti ovo putovanje samo iz vašeg planera ili iz cijele grupe."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Válassza ki, hogy ezt az utazást csak a tervezőjéből vagy az egész csoportból szeretné eltávolítani."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pilih apakah ingin menghapus perjalanan ini hanya dari perencana Anda atau dari seluruh grup."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli se rimuovere questo viaggio solo dal tuo pianificatore o dall'intero gruppo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この旅行をあなたのプランナーからのみ削除するか、グループ全体から削除するかを選んでください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 여행을 플래너에서만 제거할지 전체 그룹에서 제거할지 선택하세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pilih sama ada untuk mengeluarkan perjalanan ini sahaja dari perancang anda atau dari keseluruhan kumpulan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velg om du vil fjerne denne turen bare fra planleggeren din eller fra hele gruppen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kies of je deze reis alleen uit je planner of uit de hele groep wilt verwijderen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wybierz, czy usunąć tę podróż tylko ze swojego planera, czy z całej grupy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha se deseja remover esta viagem apenas do seu planejador ou de todo o grupo."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alegeți dacă să eliminați această călătorie doar din planificatorul dvs. sau din întreaga grupă."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выберите, удалить ли эту поездку только из вашего планировщика или из всей группы."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vyberte, či chcete tento výlet odstrániť iba zo svojho plánovača alebo z celého skupiny."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Välj om du vill ta bort denna resa endast från din planeringslista eller från hela gruppen."
          }
        },
        "th" : {
          "stringUnit" : {
