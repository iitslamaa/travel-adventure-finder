          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scopri chi e stato qui, chi vuole andarci o chi e di qui."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
