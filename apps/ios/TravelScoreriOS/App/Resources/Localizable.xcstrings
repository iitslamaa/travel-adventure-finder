    "auth.sheet.subtitle" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قم بتسجيل الدخول لحفظ قائمة أمنياتك وتزامنها عبر الأجهزة."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inicia la sessió per desar la teva llista de desitjos i sincronitzar-la entre dispositius."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přihlaste se, abyste si uložili svůj seznam přání a synchronizovali jej napříč zařízeními."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Log ind for at gemme din ønskeliste og synkronisere på tværs af enheder."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Melde dich an, um deine Bucket List zu speichern und auf allen Geraten zu synchronisieren."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Συνδεθείτε για να αποθηκεύσετε τη λίστα σας με όνειρα και να συγχρονίσετε σε όλες τις συσκευές."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sign in to save your bucket list and sync across devices."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inicia sesion para guardar tu lista y sincronizarla entre dispositivos."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kirjaudu sisään tallentaaksesi unelmalistasikin ja synkronoidaksesi sen laitteiden välillä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connectez-vous pour enregistrer votre bucket list et synchroniser vos appareils."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "היכנס כדי לשמור את רשימת השאיפות שלך ולסנכרן בין המכשירים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अपनी बकेट सूची सहेजने और सभी डिवाइसों में सिंक करने के लिए साइन इन करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prijavite se kako biste spremili svoj popis želja i sinkronizirali ga na svim uređajima."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jelentkezz be, hogy elmenthesd a bakancslistádat és szinkronizálhasd az eszközeid között."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Masuk untuk menyimpan daftar keinginan Anda dan menyinkronkannya di seluruh perangkat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accedi per salvare la tua bucket list e sincronizzarla tra i dispositivi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サインインして、バケットリストを保存し、デバイス間で同期しましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "로그인하여 버킷리스트를 저장하고 기기 간 동기화하세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Log masuk untuk menyimpan senarai impian anda dan menyegerakkan merentasi peranti."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Logg inn for å lagre ønskelisten din og synkronisere på tvers av enheter."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meld je aan om je bucketlist op te slaan en te synchroniseren op al je apparaten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zaloguj się, aby zapisać swoją listę marzeń i synchronizować ją na różnych urządzeniach."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entre para salvar sua lista de desejos e sincronizar entre dispositivos."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conectați-vă pentru a salva lista de dorințe și a sincroniza între dispozitive."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Войдите, чтобы сохранить bucket list и синхронизировать данные между устройствами."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prihláste sa, aby ste si uložili svoj zoznam želaní a synchronizovali ho medzi zariadeniami."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Logga in för att spara din bucketlista och synkronisera mellan enheter."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ลงชื่อเข้าใช้เพื่อบันทึกรายการสิ่งที่ต้องทำของคุณและซิงค์ข้ามอุปกรณ์"
