    "trip_planner.expenses.stats.empty" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم يتم تسجيل أي نفقات بعد. أضف الفنادق أو الوجبات أو التذاكر أو التكاليف المشتركة هنا."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Encara no s'han registrat despeses. Afegiu hotels, menjars, entrades o despeses compartides aquí."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zatím nebyly zaznamenány žádné výdaje. Přidejte zde hotely, jídlo, vstupenky nebo sdílené náklady."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingen udgifter registreret endnu. Tilføj hoteller, måltider, billetter eller delte omkostninger her."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noch keine Ausgaben erfasst. Fuge hier Hotels, Mahlzeiten, Tickets oder geteilte Kosten hinzu."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν έχουν καταχωρηθεί έξοδα ακόμα. Προσθέστε εδώ ξενοδοχεία, γεύματα, εισιτήρια ή κοινά έξοδα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No expenses logged yet. Add hotels, meals, tickets, or shared costs here."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todavia no hay gastos registrados. Agrega hoteles, comidas, boletos o costos compartidos aqui."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ei kuluja kirjattu vielä. Lisää hotellit, ateriat, liput tai jaetut kustannukset tähän."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucune depense enregistree pour le moment. Ajoutez ici hotels, repas, billets ou frais partages."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "עדיין לא נרשמו הוצאות. הוסף כאן בתי מלון, ארוחות, כרטיסים או עלויות משותפות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अभी तक कोई खर्च दर्ज नहीं किया गया है। होटल, भोजन, टिकट या साझा खर्च यहाँ जोड़ें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Još nisu uneseni troškovi. Ovdje dodajte hotele, obroke, ulaznice ili zajedničke troškove."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Még nincsenek rögzített költségek. Itt adhatsz hozzá hoteleket, ételeket, jegyeket vagy megosztott költségeket."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Belum ada pengeluaran yang dicatat. Tambahkan hotel, makanan, tiket, atau biaya bersama di sini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nessuna spesa registrata. Aggiungi qui hotel, pasti, biglietti o costi condivisi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "まだ経費は記録されていません。ここにホテル、食事、チケット、または共有費用を追加してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아직 비용이 기록되지 않았습니다. 여기에서 호텔, 식사, 티켓 또는 공동 비용을 추가하세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiada perbelanjaan dicatat lagi. Tambah hotel, makanan, tiket, atau kos bersama di sini."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingen utgifter registrert ennå. Legg til hoteller, måltider, billetter eller delte kostnader her."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nog geen uitgaven geregistreerd. Voeg hier hotels, maaltijden, tickets of gedeelde kosten toe."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie zarejestrowano jeszcze żadnych wydatków. Dodaj tutaj hotele, posiłki, bilety lub koszty wspólne."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ainda nao ha despesas registradas. Adicione aqui hoteis, refeicoes, ingressos ou custos compartilhados."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
