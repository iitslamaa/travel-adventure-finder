    "trip_planner.whos_going.subtitle" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "احتفظ بها منفردًا أو أضف أصدقاء لمقارنة البلدان المدرجة في قائمة الأمنيات المشتركة."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantingueu-lo en solitari o afegiu amics per comparar els països de la llista de desitjos compartida."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Udrž to sólo nebo přidej přátele, abyste porovnali společné země na seznamu přání."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hold det solo eller tilføj venner for at sammenligne delte bucket-list-lande."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lass es solo oder füg Freunde hinzu, um gemeinsame Bucket-List-Lander zu vergleichen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κράτησέ το solo ή πρόσθεσε φίλους για να συγκρίνετε τις χώρες στη λίστα επιθυμιών σας."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep it solo or add friends to compare shared bucket-list countries."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantenlo en solitario o agrega amigos para comparar paises compartidos de la lista de deseos."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pysy yksin tai lisää ystäviä vertaillaksesi jaettujen bucket-list-maiden kanssa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez des amis ou gardez ce voyage en solo pour le moment."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "השאר את זה לבד או הוסף חברים כדי להשוות בין המדינות ברשימת הדברים המשותפת."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इसे अकेले रखें या साझा बाल्टी-लिस्ट वाले देशों की तुलना करने के लिए दोस्तों को जोड़ें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ostavi ga solo ili dodaj prijatelje kako biste usporedili zemlje s popisa želja."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tartsd egyedül, vagy adj hozzá barátokat, hogy összehasonlítsátok a közös bakancslistás országokat."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Biarkan saja sendiri atau tambahkan teman untuk membandingkan negara-negara dalam daftar keinginan bersama."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tienilo da solo oppure aggiungi amici per confrontare i paesi in comune nelle bucket list."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ソロで続けるか、友達を追加して共有のバケットリストの国を比較しましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "혼자 하거나 친구를 추가하여 공유 버킷리스트 국가를 비교하세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jaga ia secara solo atau tambah kawan untuk membandingkan negara dalam senarai baldi yang dikongsi."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hold det solo eller legg til venner for å sammenligne delte bøtte-liste-land."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Houd het solo of voeg vrienden toe om gedeelde bucketlist-landen te vergelijken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zachowaj to solo lub dodaj przyjaciół, aby porównać wspólne kraje na liście życzeń."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantenha solo ou adicione amigos para comparar paises compartilhados na lista de desejos."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Păstreaz-o solo sau adaugă prieteni pentru a compara țările din lista de dorințe comune."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Оставьте поездку сольной или добавьте друзей, чтобы сравнить общие страны из bucket list."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zostaň solo alebo pridaj priateľov, aby ste porovnali krajiny na spoločnom zozname želaní."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Håll det solo eller lägg till vänner för att jämföra delade bucket-list länder."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เก็บไว้คนเดียวหรือเพิ่มเพื่อนเพื่อเปรียบเทียบประเทศในลิสต์ที่อยากไปด้วยกัน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bunu tek başına tut veya paylaşılan yapılacaklar listesi ülkelerini karşılaştırmak için arkadaş ekle."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Залиште це наодинці або додайте друзів, щоб порівняти країни у спільному списку бажань."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giữ cho nó đơn solo hoặc thêm bạn bè để so sánh các quốc gia trong danh sách điều muốn làm chung."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保持独自进行，或添加朋友以比较共享的愿望清单国家。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保持單獨進行，或邀請朋友一起比較共同的願望清單國家。"
          }
        }
      }
    },
