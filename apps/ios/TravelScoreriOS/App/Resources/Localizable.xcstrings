    "planning.list_kind.visited.picker_subtitle" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اضغط على أي دولة لإضافتها أو إزالتها من قائمة البلدان التي زرتها."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca qualsevol país per afegir-lo o eliminar-lo de la teva llista de països visitats."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klepněte na jakoukoli zemi, abyste ji přidali nebo odstranili ze seznamu navštívených míst."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryk på et hvilket som helst land for at tilføje det eller fjerne det fra din besøgte liste."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe auf ein Land, um es zu deiner Besuchsliste hinzuzufugen oder daraus zu entfernen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πατήστε οποιαδήποτε χώρα για να την προσθέσετε ή να την αφαιρέσετε από τη λίστα των επισκεφθέντων σας."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap any country to add it or remove it from your visited list."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca cualquier pais para agregarlo o quitarlo de tu lista de visitados."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Napauta mitä tahansa maata lisätäksesi sen tai poistaaksesi sen vierailtujen maiden listalta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez un pays pour l'ajouter ou le retirer de votre liste des pays visites."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הקש על כל מדינה כדי להוסיף אותה או להסיר אותה מרשימת המדינות שביקרת בהן."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "किसी भी देश को अपनी विज़िट की गई सूची से जोड़ने या हटाने के लिए उस पर टैप करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodirnite bilo koju zemlju da biste je dodali ili uklonili sa svog popisa posjećenih zemalja."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Érintsen meg bármelyik országot, hogy hozzáadja vagy eltávolítsa a meglátogatott listájáról."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ketuk negara apa pun untuk menambahkannya atau menghapusnya dari daftar yang telah Anda kunjungi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
