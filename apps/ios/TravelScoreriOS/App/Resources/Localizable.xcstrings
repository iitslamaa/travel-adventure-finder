    "seasonality.section.rough.note" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عادة ما يكون هذا الشهر أصعب للسفر هنا. الطقس، والزحام، والإغلاقات، أو القيمة قد تعمل كلها ضد الرحلة."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aquest mes sol ser més difícil per viatjar aquí. El temps, les multitudes, els tancaments o el valor poden anar en contra del viatge."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tento měsíc je zde obvykle náročnější na cestování. Počasí, davy, uzavírky nebo cena mohou všichni hrát proti výletu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne måned er normalt sværere for rejser her. Vejret, folkemængder, lukninger eller værdi kan alle arbejde imod turen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Monat ist hier normalerweise schwieriger für Reisen. Wetter, Menschenmengen, Schließungen oder Kosten können alle gegen die Reise wirken."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αυτός ο μήνας είναι συνήθως πιο δύσκολος για ταξίδια εδώ. Ο καιρός, τα πλήθη, οι κλεισίματα ή η αξία μπορεί όλα να λειτουργήσουν εναντίον του ταξιδιού."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This month is usually harder for travel here. Weather, crowds, closures, or value may all work against the trip."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este mes suele ser más difícil para viajar aquí. El clima, las multitudes, los cierres o el valor pueden ir en contra del viaje."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tämä kuukausi on yleensä täällä matkustamisen kannalta vaikeampi. Sää, väkijoukot, sulkemiset tai hinta-laatusuhde voivat kaikki haitata matkaa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce mois-ci est généralement plus difficile pour voyager ici. Le temps, la foule, les fermetures ou le rapport qualité-prix peuvent tous jouer contre le voyage."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "החודש הזה בדרך כלל קשה יותר לנסיעה כאן. מזג האוויר, ההמונים, הסגירות או הערך הכלכלי כולם עלולים לעבוד נגד הטיול."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस महीने यहाँ यात्रा करना आमतौर पर कठिन होता है। मौसम, भीड़, बंदी या मूल्य सभी यात्रा के खिलाफ काम कर सकते हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ovaj mjesec je obično težji za putovanje ovdje. Vrijeme, gužve, zatvaranja ili vrijednost mogu sve djelovati protiv putovanja."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ez a hónap általában nehezebb az utazás szempontjából itt. Az időjárás, a tömeg, a zárások vagy az érték mind az utazás ellen játszhatnak."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bulan ini biasanya lebih sulit untuk bepergian di sini. Cuaca, keramaian, penutupan, atau nilai bisa saja bekerja melawan perjalanan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo mese è di solito più difficile per viaggiare qui. Il meteo, la folla, le chiusure o il valore potrebbero tutti ostacolare il viaggio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この月は通常、ここでの旅行にはより厳しいです。天気、人混み、閉鎖、または価値の面が旅行の妨げになることがあります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 달은 보통 이곳 여행에 더 어렵습니다. 날씨, 인파, 폐쇄, 또는 비용 등 모든 것이 여행에 불리하게 작용할 수 있습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bulan ini biasanya lebih sukar untuk perjalanan di sini. Cuaca, orang ramai, penutupan, atau nilai mungkin semua menentang perjalanan tersebut."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne måneden er vanligvis vanskeligere for reiser her. Vær, folkemengder, stengninger eller pris kan alle spille mot turen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze maand is hier meestal moeilijker voor reizen. Het weer, de drukte, sluitingen of waarde kunnen allemaal tegen de reis werken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ten miesiąc zazwyczaj jest trudniejszy na podróże tutaj. Pogoda, tłumy, zamknięcia lub koszty mogą działać na niekorzyść podróży."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este mês geralmente é mais difícil para viajar aqui. O clima, multidões, fechamentos ou custo-benefício podem todos prejudicar a viagem."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Luna aceasta este de obicei mai dificilă pentru călătorii aici. Vremea, mulțimile, închiderile sau valoarea pot toate să fie împotriva călătoriei."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Этот месяц обычно сложнее для путешествий здесь. Погода, толпы, закрытия или стоимость могут все сыграть против поездки."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tento mesiac je tu cestovanie zvyčajne náročnejšie. Počasie, davy, zatvorené miesta alebo cena môžu všetky pôsobiť proti výletu."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den här månaden är vanligtvis svårare för resor här. Vädret, folkmassorna, stängningar eller värdet kan alla spela emot resan."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เดือนนี้มักจะเดินทางที่นี่ยากขึ้น สภาพอากาศ ฝูงชน การปิดให้บริการ หรือมูลค่าอาจส่งผลต่อการเดินทาง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu ay burada seyahat etmek genellikle daha zordur. Hava, kalabalıklar, kapanışlar veya maliyet seyahate engel olabilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Цей місяць зазвичай складніший для подорожей тут. Погода, натовпи, закриття або вартість можуть бути на шкоду поїздці."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tháng này thường khó đi lại hơn ở đây. Thời tiết, đám đông, các địa điểm đóng cửa hoặc giá cả đều có thể gây trở ngại cho chuyến đi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这个月通常不太适合来这里旅行。天气、人群、景点关闭或费用等因素都可能不利于旅行。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這個月份在這裡通常旅遊較困難。天氣、人潮、關閉或價格可能都不利於旅行。"
          }
        }
      }
    },
