    "trip_planner.availability.your_availability_subtitle" : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "شارك الأشهر أو التواريخ الدقيقة التي تناسبك. تظل توفر كل شخص آخر للقراءة فقط هنا."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comparteix els mesos o les dates exactes que et funcionin. La disponibilitat dels altres es manté només de lectura aquí."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sdílejte měsíce nebo přesná data, která vám vyhovují. Dostupnost ostatních zůstává zde pouze pro čtení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Del de måneder eller præcise datoer, der passer dig. Alle andre personers tilgængelighed forbliver skrivebeskyttet her."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teile die Monate oder genauen Daten, die fur dich passen. Die Verfugbarkeit der anderen ist hier nur lesbar."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μοιραστείτε τους μήνες ή τις ακριβείς ημερομηνίες που σας βολεύουν. Διαθεσιμότητα όλων των άλλων παραμένει μόνο για ανάγνωση εδώ."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Share the months or exact dates that work for you. Everyone else’s availability stays read-only here."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comparte los meses o fechas exactas que te funcionan. La disponibilidad de los demas se mantiene solo de lectura aqui."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jaa kuukaudet tai tarkat päivämäärät, jotka sopivat sinulle. Kaikkien muiden saatavuus pysyy täällä vain luku -tilassa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Partagez les mois ou dates exactes qui vous conviennent. Les disponibilites des autres restent en lecture seule ici."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "שתף את החודשים או התאריכים המדויקים שמתאימים לך. זמינות של כל השאר תישאר לקריאה בלבד כאן."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "वे महीने या सटीक तिथियाँ साझा करें जो आपके लिए काम करती हैं। यहाँ बाकी सभी की उपलब्धता केवल पढ़ने के लिए बनी रहती है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podijelite mjesece ili točne datume koji vam odgovaraju. Dostupnost svih ostalih ostaje samo za čitanje ovdje."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oszd meg azokat a hónapokat vagy pontos dátumokat, amelyek neked megfelelnek. Mindenki más elérhetősége itt csak olvasható marad."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bagikan bulan atau tanggal pasti yang cocok untuk Anda. Ketersediaan orang lain tetap hanya bisa dibaca di sini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Condividi i mesi o le date esatte che vanno bene per te. La disponibilita degli altri qui e di sola lettura."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あなたに都合の良い月や正確な日付を共有してください。他の人の空き状況はここでは閲覧専用のままです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "가능한 달이나 정확한 날짜를 공유하세요. 다른 사람들의 가능 여부는 여기서 읽기 전용으로 유지됩니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kongsi bulan atau tarikh tepat yang sesuai untuk anda. Ketersediaan semua orang lain kekal baca sahaja di sini."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Del månedene eller de eksakte datoene som passer for deg. Alle andres tilgjengelighet forblir kun lesbar her."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deel de maanden of exacte datums die voor jou werken. De beschikbaarheid van iedereen blijft hier alleen-lezen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podziel się miesiącami lub dokładnymi datami, które Ci pasują. Dostępność pozostałych osób pozostaje tutaj tylko do odczytu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compartilhe os meses ou datas exatas que funcionam para voce. A disponibilidade dos outros fica somente para leitura aqui."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Împărtășește lunile sau datele exacte care funcționează pentru tine. Disponibilitatea tuturor celorlalți rămâne doar în citire aici."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Поделитесь месяцами или точными датами, которые вам подходят. Доступность остальных здесь остается только для чтения."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zdieľajte mesiace alebo presné dátumy, ktoré vám vyhovujú. Dostupnosť ostatných zostáva tu iba na čítanie."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dela de månader eller exakta datum som passar dig. Alla andras tillgänglighet förblir skrivskyddad här."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แชร์เดือนหรือวันที่ที่สะดวกสำหรับคุณ การเข้าถึงของคนอื่นจะเป็นแบบอ่านอย่างเดียวที่นี่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sizin için uygun olan ayları veya kesin tarihleri paylaşın. Burada diğer herkesin uygunluk durumu salt okunur olarak kalır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Поділіться місяцями або точними датами, які вам підходять. Доступність всіх інших тут залишається тільки для читання."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chia sẻ các tháng hoặc ngày cụ thể phù hợp với bạn. Khả năng sẵn có của mọi người khác sẽ chỉ đọc tại đây."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "分享适合你的月份或具体日期。其他人的可用时间在这里保持只读。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "分享對你來說合適的月份或具體日期。其他人的可用時間在這裡保持唯讀。"
          }
        }
      }
    },
    "trip_planner.basics.subtitle" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اعطه اسمًا وتوقيتًا تقريبيًا حتى تتمكن من البدء في تشكيله."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dóna-li un nom i un temps aproximat perquè puguis començar a donar-li forma."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dej tomu jméno a přibližný časový rámec, abys mohl začít s jeho utvářením."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giv det et navn og en cirka tidsplan, så du kan begynde at forme det."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gib der Reise einen Namen und einen ungefahren Zeitraum, damit du mit der Planung beginnen kannst."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δώσε του ένα όνομα και κατά προσέγγιση χρόνο ώστε να μπορείς να αρχίσεις να το διαμορφώνεις."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Give it a name and rough timing so you can start shaping it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ponle un nombre y fechas aproximadas para empezar a darle forma."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anna sille nimi ja karkea aikataulu, jotta voit alkaa muotoilla sitä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Donnez-lui un nom et une periode approximative pour commencer."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "תן לזה שם וזמן משוער כדי שתוכל להתחיל לעצב אותו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इसे एक नाम और अनुमानित समय दें ताकि आप इसे आकार देना शुरू कर सकें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Daj mu ime i okvirno vrijeme kako bi mogao početi oblikovati to."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adj neki egy nevet és hozzávetőleges időpontot, hogy elkezdhess formálni rajta."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beri itu sebuah nama dan perkiraan waktu sehingga Anda bisa mulai membentuknya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dai un nome e un periodo approssimativo al viaggio per iniziare a costruirlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "名前と大まかな時間を付けて、形を作り始められるようにしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이름과 대략적인 시간을 정해서 그것을 구체화하기 시작하세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Berikan ia satu nama dan anggaran masa supaya anda boleh mula membentuknya."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gi det et navn og omtrentlig tid slik at du kan begynne å forme det."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geef het een naam en een ruwe tijdsindeling zodat je het kunt beginnen vorm te geven."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nadaj temu nazwę i określ przybliżony czas, aby móc zacząć to kształtować."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dê um nome e um periodo aproximado para comecar a montar a viagem."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dă-i un nume și un timp aproximativ, astfel încât să poți începe să îl conturezi."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дайте поездке название и примерные сроки, чтобы начать ее формировать."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Daj mu meno a približný čas, aby si ho mohol začať formovať."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ge det ett namn och ungefärlig tidpunkt så att du kan börja forma det."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ตั้งชื่อและประมาณเวลาไว้เพื่อที่คุณจะได้เริ่มปรับแต่งมัน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buna bir isim ve yaklaşık bir zaman ver ki şekillendirmeye başlayabilesin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дайте цьому назву та приблизний час, щоб ви могли почати його формувати."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đặt cho nó một cái tên và ước lượng thời gian để bạn có thể bắt đầu định hình nó."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "给它起个名字并大致安排时间，这样你就可以开始塑造它了。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "給它取個名字和大致時間，這樣你就可以開始塑造它。"
          }
        }
      }
    },
