        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nhấn Chỉnh sửa để thêm quốc gia vào đây, hoặc vuốt sang trái trên một quốc gia và nhấn Đã ghé thăm."
          }
        },
        "zh-Hans" : {
