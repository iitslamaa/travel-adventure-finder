    "country_detail.language.detail.tourism_heavy" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ينبغي أن يكون أكثر فائدة في المناطق السياحية المزدحمة بدلاً من كل مكان."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hauria de ser més útil en zones amb molt turisme que a tot arreu."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mělo by to být nejvíce užitečné v oblastech s vysokou koncentrací turismu, spíše než všude."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det bør være mest nyttigt i områder med meget turisme fremfor overalt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Am nutzlichsten ist es wahrscheinlich in stark touristischen Gegenden statt uberall."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Θα πρέπει να είναι πιο χρήσιμο σε περιοχές με έντονο τουρισμό παρά παντού."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It should be most useful in tourism-heavy areas rather than everywhere."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deberia ser mas util en zonas con mucho turismo que en todo el pais."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sen tulisi olla hyödyllisintä alueilla, joissa on paljon turismia, eikä kaikkialla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cela sera surtout utile dans les zones tres touristiques plutot que partout."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "זה אמור להיות הכי שימושי באזורים עמוסי תיירות ולא בכל מקום."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इसे हर जगह के बजाय पर्यटन-भारी क्षेत्रों में सबसे अधिक उपयोगी होना चाहिए।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trebalo bi biti najkorisnije u područjima s velikim brojem turista, a ne svugdje."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ez valószínűleg leginkább a turizmusban erősen érintett területeken lesz hasznos, nem pedig mindenhol."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ini seharusnya paling berguna di daerah yang banyak wisatawan daripada di mana-mana."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Probabilmente sara piu utile nelle aree molto turistiche che ovunque."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "それはどこにでもではなく、観光客の多い地域で最も役立つはずです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "그것은 모든 곳보다는 관광객이 많은 지역에서 가장 유용할 것입니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ia sepatutnya paling berguna di kawasan yang banyak pelancong daripada di mana-mana sahaja."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det bør være mest nyttig i områder med mye turisme fremfor overalt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het zou het meest nuttig moeten zijn in toeristisch drukke gebieden in plaats van overal."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
