    "legal.limitation_of_liability.body" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مكتشف مغامرات السفر غير مسؤول عن القرارات التي تُتخذ بناءً على المعلومات المقدمة في التطبيق. استخدام هذا التطبيق يكون على مسؤوليتك الخاصة."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Travel Adventure Finder no és responsable de les decisions preses basant-se en la informació presentada a l'aplicació. L'ús d'aquesta aplicació és a la teva pròpia discreció."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikace Travel Adventure Finder není zodpovědná za rozhodnutí učiněná na základě informací uvedených v aplikaci. Používání této aplikace je na vaše vlastní uvážení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Travel Adventure Finder er ikke ansvarlig for beslutninger, der træffes baseret på oplysninger præsenteret i appen. Brug af denne app sker på eget ansvar."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Travel Adventure Finder ist nicht verantwortlich fur Entscheidungen, die auf den in der App dargestellten Informationen basieren. Die Nutzung dieser App erfolgt nach eigenem Ermessen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Travel Adventure Finder δεν είναι υπεύθυνο για αποφάσεις που λαμβάνονται βάσει των πληροφοριών που παρουσιάζονται στην εφαρμογή. Η χρήση αυτής της εφαρμογής γίνεται με δική σας διακριτική ευχέρεια."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Travel Adventure Finder is not responsible for decisions made based on information presented in the app. Use of this app is at your own discretion."
