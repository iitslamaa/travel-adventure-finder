        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las reglas actuales pueden limitar gravemente o prohibir la entrada; consulta la orientacion oficial antes de planificar."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nykyiset säännöt saattavat rajoittaa tai kieltää pääsyn; tarkista virallinen ohjeistus ennen suunnittelua."
          }
