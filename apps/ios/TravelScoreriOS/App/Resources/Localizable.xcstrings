    "trip_planner.availability.summary_empty_group" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ابدأ في جمع الأشهر المجانية أو نطاقات التواريخ المحددة حتى يتمكن المخطط من تسليط الضوء على أفضل نافذة مشتركة."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comenceu a recollir mesos gratuïts o intervals de dates exactes perquè el planificador pugui destacar la millor finestra compartida."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Začněte sbírat volné měsíce nebo přesná časová období, aby plánovač mohl zvýraznit nejlepší společné období."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Begynd at indsamle gratis måneder eller præcise datointervaller, så planlægningsværktøjet kan fremhæve det bedste fælles tidsrum."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sammelt freie Monate oder genaue Datumsbereiche, damit der Planer das beste gemeinsame Zeitfenster hervorheben kann."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ξεκινήστε να συλλέγετε δωρεάν μήνες ή ακριβή χρονικά διαστήματα ώστε ο προγραμματιστής να μπορέσει να επισημάνει το καλύτερο κοινό παράθυρο."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Start collecting free months or exact date ranges so the planner can spotlight the best shared window."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Empieza a reunir meses libres o rangos exactos para que el planificador destaque la mejor ventana compartida."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aloita ilmaisten kuukausien tai tarkkojen ajanjaksojen kerääminen, jotta suunnittelija voi korostaa parhaita jaettuja ajankohtia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Commencez a collecter des mois libres ou des plages de dates exactes pour que le planificateur mette en avant la meilleure periode commune."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "התחל לאסוף חודשים חינמיים או טווחי תאריכים מדויקים כדי שהמתכנן יוכל להדגיש את חלון הזמן המשותף הטוב ביותר."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मुफ्त महीनों या सटीक तिथियों की श्रृंखला इकट्ठी करना शुरू करें ताकि योजनाकार सबसे अच्छा साझा किया गया समय दिखा सके।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Počnite skupljati besplatne mjesece ili točne vremenske rasponе kako bi planer mogao istaknuti najbolje zajedničko razdoblje."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kezdje el gyűjteni az ingyenes hónapokat vagy pontos időintervallumokat, hogy a tervező ki tudja emelni a legjobb közös időablakot."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mulailah mengumpulkan bulan gratis atau rentang tanggal yang tepat sehingga perencana dapat menyoroti jendela bersama terbaik."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inizia a raccogliere mesi liberi o intervalli di date precisi cosi il planner potra evidenziare la finestra condivisa migliore."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プランナーが最適な共有期間をハイライトできるように、無料の月や正確な日付範囲の収集を開始してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "무료 이용 달이나 정확한 날짜 범위를 모으기 시작하여 플래너가 가장 적합한 공유 기간을 강조 표시할 수 있도록 합니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mulakan mengumpul bulan percuma atau julat tarikh yang tepat supaya perancang boleh menonjolkan tetingkap perkongsian terbaik."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Begynn å samle gratis måneder eller eksakte datointervaller slik at planleggeren kan fremheve det beste delte tidsrommet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Begin met het verzamelen van gratis maanden of exacte datumbereiken zodat de planner het beste gedeelde venster kan uitlichten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zacznij zbierać darmowe miesiące lub dokładne zakresy dat, aby planer mógł wyeksponować najlepszy wspólny okres."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comece a reunir meses livres ou intervalos de datas exatos para que o planejador destaque a melhor janela em comum."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Începe să colectezi luni gratuite sau intervale exacte de date astfel încât planificatorul să poată evidenția cea mai bună fereastră comună."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Начните собирать свободные месяцы или точные диапазоны дат, чтобы планировщик смог выделить лучшее общее окно."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Začnite zbierať bezplatné mesiace alebo presné časové obdobia, aby plánovač mohol zvýrazniť najlepší spoločný čas."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Börja samla gratis månader eller exakta datumintervall så att planeringsverktyget kan lyfta fram den bästa gemensamma perioden."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เริ่มเก็บเดือนฟรีหรือช่วงวันที่ที่แน่นอนเพื่อให้ผู้วางแผนสามารถเน้นช่วงเวลาที่เหมาะสมที่สุดในการแชร์"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Planlayıcının en iyi ortak zamanı vurgulayabilmesi için ücretsiz ayları veya kesin tarih aralıklarını toplamaya başlayın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Почніть збирати безкоштовні місяці або точні діапазони дат, щоб планувальник міг підсвітити найкращий спільний проміжок."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bắt đầu thu thập các tháng miễn phí hoặc khoảng ngày chính xác để người lập kế hoạch có thể làm nổi bật khoảng thời gian chia sẻ tốt nhất."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "开始收集免费的月份或确切的日期范围，这样计划者就可以突出最佳的共享时间窗口。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "開始收集免費月份或確切日期範圍，以便規劃者能突出顯示最佳的共享時段。"
          }
        }
      }
    },
