    "country_detail.visa.body.ban" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قد تحد القواعد الحالية بشكل كبير أو تمنع الدخول؛ تحقق من الإرشادات الرسمية قبل التخطيط."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les regles actuals poden limitar greument o impedir l'entrada; consulteu les directrius oficials abans de planificar."
